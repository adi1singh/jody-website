---
// JobGen's real-recording player: the clip's waveform as bars, each bar
// coloured by who is speaking at that moment, filling in as it plays. Click a
// bar to jump there. Ship audio as .opus with an .m4a/.mp3 fallback.
//
// `bars`: heights 0–1 (generate from the audio, or leave out for a placeholder).
// `speakers`: [{ name, colour, from, to }] in seconds, for the colours and legend.
interface Props {
  title: string;
  caption?: string;
  sources: { src: string; type: string }[];
  duration: number;
  bars?: number[];
  speakers?: { name: string; colour: string; from: number; to: number }[];
}
const { title, caption, sources, duration, bars, speakers = [] } = Astro.props;
const count = bars?.length ?? 90;
// Placeholder shape when no real waveform is given: speech-like bumps.
const heights =
  bars ?? Array.from({ length: count }, (_, i) => 0.25 + 0.6 * Math.abs(Math.sin(i * 0.7) * Math.cos(i * 0.23)) + 0.15 * ((i * 7919) % 10) / 10);
const colourAt = (t: number) => speakers.find((s) => t >= s.from && t < s.to)?.colour ?? "var(--muted)";
const legend = [...new Map(speakers.map((s) => [s.name, s.colour])).entries()];
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
---
<figure class="player card" data-player>
  <div class="player-top">
    <button type="button" class="play" aria-label={`Play: ${title}`} data-play>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8 5v14l11-7z" /><path class="i-pause" d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
    </button>
    <div>
      <p class="player-title">{title}</p>
      <p class="mono"><span data-time>0:00</span> / {mmss(duration)}</p>
    </div>
  </div>
  <div class="wave" data-wave role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax={Math.round(duration)} aria-valuenow="0">
    {heights.map((h, i) => <i style={`--h:${h};--c:${colourAt((i / count) * duration)}`}></i>)}
  </div>
  {legend.length > 0 && (
    <ul class="legend">{legend.map(([n, c]) => <li><span style={`background:${c}`}></span>{n}</li>)}</ul>
  )}
  {caption && <figcaption>{caption}</figcaption>}
  <audio preload="none" data-audio>
    {sources.map((s) => <source src={s.src} type={s.type} />)}
  </audio>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>("[data-audio]")!;
    const wave = root.querySelector<HTMLElement>("[data-wave]")!;
    const bars = [...wave.children] as HTMLElement[];
    const time = root.querySelector("[data-time]")!;
    const btn = root.querySelector<HTMLButtonElement>("[data-play]")!;
    const total = Number(wave.getAttribute("aria-valuemax")) || 1;
    const paint = () => {
      const p = (audio.currentTime || 0) / (audio.duration || total);
      bars.forEach((b, i) => b.classList.toggle("on", i / bars.length < p));
      time.textContent = `${Math.floor(audio.currentTime / 60)}:${String(Math.floor(audio.currentTime % 60)).padStart(2, "0")}`;
      wave.setAttribute("aria-valuenow", String(Math.round(audio.currentTime)));
    };
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLAudioElement>("[data-audio]").forEach((a) => a !== audio && a.pause());
      audio.paused ? audio.play() : audio.pause();
    });
    audio.addEventListener("play", () => root.classList.add("playing"));
    audio.addEventListener("pause", () => root.classList.remove("playing"));
    audio.addEventListener("timeupdate", paint);
    const seek = (p: number) => {
      audio.currentTime = Math.max(0, Math.min(1, p)) * (audio.duration || total);
      paint();
    };
    wave.addEventListener("click", (e) => {
      const box = wave.getBoundingClientRect();
      seek((e.clientX - box.left) / box.width);
    });
    wave.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" ? 5 : e.key === "ArrowLeft" ? -5 : 0;
      if (step) seek((audio.currentTime + step) / (audio.duration || total));
    });
  });
</script>

<style>
  .player {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .player-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .player-title {
    font-weight: 500;
  }
  .play {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
  }
  .play svg {
    width: 22px;
    fill: currentColor;
  }
  .i-pause,
  :global(.playing) .i-play {
    display: none;
  }
  :global(.playing) .i-pause {
    display: block;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 72px;
    cursor: pointer;
  }
  .wave i {
    flex: 1;
    height: calc(var(--h) * 100%);
    min-height: 3px;
    border-radius: 2px;
    background: var(--c);
    opacity: 0.3;
    transition: opacity 0.2s;
  }
  .wave i:global(.on) {
    opacity: 1;
  }
  .legend {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--muted);
  }
  .legend span {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 50%;
  }
  figcaption {
    font-size: 14px;
    color: var(--muted);
  }
</style>
