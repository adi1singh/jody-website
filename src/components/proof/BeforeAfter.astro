---
// Inspiration board (2026): one image you can
// compare, the "before" (sketch) on the left of a line you drag and the
// "after" (finished) on the right. Seen on Kononenko Bureau ("From Sketch to
// Strategy"). The handle is a real range input, so keyboard and touch work;
// without JavaScript it shows half and half.
//
// <BeforeAfter before={{ src, alt, label: "Sketch" }} after={{ src, alt, label: "Finished" }} />
interface Side {
  src: string;
  alt: string;
  label: string;
}
interface Props {
  before: Side;
  after: Side;
  /** Accessible name for the slider. */
  label?: string;
}
const { before, after, label = `Compare ${before.label.toLowerCase()} and ${after.label.toLowerCase()}` } = Astro.props;
---
<figure class="ba" data-before-after style="--pos:50%">
  <img class="ba-img" src={after.src} alt={after.alt} loading="lazy" />
  <div class="ba-before">
    <img class="ba-img" src={before.src} alt={before.alt} loading="lazy" />
  </div>
  <span class="ba-line" aria-hidden="true"><span class="ba-knob">‹ ›</span></span>
  <span class="ba-tag ba-tag-l mono" aria-hidden="true">{before.label}</span>
  <span class="ba-tag ba-tag-r mono" aria-hidden="true">{after.label}</span>
  <input class="ba-range" type="range" min="0" max="100" value="50" step="0.5" aria-label={label} />
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-before-after]").forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>(".ba-range")!;
    const set = () => {
      fig.style.setProperty("--pos", range.value + "%");
      range.setAttribute("aria-valuetext", `${Math.round(Number(range.value))}% ${fig.querySelector(".ba-tag-l")!.textContent}`);
    };
    range.addEventListener("input", set);
    set();
  });
</script>

<style>
  .ba {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 3 / 2;
    background: var(--surface-2);
    user-select: none;
  }
  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    color: #17161a;
    font-weight: 600;
    letter-spacing: 0.1em;
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s var(--ease);
  }
  .ba:has(.ba-range:focus-visible) .ba-knob {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ba:hover .ba-knob {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .ba-tag {
    position: absolute;
    top: 14px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    color: #17161a;
    font-size: 11px;
    pointer-events: none;
  }
  .ba-tag-l {
    left: 14px;
  }
  .ba-tag-r {
    right: 14px;
  }
  /* The real slider covers the image, invisible: drag anywhere, or use the keyboard */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  :global(html:not(.js)) .ba-range,
  :global(html:not(.js)) .ba-knob {
    display: none;
  }
</style>
