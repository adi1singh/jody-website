---
// Pathwise ("Student stories"): a bold colour band with a huge title and two
// rows of slightly tilted quote cards drifting in opposite directions. Cards
// alternate light and dark, each topped with its own colour, and can show a
// small "from → to" journey. A pause button (or a click on the cards) stops
// the motion; with reduced motion the cards sit still in a wrapped grid.
// The drift is CSS only, so it runs without JavaScript too.
interface Item {
  quote: string;
  name: string;
  detail?: string;
  from?: string;
  to?: string;
  /** Card colour; defaults cycle through the category colours. */
  tint?: string;
}
interface Props {
  title: string;
  lead?: string;
  items: Item[];
  /** Band colour. */
  bg?: string;
  /** Text colour on the band. */
  ink?: string;
}
const { title, lead, items, bg = "var(--accent)", ink = "var(--accent-ink)" } = Astro.props;
const tints = ["var(--c1)", "var(--c2)", "var(--c3)", "var(--c4)", "var(--c5)", "var(--c6)"];
const cards = items.map((t, i) => ({ ...t, tint: t.tint ?? tints[i % tints.length] }));
const rowB = [...cards].reverse();
---
<section class="wall" aria-labelledby="wall-title" data-wall style={`--wall-bg:${bg};--wall-ink:${ink}`}>
  <div class="wrap wall-head">
    <h2 id="wall-title" class="wall-title" set:html={title} />
    {lead && <p class="wall-lead">{lead}</p>}
    <button type="button" class="wall-pause" data-wall-pause aria-pressed="false"><span class="wall-pause-icon" aria-hidden="true"></span><span data-wall-label>Pause stories</span></button>
  </div>
  <div class="wall-rows" data-wall-rows>
    <ul class="wall-row">
      {[...cards, ...cards].map((t, i) => (
        <li class:list={["wall-card", { light: i % 2 === 0 }]} style={`--acc:${t.tint}`} aria-hidden={i >= cards.length ? "true" : undefined}>
          <svg class="wall-mark" viewBox="0 0 48 36" aria-hidden="true"><path d="M0 36V22C0 9 7 2 19 0l2 6c-7 2-10 6-10 12h9v18zm27 0V22C27 9 34 2 46 0l2 6c-7 2-10 6-10 12h9v18z" fill="currentColor" /></svg>
          <p class="wall-quote">{t.quote}</p>
          {t.from && t.to && <p class="wall-journey"><span>{t.from}</span><span aria-hidden="true">→</span><strong>{t.to}</strong></p>}
          <p class="wall-who"><span class="wall-avatar" aria-hidden="true">{t.name.trim()[0]}</span><span><strong>{t.name}</strong>{t.detail && <span>{t.detail}</span>}</span></p>
        </li>
      ))}
    </ul>
    <ul class="wall-row wall-row-reverse" aria-hidden="true">
      {[...rowB, ...rowB].map((t, i) => (
        <li class:list={["wall-card", { light: i % 2 === 1 }]} style={`--acc:${t.tint}`}>
          <svg class="wall-mark" viewBox="0 0 48 36"><path d="M0 36V22C0 9 7 2 19 0l2 6c-7 2-10 6-10 12h9v18zm27 0V22C27 9 34 2 46 0l2 6c-7 2-10 6-10 12h9v18z" fill="currentColor" /></svg>
          <p class="wall-quote">{t.quote}</p>
          {t.from && t.to && <p class="wall-journey"><span>{t.from}</span><span>→</span><strong>{t.to}</strong></p>}
          <p class="wall-who"><span class="wall-avatar">{t.name.trim()[0]}</span><span><strong>{t.name}</strong>{t.detail && <span>{t.detail}</span>}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-wall]").forEach((wall) => {
    const btn = wall.querySelector<HTMLButtonElement>("[data-wall-pause]")!;
    const label = wall.querySelector<HTMLElement>("[data-wall-label]")!;
    const toggle = () => {
      const paused = !wall.classList.contains("is-paused");
      wall.classList.toggle("is-paused", paused);
      btn.setAttribute("aria-pressed", String(paused));
      label.textContent = paused ? "Play stories" : "Pause stories";
    };
    btn.addEventListener("click", toggle);
    wall.querySelector("[data-wall-rows]")!.addEventListener("click", toggle);
  });
</script>

<style>
  .wall {
    position: relative;
    overflow: hidden;
    padding: var(--section) 0;
    background: var(--wall-bg);
    color: var(--wall-ink);
  }
  .wall-head {
    display: grid;
    gap: 16px 48px;
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 52px);
  }
  @media (min-width: 900px) {
    .wall-head {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .wall-title {
    font-size: clamp(52px, 8vw, 120px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .wall-title :global(em) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.08em;
    letter-spacing: -0.02em;
  }
  .wall-lead {
    max-width: 30rem;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.45;
  }
  .wall-pause {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 16px 6px 13px;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
  }
  .wall-pause:hover {
    background: var(--wall-ink);
    color: var(--wall-bg);
  }
  .wall-pause-icon {
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentColor;
  }
  .wall-pause[aria-pressed="true"] .wall-pause-icon {
    width: 0;
    height: 0;
    border: 0;
    border-left: 10px solid currentColor;
    border-block: 6px solid transparent;
  }
  :global(html:not(.js)) .wall-pause {
    display: none;
  }
  .wall-rows {
    display: grid;
    gap: 20px;
  }
  .wall-row {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 10px 0;
    list-style: none;
  }
  .wall-card {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 16px;
    width: min(78vw, 420px);
    padding: 26px 26px 22px;
    border-radius: 26px;
    border-top: 7px solid var(--acc);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 50px -28px rgba(0, 0, 0, 0.55);
    transform: rotate(1deg);
    transition: transform 0.3s var(--ease);
  }
  .wall-card.light {
    background: var(--surface);
    transform: rotate(-1deg);
  }
  .wall-card:hover {
    transform: rotate(0) translateY(-6px) scale(1.02);
  }
  .wall-mark {
    width: 40px;
    height: 30px;
    color: var(--acc);
  }
  .wall-quote {
    flex: 1;
    font-size: 18px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .wall-journey {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .wall-journey strong {
    color: var(--acc);
    font-weight: 600;
  }
  .wall-who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
  }
  .wall-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--acc);
    color: #fff;
    font-weight: 700;
    font-size: 18px;
  }
  .wall-who > span:last-child {
    display: grid;
    line-height: 1.35;
  }
  .wall-who > span:last-child > span {
    font-size: 14px;
    opacity: 0.75;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wall-row {
      animation: wall-scroll 70s linear infinite;
    }
    .wall-row-reverse {
      animation-direction: reverse;
      animation-duration: 80s;
    }
    .wall:global(.is-paused) .wall-row {
      animation-play-state: paused;
    }
    .wall-rows {
      cursor: pointer;
    }
  }
  @keyframes wall-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall-pause {
      display: none;
    }
    .wall-row {
      width: auto;
      flex-wrap: wrap;
      padding-inline: var(--gutter);
    }
    .wall-row > [aria-hidden="true"],
    .wall-row-reverse {
      display: none;
    }
    .wall-card,
    .wall-card.light {
      transform: none;
    }
  }
</style>
