---
// JobGen's featured customer story: problem → what we did → what changed, in
// three short labelled beats beside the customer's own quote.
interface Props {
  eyebrow?: string;
  title: string;
  beats: [string, string][];
  quote: string;
  name: string;
  role: string;
}
const { eyebrow = "CUSTOMER STORY", title, beats, quote, name, role } = Astro.props;
---
<section class="section light">
  <div class="wrap story">
    <div>
      <p class="eyebrow reveal">{eyebrow}</p>
      <h2 class="h2 reveal" set:html={title} />
      <dl class="beats">
        {beats.map(([k, v]) => (
          <div class="reveal">
            <dt class="mono">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <figure class="quote reveal">
      <blockquote>“{quote}”</blockquote>
      <figcaption><strong>{name}</strong> · {role}</figcaption>
    </figure>
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .beats {
    display: grid;
    gap: 22px;
    margin-top: 40px;
  }
  .beats div {
    padding-left: 18px;
    border-left: 2px solid var(--accent);
  }
  .beats dd {
    margin-top: 4px;
    font-size: 19px;
  }
  .quote {
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  blockquote {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  figcaption {
    margin-top: 22px;
    color: var(--muted);
  }
  figcaption strong {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .story {
      grid-template-columns: 1fr;
    }
  }
</style>
