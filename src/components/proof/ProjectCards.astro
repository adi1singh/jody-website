---
// Hind Zero Waste ("Trusted by municipal bodies across India", "6 projects
// that define us"): plain project cards that lead with the figure. Figures are
// shown as written, not counted up, so the scale of each project reads at once.
// A short accent rule runs the full width on hover.
//
// <ProjectCards items={[{ figure: "8,00,000 m³", name: "Pimpri Chinchwad Municipal Corporation",
//   place: "Moshi, Maharashtra", scope: "Bio-mining of legacy waste", status: "Ongoing", note: "7,02,900 m³ done" }]} />
interface Item {
  figure: string;
  name: string;
  place?: string;
  scope?: string;
  note?: string;
  status?: string;
  /** "ongoing" tints the status pill differently. */
  ongoing?: boolean;
}
interface Props {
  items: Item[];
  /** Colour of the figures and the top rule. */
  tint?: string;
}
const { items, tint = "var(--c2)" } = Astro.props;
---
<ul class="pgrid" data-reveal-group style={`--pc:${tint}`}>
  {items.map((p, i) => (
    <li class="pcard reveal">
      <div class="ptop">
        <span class="pidx mono">{String(i + 1).padStart(2, "0")}</span>
        {p.status && <span class:list={["pstatus", { ongoing: p.ongoing }]}>{p.status}</span>}
      </div>
      <p class="pfig">{p.figure}</p>
      <h3>{p.name}</h3>
      {p.place && (
        <p class="pplace">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
          {p.place}
        </p>
      )}
      {(p.scope || p.note) && (
        <p class="pscope">
          {p.scope}
          {p.note && <span>{p.note}</span>}
        </p>
      )}
    </li>
  ))}
</ul>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    padding: 26px 28px 30px;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, color-mix(in srgb, var(--text) 9%, transparent), color-mix(in srgb, var(--text) 3%, transparent) 60%);
    border: 1px solid var(--line-strong);
    transition:
      transform 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }
  .pcard::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 64px;
    height: 4px;
    background: var(--pc);
    transition: width 0.5s var(--ease-out);
  }
  .pcard:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--pc) 60%, transparent);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  .pcard:hover::before {
    width: 100%;
  }
  .ptop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  .pidx {
    font-weight: 700;
  }
  .pstatus {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--c4) 18%, transparent);
    color: color-mix(in srgb, var(--c4) 70%, var(--text));
  }
  .pstatus.ongoing {
    background: color-mix(in srgb, var(--pc) 20%, transparent);
    color: color-mix(in srgb, var(--pc) 70%, var(--text));
  }
  .pfig {
    font-size: clamp(36px, 3.2vw, 46px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--pc);
  }
  h3 {
    margin-top: 4px;
    font-size: clamp(20px, 1.55vw, 23px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .pplace {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-weight: 500;
    color: color-mix(in srgb, var(--pc) 45%, var(--text));
  }
  .pplace svg {
    flex: none;
    margin-top: 4px;
  }
  .pscope {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }
  .pscope span {
    display: block;
    margin-top: 4px;
    font-weight: 600;
    color: var(--text);
  }
  @media (max-width: 1100px) {
    .pgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .pgrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .pcard {
      padding: 22px 22px 24px;
    }
  }
</style>
