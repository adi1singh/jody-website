---
// Hind Zero Waste's numbers band: big figures that count up as they scroll into
// view, divided by thin rules, with optional credential pills underneath
// (e.g. "ISO 9001:2015"). The finished numbers are in the HTML, so they read
// correctly without JavaScript and stay still with reduced motion.
//
// <Stats items={[{ value: 87, suffix: "+", label: "Projects across India" },
//   { value: 2017, from: 2000, plain: true, label: "Founded in Kolhapur" }]} />
interface Item {
  value: number;
  prefix?: string;
  suffix?: string;
  /** Count up from this value instead of 0 (useful for years). */
  from?: number;
  /** No thousands separator (years, phone-like numbers). */
  plain?: boolean;
  label: string;
}
interface Props {
  items: Item[];
  credentials?: string[];
}
const { items, credentials = [] } = Astro.props;
const show = (i: Item) => (i.prefix ?? "") + i.value.toLocaleString("en", { useGrouping: !i.plain }) + (i.suffix ?? "");
---
<div class="stats">
  <dl class="stats-grid" data-reveal-group style={`--n:${items.length}`}>
    {items.map((s) => (
      <div class="stat reveal">
        <dt>
          <span
            data-count={s.value}
            data-prefix={s.prefix}
            data-suffix={s.suffix}
            data-from={s.from}
            data-group={s.plain ? "false" : undefined}>{show(s)}</span>
        </dt>
        <dd>{s.label}</dd>
      </div>
    ))}
  </dl>
  {credentials.length > 0 && (
    <ul class="creds reveal">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  )}
</div>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
  }
  .stat {
    padding: 6px 28px;
  }
  .stat + .stat {
    border-left: 1px solid var(--line-strong);
  }
  dt {
    font-size: clamp(48px, 5.6vw, 84px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(120deg, var(--text) 0%, color-mix(in srgb, var(--text) 65%, var(--accent)) 60%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  dd {
    max-width: 16em;
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }
  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .creds li {
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font: 500 13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
    .stat:nth-child(odd) {
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .stat {
      padding: 4px 16px;
    }
    .stat:nth-child(odd) {
      padding-left: 0;
    }
  }
</style>
