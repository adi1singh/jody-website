---
// Inspiration board (2026): tall panels side by
// side, each a solid colour with its title standing up the edge. Choosing one
// (click, tap, Enter, or hovering with a mouse) widens it to show a photo, a
// line and a counter. Seen on LPAS (sector panels) and Realevate (standing
// titles). Phones get a stack that opens one panel at a time; without
// JavaScript every panel shows open, one under another.
//
// <ColourPanels items={[{ title, line, tag, img: { src, alt }, tone: "#925434" }]} />
interface Item {
  title: string;
  line: string;
  tag?: string;
  img: { src: string; alt: string };
  /** Panel colour (hex). Text turns light or dark to suit it. */
  tone: string;
}
interface Props {
  items: Item[];
  label?: string;
}
const { items, label = "Sectors" } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
// Pick readable text for each panel colour (WCAG relative luminance).
const ink = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.32 ? "#17161a" : "#ffffff";
};
---
<div class="cp" data-colour-panels aria-label={label} role="group" style={`--n:${items.length}`}>
  {items.map((it, i) => (
    <article class:list={["cp-panel", { "is-open": i === 0 }]} style={`--tone:${it.tone};--ink:${ink(it.tone)}`}>
      <h3 class="cp-title">
        <button type="button" id={`cp-${uid}-b${i}`} aria-expanded={i === 0 ? "true" : "false"} aria-controls={`cp-${uid}-p${i}`}>
          <span class="cp-name">{it.title}</span>
          <span class="cp-plus" aria-hidden="true"></span>
        </button>
      </h3>
      <div class="cp-body" id={`cp-${uid}-p${i}`} role="region" aria-labelledby={`cp-${uid}-b${i}`}>
        <div class="cp-photo"><img src={it.img.src} alt={it.img.alt} loading="lazy" /></div>
        <div class="cp-text">
          <p class="cp-big" aria-hidden="true">{it.title}</p>
          <p class="cp-line">{it.line}</p>
          {it.tag && <p class="cp-tag mono">{it.tag}</p>}
          <p class="cp-count mono">{i + 1} / {items.length}</p>
        </div>
      </div>
    </article>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-colour-panels]").forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>(".cp-panel")];
    const wide = matchMedia("(min-width: 900px)");
    const mouse = matchMedia("(hover: hover) and (pointer: fine)");
    const open = (panel: HTMLElement, toggle = false) => {
      const already = panel.classList.contains("is-open");
      // Side by side, one panel is always open; stacked, a tap can close it again.
      const closing = toggle && already && !wide.matches;
      panels.forEach((p) => {
        const on = p === panel ? !closing : false;
        if (!wide.matches && p !== panel) return;
        p.classList.toggle("is-open", on);
        p.querySelector("button")!.setAttribute("aria-expanded", String(on));
      });
    };
    panels.forEach((panel) => {
      panel.querySelector("button")!.addEventListener("click", () => open(panel, true));
      let timer = 0;
      panel.addEventListener("pointerenter", () => {
        if (!wide.matches || !mouse.matches) return;
        timer = window.setTimeout(() => open(panel), 140);
      });
      panel.addEventListener("pointerleave", () => clearTimeout(timer));
    });
    // Going from stacked to side by side, keep exactly one panel open.
    wide.addEventListener("change", () => open(panels.find((p) => p.classList.contains("is-open")) ?? panels[0]));
  });
</script>

<style>
  .cp {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cp-panel {
    background: var(--tone);
    color: var(--ink);
    border-radius: 10px;
    overflow: hidden;
  }
  .cp-title {
    margin: 0;
  }
  .cp-title button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 20px 22px;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .cp-plus {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border: 1px solid color-mix(in srgb, var(--ink) 55%, transparent);
    border-radius: 50%;
  }
  .cp-plus::before,
  .cp-plus::after {
    content: "";
    position: absolute;
    inset: 50% 10px auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .cp-plus::after {
    transform: rotate(90deg);
  }
  .is-open .cp-plus::after {
    transform: rotate(0deg);
  }
  .cp-body {
    display: grid;
  }
  :global(html.js) .cp-panel:not(.is-open) .cp-body {
    display: none;
  }
  :global(html:not(.js)) .cp-plus {
    display: none;
  }
  .cp-photo img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .cp-text {
    display: grid;
    gap: 8px;
    padding: 20px 22px 22px;
  }
  .cp-big {
    display: none;
  }
  .cp-line {
    max-width: 34ch;
  }
  .cp-tag,
  .cp-count {
    opacity: 0.75;
  }

  /* Side by side on wide screens (with JavaScript) */
  @media (min-width: 900px) {
    :global(html.js) .cp {
      flex-direction: row;
      height: 560px;
      container-type: inline-size;
    }
    :global(html.js) .cp-panel {
      position: relative;
      flex: 0 1 92px;
      transition: flex-grow 0.8s var(--ease);
    }
    :global(html.js) .cp-panel.is-open {
      flex-grow: 1;
    }
    /* Closed: the whole panel is the button, its title standing up the edge */
    :global(html.js) .cp-panel:not(.is-open) .cp-title button {
      position: absolute;
      inset: 0;
      flex-direction: column-reverse;
      justify-content: space-between;
      padding: 22px 0;
    }
    :global(html.js) .cp-panel:not(.is-open) .cp-name {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 30px;
      white-space: nowrap;
    }
    /* Open: the title moves into the colour block under the photo */
    :global(html.js) .cp-panel.is-open .cp-title button {
      position: absolute;
      right: 0;
      bottom: 0;
      width: auto;
      padding: 22px;
    }
    :global(html.js) .cp-panel.is-open .cp-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    :global(html.js) .cp-body {
      position: absolute;
      inset: 0 auto 0 0;
      width: calc(100cqi - (var(--n) - 1) * 98px);
      grid-template-rows: 58% 1fr;
    }
    :global(html.js) .cp-panel.is-open .cp-body {
      animation: cp-in 0.7s 0.15s var(--ease) both;
    }
    :global(html.js) .cp-photo,
    :global(html.js) .cp-photo img {
      height: 100%;
      aspect-ratio: auto;
    }
    :global(html.js) .cp-text {
      grid-template-columns: 1fr auto;
      grid-template-rows: 1fr auto;
      align-items: end;
      padding: 26px 96px 26px 28px;
    }
    :global(html.js) .cp-big {
      display: block;
      grid-column: 1;
      font-size: clamp(40px, 4.4vw, 60px);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.04em;
    }
    :global(html.js) .cp-line {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      text-align: right;
      font-size: 15px;
    }
    :global(html.js) .cp-tag {
      display: none;
    }
    :global(html.js) .cp-count {
      grid-column: 1;
    }
  }
  @keyframes cp-in {
    from {
      opacity: 0;
    }
  }
</style>
