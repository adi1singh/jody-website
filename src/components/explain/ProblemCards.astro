---
// JobGen's "solutions, organised by the problem a customer would name". Each
// card leads with the problem in the visitor's words, then names the fix, in its
// own category colour, with a pointer-following spotlight (Digital Bridge).
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  items: { problem: string; name: string; text: string; tint?: string; href?: string; cta?: string }[];
}
const { eyebrow, title, sub, items } = Astro.props;
const tints = ["var(--c1)", "var(--c6)", "var(--c3)", "var(--c2)", "var(--c4)", "var(--c5)"];
---
<section class="section" id="solutions">
  <div class="wrap">
    <div class="section-head">
      {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
      <h2 class="reveal" set:html={title} />
      {sub && <p class="section-sub reveal">{sub}</p>}
    </div>
    <ul class="grid problems">
      {items.map((it, i) => (
        <li class="card spotlight reveal" style={`--tint:${it.tint ?? tints[i % tints.length]}; --spot:var(--tint)`}>
          <p class="problem">“{it.problem}”</p>
          <h3><span class="dot" aria-hidden="true"></span>{it.name}</h3>
          <p class="text">{it.text}</p>
          {it.href && <a class="more" href={it.href}>{it.cta ?? "Learn more"} <span aria-hidden="true">→</span></a>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problems {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 2px solid var(--tint);
  }
  .problem {
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--tint);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tint);
    box-shadow: 0 0 12px var(--tint);
  }
  .text {
    color: var(--muted);
    font-size: 15px;
  }
  .more {
    font-size: 14px;
    font-weight: 500;
  }
  .more span {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }
  .more:hover span {
    transform: translateX(4px);
  }
</style>
