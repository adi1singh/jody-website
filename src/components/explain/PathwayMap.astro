---
// Pathwise ("See where your next step could take you"): visitors drag an area
// card onto the board (or tap or click it) and a route draws itself step by
// step: what each step is, what it leads to, how long it takes and what it
// costs. "Where are you now?" moves the starting point, fades the steps already
// done and shows notes where past experience may count. A short demo shows a
// card gliding onto the target until someone tries it.
//
// Dragging is for mouse and pen; touch keeps a simple tap so the page scrolls
// normally. Keyboard: arrows, Home and End move between areas. Without
// JavaScript every route is shown in full, one after another.
interface Step {
  level?: string;
  /** HTML allowed, e.g. "Course A <em>or</em> Course B" or a link. */
  title: string;
  text?: string;
  facts?: { label: string; value: string }[];
  /** Shown when the visitor's stage says their experience may count here. */
  note?: string;
}
interface Route {
  id: string;
  label: string;
  /** Small line under the label, e.g. "4 steps · from $1,200". */
  meta?: string;
  img?: string;
  tint?: string;
  steps: Step[];
}
interface Stage {
  label: string;
  /** Step the visitor starts at (0 = the first). */
  start?: number;
  /** Steps, counted from their start, where a step's note shows. */
  notes?: number[];
}
interface Props {
  eyebrow?: string;
  /** HTML; <em> for the accent words. */
  title: string;
  lead?: string;
  routes: Route[];
  stages?: Stage[];
  labels?: Partial<typeof defaults>;
}
const defaults = {
  pick: "Drag the area you want to explore",
  pickTap: "Tap the area you want to explore",
  drop: "Drop an area here",
  dropTap: "Tap an area to see the route",
  dropSub: "The route appears here, step by step.",
  dropSubDrag: " Or just click an area.",
  result: "Your route in",
  change: "Change area",
  where: "Where are you now?",
  you: "You start here",
  done: "Already done",
  tabs: "Choose an area",
};
const { eyebrow, title, lead, routes, stages = [], labels: l = {} } = Astro.props;
const t = { ...defaults, ...l };
const tints = ["var(--c1)", "var(--c2)", "var(--c3)", "var(--c4)", "var(--c5)", "var(--c6)"];
const acc = (r: Route, i: number) => `--acc:${r.tint ?? tints[i % tints.length]}`;
---
<section class="section light pmap" aria-labelledby="pmap-title" data-pmap data-stages={JSON.stringify(stages)}>
  <div class="wrap">
    <div class="pmap-head">
      <div>
        {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
        <h2 id="pmap-title" class="reveal" set:html={title} />
      </div>
      {lead && <p class="pmap-lead reveal">{lead}</p>}
    </div>

    <div class="pmap-board">
      <div class="pmap-tray">
        <p class="pmap-label"><span class="pmap-num">1</span><span class="drag-only">{t.pick}</span><span class="tap-only">{t.pickTap}</span></p>
        <div class="pmap-tabs" role="tablist" aria-label={t.tabs}>
          {routes.map((r, i) => (
            <button type="button" class="pmap-token" role="tab" id={`pmt-${r.id}`} aria-controls={`pm-${r.id}`} aria-selected="false" tabindex={i === 0 ? 0 : -1} data-pmap-tab={r.id} style={acc(r, i)}>
              {r.img && <span class="pmap-token-photo"><img src={r.img} alt="" draggable="false" loading="lazy" /></span>}
              <span class="pmap-token-text"><strong>{r.label}</strong>{r.meta && <small>{r.meta}</small>}</span>
              <span class="pmap-grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
            </button>
          ))}
        </div>
      </div>

      <div class="pmap-zone" data-pmap-zone>
        <div class="pmap-drop">
          <svg class="pmap-map" viewBox="0 0 600 260" preserveAspectRatio="none" aria-hidden="true"><path d="M30 220C140 220 150 150 240 150S330 70 420 70 530 40 570 30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 12" /><circle cx="30" cy="220" r="9" /><circle cx="240" cy="150" r="9" /><circle cx="420" cy="70" r="9" /><circle cx="570" cy="30" r="9" /></svg>
          <div class="pmap-target" aria-hidden="true">
            <span></span><span></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="2.5" /><circle cx="18" cy="5" r="2.5" /><path d="M8.5 19h6a3.5 3.5 0 0 0 0-7h-5a3.5 3.5 0 0 1 0-7h6" /></svg>
          </div>
          <p class="pmap-drop-title"><span class="drag-only">{t.drop}</span><span class="tap-only">{t.dropTap}</span></p>
          <p class="pmap-drop-sub">{t.dropSub}<span class="drag-only">{t.dropSubDrag}</span></p>
          <span class="pmap-demo" aria-hidden="true">
            <span class="pmap-demo-chip" style={acc(routes[0], 0)}>{routes[0].label}</span>
            <svg class="pmap-demo-cursor" viewBox="0 0 24 24"><path d="M5 3l14 8-6 1.5L10 19z" fill="#15201b" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" /></svg>
          </span>
        </div>

        <div class="pmap-result">
          <div class="pmap-result-head">
            <p class="pmap-result-title">{t.result} <strong data-pmap-name>{routes[0].label}</strong></p>
            <button type="button" class="pmap-reset" data-pmap-reset><span aria-hidden="true">✕</span> {t.change}</button>
          </div>
          {stages.length > 0 && (
            <fieldset class="pmap-exp">
              <legend><span class="pmap-num">2</span> {t.where}</legend>
              <div>
                {stages.map((s, i) => (
                  <label><input type="radio" name="pmap-stage" value={i} checked={i === 0} /><span>{s.label}</span></label>
                ))}
              </div>
            </fieldset>
          )}
          {routes.map((r, ri) => (
            <div class="pmap-panel is-drawn" role="tabpanel" id={`pm-${r.id}`} aria-labelledby={`pmt-${r.id}`} data-pmap-panel={r.id} data-inactive style={acc(r, ri)}>
              <h3 class="pmap-panel-title">{r.label}</h3>
              <ol class="pmap-route" style={`--stops:${r.steps.length}`}>
                {r.steps.map((s, n) => (
                  <li class:list={["pmap-stop", "is-ahead", { "is-start": n === 0 }]} style={`--i:${n}`}>
                    <span class="pmap-node" aria-hidden="true"><span>{n + 1}</span></span>
                    <div class="pmap-card">
                      <p class="pmap-you" data-you hidden><span aria-hidden="true">●</span> {t.you}</p>
                      {s.level && <p class="pmap-level">{s.level}</p>}
                      <h4 class="pmap-title" set:html={s.title} />
                      {s.text && <p class="pmap-text">{s.text}</p>}
                      {s.note && <p class="pmap-note" data-note hidden>{s.note}</p>}
                      {s.facts && (
                        <dl class="pmap-facts">
                          {s.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
                        </dl>
                      )}
                      <p class="pmap-done" data-done hidden><span aria-hidden="true">✓</span> {t.done}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Stage = { label: string; start?: number; notes?: number[] };
  const pmap = document.querySelector<HTMLElement>("[data-pmap]");
  if (pmap) {
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = pmap) => el.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = pmap) => [...el.querySelectorAll<T>(s)];
    const stages: Stage[] = JSON.parse(pmap.dataset.stages ?? "[]");
    const tabs = $$<HTMLButtonElement>("[data-pmap-tab]");
    const panels = $$("[data-pmap-panel]");
    const zone = $("[data-pmap-zone]");
    const nameEl = $("[data-pmap-name]");
    let stage = 0;
    let current: string | null = null;

    panels.forEach((p) => p.classList.remove("is-drawn"));
    const draw = (panel: HTMLElement) => {
      panel.classList.remove("is-drawn");
      void panel.offsetWidth; // restart the route animation
      panel.classList.add("is-drawn");
    };
    const apply = () => {
      const panel = panels.find((p) => p.dataset.pmapPanel === current);
      if (!panel) return;
      const stops = $$(".pmap-stop", panel);
      const s = stages[stage] ?? {};
      const start = Math.min(s.start ?? 0, stops.length - 1);
      stops.forEach((st, i) => {
        st.classList.toggle("is-done", i < start);
        st.classList.toggle("is-start", i === start);
        st.classList.toggle("is-ahead", i >= start);
        st.style.setProperty("--i", String(Math.max(i - start, 0)));
        $("[data-you]", st).hidden = i !== start;
        $("[data-done]", st).hidden = i >= start;
        const note = st.querySelector<HTMLElement>("[data-note]");
        if (note) note.hidden = !(s.notes ?? []).includes(i - start);
      });
      draw(panel);
    };
    const select = (tab: HTMLButtonElement, { focus = false, dropped = false } = {}) => {
      current = tab.dataset.pmapTab!;
      pmap.classList.add("has-choice");
      zone.setAttribute("style", tab.getAttribute("style") ?? "");
      nameEl.textContent = tab.querySelector("strong")!.textContent;
      tabs.forEach((t) => {
        t.setAttribute("aria-selected", String(t === tab));
        t.tabIndex = t === tab ? 0 : -1;
      });
      panels.forEach((p) => p.toggleAttribute("data-inactive", p.dataset.pmapPanel !== current));
      if (focus) tab.focus();
      if (dropped) {
        zone.classList.remove("is-landed");
        void zone.offsetWidth;
        zone.classList.add("is-landed");
      }
      apply();
    };
    const clear = () => {
      current = null;
      pmap.classList.remove("has-choice");
      zone.removeAttribute("style");
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", "false");
        t.tabIndex = i === 0 ? 0 : -1;
      });
      panels.forEach((p) => p.setAttribute("data-inactive", ""));
      tabs[0].focus();
    };

    let skipClick = false;
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        if (skipClick) return void (skipClick = false);
        select(tab);
      });
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (e.key === "Home") {
          e.preventDefault();
          select(tabs[0], { focus: true });
        } else if (e.key === "End") {
          e.preventDefault();
          select(tabs[tabs.length - 1], { focus: true });
        } else if (step) {
          e.preventDefault();
          select(tabs[(i + step + tabs.length) % tabs.length], { focus: true });
        }
      });
      tab.addEventListener("dragstart", (e) => e.preventDefault());
    });
    $$<HTMLInputElement>('input[name="pmap-stage"]').forEach((r) =>
      r.addEventListener("change", () => {
        stage = Number(r.value);
        apply();
      }),
    );
    $("[data-pmap-reset]").addEventListener("click", clear);

    // Dragging with a mouse or pen. Touch keeps a plain tap.
    let drag: { tab: HTMLButtonElement; id: number; x: number; y: number; dx: number; dy: number; w: number; ghost: HTMLElement | null } | null = null;
    const overZone = (x: number, y: number) => {
      const r = zone.getBoundingClientRect();
      return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
    };
    const endDrag = (dropped: boolean) => {
      const { tab, ghost } = drag!;
      pmap.classList.remove("is-dragging");
      zone.classList.remove("is-over");
      tab.classList.remove("is-lifted");
      if (dropped) ghost!.remove();
      else {
        const r = tab.getBoundingClientRect();
        ghost!.classList.add("is-returning");
        ghost!.style.transform = `translate(${r.left}px, ${r.top}px)`;
        setTimeout(() => ghost!.remove(), 260);
      }
      drag = null;
    };
    pmap.addEventListener("pointerdown", (e) => {
      const tab = (e.target as Element).closest<HTMLButtonElement>("[data-pmap-tab]");
      if (!tab || e.pointerType === "touch" || e.button !== 0) return;
      const r = tab.getBoundingClientRect();
      drag = { tab, id: e.pointerId, x: e.clientX, y: e.clientY, dx: e.clientX - r.left, dy: e.clientY - r.top, w: r.width, ghost: null };
    });
    addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (!drag.ghost) {
        if (Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 6) return;
        const ghost = drag.tab.cloneNode(true) as HTMLElement;
        ["id", "role", "aria-controls", "aria-selected", "tabindex", "data-pmap-tab"].forEach((a) => ghost.removeAttribute(a));
        ghost.setAttribute("aria-hidden", "true");
        ghost.classList.add("pmap-ghost");
        const look = getComputedStyle(drag.tab);
        ghost.style.width = `${drag.w}px`;
        ghost.style.background = look.backgroundColor;
        ghost.style.color = look.color;
        document.body.append(ghost);
        drag.ghost = ghost;
        drag.tab.classList.add("is-lifted");
        pmap.classList.add("is-dragging");
        zone.style.setProperty("--drag-acc", look.getPropertyValue("--acc"));
      }
      drag.ghost.style.transform = `translate(${e.clientX - drag.dx}px, ${e.clientY - drag.dy}px) rotate(-4deg)`;
      zone.classList.toggle("is-over", overZone(e.clientX, e.clientY));
    });
    addEventListener("pointerup", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (!drag.ghost) return void (drag = null); // a plain click: the click handler takes it
      skipClick = true;
      setTimeout(() => (skipClick = false), 0);
      const tab = drag.tab;
      const dropped = overZone(e.clientX, e.clientY);
      endDrag(dropped);
      if (dropped) select(tab, { dropped: true });
    });
    addEventListener("pointercancel", () => {
      if (drag?.ghost) endDrag(false);
      drag = null;
    });
  }
</script>

<style>
  .pmap {
    --acc: var(--accent);
    --ink: var(--text);
    position: relative;
    isolation: isolate;
  }
  .pmap::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(color-mix(in srgb, var(--text) 13%, transparent) 1.3px, transparent 1.6px) 0 0 / 24px 24px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 70%);
    mask-image: linear-gradient(180deg, #000, transparent 70%);
  }
  .pmap::after {
    content: "";
    position: absolute;
    z-index: -1;
    right: -12rem;
    top: -10rem;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    pointer-events: none;
  }
  .pmap-head {
    display: grid;
    gap: 20px 48px;
    align-items: end;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  @media (min-width: 960px) {
    .pmap-head {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  h2 {
    max-width: 15ch;
    margin-top: 18px;
    font-size: clamp(36px, 4.6vw, 62px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  h2 :global(em) {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .pmap-lead {
    font-size: 19px;
    color: var(--muted);
  }
  .pmap-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px 28px;
  }
  .pmap-tray {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .pmap-board {
      grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.6fr);
      align-items: stretch;
    }
    .pmap:global(.has-choice) .pmap-board {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pmap-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-weight: 600;
  }
  .pmap-num {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--c2);
    font-size: 13px;
    font-weight: 650;
  }
  .tap-only {
    display: none;
  }
  @media (hover: none) {
    .drag-only {
      display: none;
    }
    .tap-only {
      display: inline;
    }
  }

  /* Area cards (tabs you can drag) */
  .pmap-tabs {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pmap-token {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    margin: 0;
    padding: 9px 15px 9px 9px;
    border: 2px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    color: var(--ink);
    text-align: left;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    box-shadow: 0 12px 24px -18px rgba(14, 21, 18, 0.45);
    transition:
      transform 0.28s var(--ease),
      box-shadow 0.28s,
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s,
      opacity 0.2s;
  }
  .pmap-token:hover {
    transform: translateX(8px) rotate(-1.2deg);
    border-color: var(--acc);
    box-shadow: 0 22px 34px -20px rgba(14, 21, 18, 0.5);
  }
  .pmap-token:active {
    cursor: grabbing;
  }
  .pmap-token-photo {
    flex: none;
    width: 66px;
    height: 54px;
    overflow: hidden;
    border-radius: 12px;
    background: color-mix(in srgb, var(--acc) 18%, var(--surface));
  }
  .pmap-token-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: transform 0.5s var(--ease);
  }
  .pmap-token:hover .pmap-token-photo img {
    transform: scale(1.14);
  }
  .pmap-token-text {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }
  .pmap-token-text strong {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .pmap-token-text small {
    font: 11px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--acc) 70%, var(--ink));
  }
  .pmap-grip {
    display: grid;
    flex: none;
    grid-template-columns: repeat(2, 4px);
    gap: 3px;
    opacity: 0.3;
    transition: opacity 0.2s;
  }
  .pmap-grip i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }
  .pmap-token:hover .pmap-grip {
    opacity: 0.85;
  }
  .pmap-token[aria-selected="true"] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--acc);
  }
  .pmap-token[aria-selected="true"] small {
    color: color-mix(in srgb, var(--acc) 40%, var(--bg));
  }
  .pmap:global(.has-choice) .pmap-token[aria-selected="false"] {
    opacity: 0.62;
  }
  .pmap:global(.has-choice) .pmap-token[aria-selected="false"]:hover,
  .pmap:global(.has-choice) .pmap-token[aria-selected="false"]:focus-visible {
    opacity: 1;
  }
  .pmap-token:global(.is-lifted) {
    opacity: 0.35;
    transform: scale(0.97);
    box-shadow: none;
  }
  @media (hover: none) {
    .pmap-grip {
      display: none;
    }
  }
  @media (min-width: 1000px) {
    .pmap:global(.has-choice) .pmap-tabs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
    .pmap:global(.has-choice) .pmap-token {
      gap: 10px;
      padding: 6px 10px 6px 6px;
    }
    .pmap:global(.has-choice) .pmap-token:hover {
      transform: translateY(-4px);
    }
    .pmap:global(.has-choice) .pmap-token-photo {
      width: 46px;
      height: 40px;
      border-radius: 10px;
    }
    .pmap:global(.has-choice) .pmap-token-text strong {
      font-size: 14px;
    }
    .pmap:global(.has-choice) .pmap-grip {
      display: none;
    }
  }
  @media (max-width: 999.98px) {
    .pmap-tabs {
      flex-direction: row;
      overflow-x: auto;
      margin: -6px -4px 0;
      padding: 6px 4px 12px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }
    .pmap-token {
      flex: none;
      width: min(78vw, 270px);
      scroll-snap-align: start;
    }
    .pmap-token:hover {
      transform: translateY(-3px);
    }
  }
  /* The card that follows the pointer (it lives on <body>) */
  .pmap-token:global(.pmap-ghost) {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 200;
    pointer-events: none;
    border-color: var(--acc);
    box-shadow: 0 34px 60px -24px rgba(30, 15, 90, 0.65);
    transition: none;
  }
  .pmap-token:global(.pmap-ghost.is-returning) {
    opacity: 0.4;
    transition:
      transform 0.25s var(--ease),
      opacity 0.25s;
  }
  :global(body:has(.is-dragging)) {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Drop zone */
  .pmap-zone {
    --drag-acc: var(--accent);
    position: relative;
    min-width: 0;
  }
  .pmap-drop {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 8px;
    height: 100%;
    min-height: 360px;
    overflow: hidden;
    padding: 40px 32px;
    border: 2.5px dashed var(--line-strong);
    border-radius: 28px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    text-align: center;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      transform 0.3s var(--ease);
  }
  .pmap-map {
    position: absolute;
    left: 6%;
    top: 12%;
    width: 88%;
    height: 76%;
