---
// Digital Bridge: on wide screens the section pins and vertical scrolling slides
// the panels sideways. On small screens, or with reduced motion, it becomes a
// normal swipeable row, so nothing depends on the effect.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  panels: { title: string; text: string; img: string; alt: string }[];
}
const { eyebrow, title, intro, panels } = Astro.props;
---
<section class="hstory" id="story" data-hstory aria-labelledby="hstory-title">
  <div class="hstory-sticky">
    <div class="hstory-track">
      <div class="hstory-intro">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id="hstory-title" set:html={title} />
        {intro && <p>{intro}</p>}
        <span class="hint" aria-hidden="true">KEEP SCROLLING →</span>
      </div>
      {panels.map((p, i) => (
        <figure class="panel">
          <div class="panel-photo"><img src={p.img} alt={p.alt} loading="lazy" /></div>
          <figcaption>
            <span class="mono">0{i + 1}</span>
            <strong>{p.title}</strong>
            <span>{p.text}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hstory]").forEach((outer) => {
    const inner = outer.querySelector<HTMLElement>(".hstory-track")!;
    const wide = matchMedia("(min-width: 900px)");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    const update = () => {
      frame = 0;
      if (outer.dataset.pinned !== "true") return void (inner.style.transform = "");
      const distance = inner.scrollWidth - innerWidth;
      const p = Math.max(0, Math.min(1, -outer.getBoundingClientRect().top / Math.max(distance, 1)));
      inner.style.transform = `translate3d(${-p * distance}px,0,0)`;
      inner.style.setProperty("--p", String(p));
    };
    const layout = () => {
      const pinned = wide.matches && !still.matches;
      outer.dataset.pinned = String(pinned);
      outer.style.height = pinned ? `${inner.scrollWidth - innerWidth + innerHeight}px` : "";
      update();
    };
    layout();
    addEventListener("scroll", () => frame || (frame = requestAnimationFrame(update)), { passive: true });
    addEventListener("resize", layout);
    wide.addEventListener("change", layout);
    document.fonts?.ready.then(layout);
  });
</script>

<style>
  .hstory {
    position: relative;
    background: var(--surface);
  }
  .hstory-sticky {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 90px 0;
    scrollbar-width: none;
  }
  .hstory[data-pinned="true"] .hstory-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    padding: 72px 0 0;
    display: flex;
    align-items: center;
  }
  .hstory-track {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 70px);
    width: max-content;
    padding: 0 max(var(--gutter), 6vw);
    will-change: transform;
  }
  .hstory-intro {
    flex: 0 0 min(430px, 82vw);
    scroll-snap-align: start;
  }
  h2 {
    margin: 22px 0;
    font-size: clamp(3rem, 5.6vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }
  h2 :global(em) {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--accent);
  }
  .hstory-intro p {
    color: var(--muted);
    max-width: 360px;
  }
  .hint {
    display: inline-block;
    margin-top: 30px;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--accent);
    animation: nudge 1.8s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(10px);
    }
  }
  .panel {
    flex: 0 0 min(44vw, 74vh);
    scroll-snap-align: start;
  }
  .panel-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .panel-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18) translateX(calc((var(--p, 0.5) - 0.5) * -10%));
    transition: transform 0.9s var(--ease-out);
  }
  .panel:hover .panel-photo img {
    transform: scale(1.24) translateX(calc((var(--p, 0.5) - 0.5) * -10%));
  }
  figcaption {
    display: grid;
    gap: 4px;
    margin-top: 18px;
  }
  figcaption strong {
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  figcaption span:last-child {
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .panel {
      flex-basis: 82vw;
    }
  }
</style>
