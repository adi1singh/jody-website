---
// Inspiration board (2026): a big statement
// that starts pale and inks in word by word as it scrolls up the screen, so
// the line being read is always the darkest. Seen on Aevion (Riotters) and
// Cerebrium. Below it, the still two-tone version from United Carriers.
// Pure CSS (a scroll-linked view timeline); browsers without it, reduced
// motion and no JavaScript all show the finished text.
//
// <InkStatement text="Detecting cracks..." quiet="We move freight." loud="We own the outcome." />
interface Props {
  text: string;
  /** Optional still two-tone line: the quiet half, then the loud half. */
  quiet?: string;
  loud?: string;
}
const { text, quiet, loud } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
// Each word gets its own slice of the scroll: the paragraph inks between 18%
// and 52% of its trip across the screen, one word after another.
const start = 18;
const span = 34;
const slot = span / words.length;
const range = (i: number) => `--a:${(start + i * slot).toFixed(2)}%;--b:${(start + i * slot + slot * 2.5).toFixed(2)}%`;
---
<div class="ink">
  <p class="ink-text">
    {words.map((w, i) => (
      <>
        <span style={range(i)}>{w}</span>{" "}
      </>
    ))}
  </p>
  {quiet && loud && (
    <p class="ink-two">
      <span>{quiet}</span> {loud}
    </p>
  )}
</div>

<style>
  .ink {
    display: grid;
    gap: clamp(48px, 8vw, 96px);
    max-width: 980px;
  }
  .ink-text {
    font-size: clamp(28px, 4.2vw, 58px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.035em;
    view-timeline-name: --ink;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .ink-text span {
        animation-name: ink;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --ink;
        animation-range: cover var(--a) cover var(--b);
      }
    }
  }
  @keyframes ink {
    from {
      color: color-mix(in srgb, var(--text) 18%, transparent);
    }
    to {
      color: var(--text);
    }
  }
  .ink-two {
    font-size: clamp(32px, 5vw, 68px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .ink-two span {
    display: block;
    color: color-mix(in srgb, var(--text) 38%, transparent);
  }
</style>
