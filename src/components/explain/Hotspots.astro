---
// Inspiration board (2026): a fine line drawing in
// a drafting frame (crosshair corners, grid references) with numbered,
// pulsing markers; choosing one shows its note beside it (under the drawing
// on phones). Seen on Heron AI (the frame, the orange markers) and ERA
// Residence (markers on the render). Each marker is a link to its note, so
// without JavaScript it jumps to the numbered list under the drawing.
//
// <Hotspots img={{ src, alt }} tone="#fa3600" spots={[{ x: 46, y: 46, title, text }]} />
interface Spot {
  /** Position over the image, in % from the left and top. */
  x: number;
  y: number;
  title: string;
  text: string;
}
interface Props {
  img: { src: string; alt: string };
  spots: Spot[];
  /** Marker and frame-mark colour (hex). */
  tone: string;
  caption?: string;
}
const { img, spots, tone, caption } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<div class="hs" data-hotspots style={`--tone:${tone}`}>
  <div class="hs-frame">
    <span class="hs-mark hs-tl" aria-hidden="true"></span>
    <span class="hs-mark hs-tr" aria-hidden="true"></span>
    <span class="hs-mark hs-bl" aria-hidden="true"></span>
    <span class="hs-mark hs-br" aria-hidden="true"></span>
    <span class="hs-ref hs-ref-top mono" aria-hidden="true"><i>A</i><i>B</i><i>C</i><i>D</i></span>
    <span class="hs-ref hs-ref-side mono" aria-hidden="true"><i>1</i><i>2</i><i>3</i></span>
    <div class="hs-art">
      <div class="hs-pic">
        <img src={img.src} alt={img.alt} loading="lazy" />
        {spots.map((s, i) => (
          <a class="hs-dot" href={`#hs-${uid}-${i}`} style={`--x:${s.x}%;--y:${s.y}%`} data-i={i}>
            <span aria-hidden="true">{i + 1}</span>
            <span class="sr-only">{s.title}</span>
          </a>
        ))}
      </div>
      <ol class="hs-notes">
        {spots.map((s, i) => (
          <li class="hs-note" id={`hs-${uid}-${i}`} style={`--x:${s.x}%;--y:${s.y}%`} data-side={s.x > 58 ? "left" : "right"} tabindex="-1">
            <p class="mono">0{i + 1}</p>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
  {caption && <p class="hs-caption mono">{caption}</p>}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-hotspots]").forEach((root) => {
    const dots = [...root.querySelectorAll<HTMLAnchorElement>(".hs-dot")];
    const notes = [...root.querySelectorAll<HTMLElement>(".hs-note")];
    root.classList.add("is-live");
    dots.forEach((d) => {
      d.setAttribute("role", "button");
      d.setAttribute("aria-expanded", "false");
      d.setAttribute("aria-controls", notes[Number(d.dataset.i)].id);
    });
    const show = (i: number | null) => {
      dots.forEach((d, j) => d.setAttribute("aria-expanded", String(i === j)));
      notes.forEach((n, j) => n.classList.toggle("is-on", i === j));
    };
    dots.forEach((d) =>
      d.addEventListener("click", (e) => {
        e.preventDefault();
        const i = Number(d.dataset.i);
        show(d.getAttribute("aria-expanded") === "true" ? null : i);
      }),
    );
    // Space works like Enter, as for any button.
    dots.forEach((d) =>
      d.addEventListener("keydown", (e) => {
        if (e.key === " ") {
          e.preventDefault();
          d.click();
        }
      }),
    );
    root.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = dots.find((d) => d.getAttribute("aria-expanded") === "true");
      show(null);
      open?.focus();
    });
    document.addEventListener("click", (e) => {
      if (!(e.target as Element).closest(".hs-dot, .hs-note")) show(null);
    });
  });
</script>

<style>
  .hs {
    display: grid;
    gap: 14px;
  }
  .hs-frame {
    position: relative;
    padding: clamp(28px, 4vw, 44px);
    border: 1px solid var(--line-strong);
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: -1px -1px;
  }
  .hs-mark {
    position: absolute;
    width: 14px;
    height: 14px;
  }
  .hs-mark::before,
  .hs-mark::after {
    content: "";
    position: absolute;
    background: var(--text);
  }
  .hs-mark::before {
    inset: 6px 0 auto;
    height: 1px;
  }
  .hs-mark::after {
    inset: 0 auto 0 6px;
    width: 1px;
  }
  .hs-tl {
    top: 8px;
    left: 8px;
  }
  .hs-tr {
    top: 8px;
    right: 8px;
  }
  .hs-bl {
    bottom: 8px;
    left: 8px;
  }
  .hs-br {
    bottom: 8px;
    right: 8px;
  }
  .hs-ref {
    position: absolute;
    display: flex;
    justify-content: space-around;
    color: var(--faint);
    font-size: 10px;
  }
  .hs-ref i {
    font-style: normal;
  }
  .hs-ref-top {
    top: 8px;
    left: 44px;
    right: 44px;
  }
  .hs-ref-side {
    flex-direction: column;
    top: 44px;
    bottom: 44px;
    left: 12px;
  }
  /* The drawing and its markers; notes are positioned against .hs-art, which
     is the same size once the notes float beside the markers. */
  .hs-art,
  .hs-pic {
    position: relative;
  }
  .hs-art img {
    width: 100%;
    mix-blend-mode: multiply;
  }
  .hs-dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: var(--tone);
    color: #fff;
    font: 600 12px/1 var(--font-mono);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone) 55%, transparent);
    animation: hs-pulse 2.4s infinite;
    transition: transform 0.25s var(--ease);
  }
  .hs-dot:hover,
  .hs-dot[aria-expanded="true"] {
    transform: scale(1.18);
    animation: none;
  }
  @keyframes hs-pulse {
    70%,
    100% {
      box-shadow: 0 0 0 14px color-mix(in srgb, var(--tone) 0%, transparent);
    }
  }
  /* Without JavaScript: a numbered list under the drawing */
  .hs-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .hs-note {
    display: grid;
    gap: 4px;
    font-size: 14px;
  }
  .hs-note .mono {
    color: var(--tone);
  }
  .hs-note h4 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hs-note p:last-child {
    color: var(--muted);
  }
  /* With JavaScript: one note at a time, beside its marker */
  .hs:global(.is-live) .hs-note {
    display: none;
  }
  .hs:global(.is-live) .hs-note:global(.is-on) {
    display: grid;
    animation: hs-in 0.35s var(--ease) both;
  }
  .hs:global(.is-live) .hs-note {
    padding: 16px 18px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  }
  @media (min-width: 760px) {
    .hs:global(.is-live) .hs-notes {
      position: absolute;
      inset: 0;
      display: block;
      margin: 0;
      pointer-events: none;
    }
    .hs:global(.is-live) .hs-note {
      position: absolute;
      top: var(--y);
      width: 260px;
      transform: translateY(-50%);
      pointer-events: auto;
    }
    .hs-note[data-side="right"] {
      left: calc(var(--x) + 26px);
    }
    .hs-note[data-side="left"] {
      right: calc(100% - var(--x) + 26px);
    }
  }
  @keyframes hs-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  .hs-caption {
    color: var(--faint);
    font-size: 11px;
  }
</style>
