---
// Digital Bridge ("Big ambitions. Room to grow."): a full-screen photo stays
// pinned while numbered chapters scroll over it, and the photo slowly zooms
// out as you go. A small caption sits in the corner. The zoom uses CSS
// scroll-linked animation where supported, with a light script fallback
// elsewhere; with reduced motion the photo is a still backdrop.
//
// <PhotoStory img={{ src }} caption="SYDNEY, AUSTRALIA" chapters={[
//   { eyebrow: "01 / THE AMBITION", title: "Big ambitions.<br /><em>Room to grow.</em>", text: "..." },
//   { eyebrow: "02 / THE WAY FORWARD", title: "...", text: "...", cta: { label, href } }]} />
interface Chapter {
  eyebrow?: string;
  /** HTML; <em> for the coloured line. */
  title: string;
  text?: string;
  cta?: { label: string; href: string };
}
interface Props {
  img: { src: string };
  caption?: string;
  chapters: Chapter[];
  cue?: string;
  label?: string;
}
const { img, caption, chapters, cue = "KEEP SCROLLING ↓", label = "Our approach" } = Astro.props;
---
<section class="story" aria-label={label} data-photo-story>
  <div class="story-backdrop" aria-hidden="true">
    <img class="story-img" src={img.src} alt="" loading="lazy" data-story-img />
    <div class="story-shade"></div>
    {caption && <span class="story-caption">{caption}</span>}
  </div>
  <div class="wrap story-chapters">
    {chapters.map((c, i) => (
      <div class="story-chapter">
        {c.eyebrow && <p class="eyebrow">{c.eyebrow}</p>}
        <h2 set:html={c.title} />
        {c.text && <p class="story-text">{c.text}</p>}
        {c.cta && <a class="btn story-btn magnetic" href={c.cta.href}>{c.cta.label} <span aria-hidden="true">→</span></a>}
        {i === 0 && chapters.length > 1 && <span class="story-cue" aria-hidden="true">{cue}</span>}
      </div>
    ))}
  </div>
</section>

<script>
  // Fallback zoom for browsers without scroll-linked CSS animation.
  const story = document.querySelector<HTMLElement>("[data-photo-story]");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (story && !still && !CSS.supports("animation-timeline: view()")) {
    const img = story.querySelector<HTMLElement>("[data-story-img]")!;
    let frame = 0;
    const update = () => {
      frame = 0;
      const r = story.getBoundingClientRect();
      const k = Math.min(1, Math.max(0, (innerHeight - r.top) / (r.height + innerHeight)));
      img.style.transform = `scale(${1.18 - 0.18 * k})`;
    };
    addEventListener("scroll", () => frame || (frame = requestAnimationFrame(update)), { passive: true });
    update();
  }
</script>

<style>
  .story {
    --story-accent: color-mix(in srgb, var(--c3) 45%, #fff);
    position: relative;
    isolation: isolate;
    background: #101b22;
    color: #fff;
  }
  .story-backdrop {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
  }
  .story-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 60%;
  }
  .story-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(270deg, rgba(7, 18, 25, 0.92), rgba(7, 18, 25, 0.72) 45%, rgba(7, 18, 25, 0.12) 85%);
  }
  .story-caption {
    position: absolute;
    left: 4%;
    bottom: 28px;
    font: 500 10px var(--font-mono);
    letter-spacing: 0.12em;
  }
  .story-chapters {
    position: relative;
    margin-top: calc(-1 * max(100svh, 480px));
  }
  .story-chapter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    max-width: 620px;
    min-height: max(100svh, 480px);
    margin-left: auto;
    padding: 130px 0 100px;
  }
  .story-chapter .eyebrow {
    color: var(--story-accent);
  }
  h2 {
    margin: 18px 0 30px;
    font-size: clamp(52px, 6.6vw, 107px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  h2 :global(em) {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--story-accent);
  }
  .story-text {
    max-width: 470px;
    font-size: 18px;
    line-height: 1.75;
    color: #f3f5f6;
  }
  .story-btn {
    margin-top: 30px;
    background: var(--c3);
    color: #19241f;
  }
  .story-cue {
    margin-top: 44px;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.13em;
  }
  @supports (animation-timeline: view()) {
    .story {
      view-timeline-name: --story;
    }
    .story-img {
      animation-name: story-zoom;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --story;
      animation-range: entry 0% exit 100%;
    }
  }
  @keyframes story-zoom {
    from {
      transform: scale(1.18);
    }
    to {
      transform: scale(1);
    }
  }
  @media (max-width: 800px) {
    .story-shade {
      background: rgba(7, 18, 25, 0.77);
    }
    .story-chapter {
      padding: 110px 0 90px;
    }
    h2 {
      font-size: clamp(46px, 11vw, 80px);
    }
    .story-text {
      font-size: 16px;
    }
    .story-caption {
      left: 20px;
      right: 20px;
      bottom: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story-backdrop {
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 0;
    }
    .story-img {
      animation: none;
    }
    .story-chapters {
      margin-top: 0;
    }
    .story-chapter {
      min-height: 0;
      padding: 80px 0;
    }
    .story-cue {
      display: none;
    }
  }
</style>
