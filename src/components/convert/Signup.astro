---
// Jody's site: a short email sign-up (first name, email, optional choices)
// for lead capture, used for the free audio, the pop-up and the book
// waitlist. Sends to the same endpoint as the contact form
// (SITE.form.endpoint), with a `list` field so the CRM can tell the sign-ups
// apart. Several per page are fine.
// Version 3 look: underlined fields (no boxes), small-caps labels, Manrope,
// a pill .btn-primary. Colours come from the section tone, so it sits right on
// ivory, .white, .dark and .burgundy alike.
// - No endpoint yet: the fields show switched off under one small, honest
//   line ("Preview · sign-ups open soon"), so nobody fills it in for nothing.
// - With JavaScript: field messages, sends in the background, success only
//   once the service accepts it. Without JavaScript it posts as a normal form.
// - A hidden field catches simple spam bots. Nothing is sent until submit.
//
// <Signup list="free-audio" submit="Send me the audio" choices={["Sleep", "Anxiety"]} />
import { SITE } from "../../data/site";
interface Props {
  /** Name of the list in the CRM, e.g. "free-audio". */
  list: string;
  submit?: string;
  /** Optional tick boxes, e.g. which audios they want. */
  choices?: string[];
  choicesLabel?: string;
  /** Shown once the sign-up is accepted. */
  done?: string;
  /** Small print under the button. */
  note?: string;
}
const {
  list,
  submit = "Sign me up",
  choices = [],
  choicesLabel = "Which ones would you like?",
  done = "You’re on the list. Check your inbox soon.",
  note = "No spam. Unsubscribe any time.",
} = Astro.props;
const endpoint = SITE.form.endpoint;
const live = Boolean(endpoint);
const id = `su-${list}`;
const config = { endpoint, list, done, extraFields: SITE.form.extraFields ?? {}, email: SITE.email };
---
<form class="signup" action={live ? endpoint : undefined} method="post" novalidate data-signup data-config={JSON.stringify(config)}>
  {!live && (
    <p class="notice" role="note">
      <span class="preview-note">Preview · sign-ups open soon</span>
      <span class="notice-alt">Until then, <a href={`mailto:${SITE.email}?subject=${encodeURIComponent("Please add me to the list")}`}>email Jody</a> to be added.</span>
    </p>
  )}
  <fieldset disabled={!live}>
    <legend class="sr-only">Sign up</legend>
    <input type="hidden" name="list" value={list} />
    <div class="row">
      <div class="field" data-field>
        <label for={`${id}-name`}>First name</label>
        <input id={`${id}-name`} name="name" autocomplete="given-name" />
      </div>
      <div class="field" data-field>
        <label for={`${id}-email`}>Email</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
        <p class="error" data-error aria-live="polite"></p>
      </div>
    </div>
    {choices.length > 0 && (
      <div class="choices">
        <p class="choices-label">{choicesLabel}</p>
        <div class="chips">
          {choices.map((c) => (
            <label class="chip"><input type="checkbox" name="choices" value={c} checked /> <span>{c}</span></label>
          ))}
        </div>
      </div>
    )}
    <div class="trap" aria-hidden="true">
      <label>Leave this empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="actions">
      <button type="submit" class="btn btn-primary" data-submit>{submit} <span aria-hidden="true">→</span></button>
      {note && <p class="small">{note}</p>}
    </div>
  </fieldset>
  <div class="status" data-status tabindex="-1"></div>
</form>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  document.querySelectorAll<HTMLFormElement>("[data-signup]").forEach((form) => {
    const cfg = JSON.parse(form.dataset.config!) as { endpoint: string; list: string; done: string; extraFields: Record<string, string>; email: string };
    if (!cfg.endpoint) return;
    const email = form.querySelector<HTMLInputElement>("input[type=email]")!;
    const error = form.querySelector<HTMLElement>("[data-error]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const check = () => {
      const v = email.value.trim();
      const msg = !v ? "Please enter your email address." : EMAIL.test(v) ? "" : "Enter an email address like name@example.com.";
      error.textContent = msg;
      msg ? email.setAttribute("aria-invalid", "true") : email.removeAttribute("aria-invalid");
      return msg;
    };
    email.addEventListener("blur", () => email.value && check());
    email.addEventListener("input", () => email.hasAttribute("aria-invalid") && check());

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (check()) return email.focus();
      if (form.querySelector<HTMLInputElement>("[name=_gotcha]")?.value) return;
      const fd = new FormData(form);
      const data = {
        ...cfg.extraFields,
        list: cfg.list,
        name: String(fd.get("name") ?? "").trim(),
        email: email.value.trim(),
        choices: fd.getAll("choices").join(", "),
        _subject: `Website sign-up: ${cfg.list}`,
        page: location.href,
      };
      button.disabled = true;
      try {
        const res = await fetch(cfg.endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        let body: { ok?: boolean; success?: boolean } = {};
        try {
          body = await res.clone().json();
        } catch {}
        if (res.ok && body.ok !== false && body.success !== false) {
          const done = document.createElement("p");
          done.className = "done";
          done.tabIndex = -1;
          done.textContent = `${data.name ? `Thanks, ${data.name}. ` : ""}${cfg.done}`;
          form.replaceChildren(done);
          done.focus();
          return;
        }
        status.className = "status error";
        status.innerHTML = `<strong>Sorry, that didn’t go through</strong> (error ${res.status}). Please try again, or email <a href="mailto:${cfg.email}">${cfg.email}</a>.`;
        status.focus();
      } catch {
        status.className = "status error";
        status.innerHTML = `<strong>Sorry, that didn’t go through.</strong> Please check your connection, or email <a href="mailto:${cfg.email}">${cfg.email}</a>.`;
        status.focus();
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  /* Underlined fields and a pill button. Every colour is a section-tone
     variable (--text, --muted, --line-strong, --detail), so the same form
     reads on ivory, white, black and burgundy. */
  .signup {
    display: grid;
    gap: 22px;
  }
  fieldset {
    display: grid;
    gap: 26px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  /* Switched off but still legible: the preview line says why */
  fieldset[disabled] .row,
  fieldset[disabled] .choices {
    opacity: 0.85;
  }
  fieldset[disabled] * {
    cursor: not-allowed;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 22px 32px;
  }
  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  label,
  .choices-label {
    font: 600 var(--label) / 1.4 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  input:not([type="checkbox"]) {
    width: 100%;
    min-height: 48px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font: 400 17px/1.3 var(--font-sans);
    transition: border-color 0.4s var(--ease);
  }
  input:not([type="checkbox"]):hover {
    border-bottom-color: var(--text);
  }
  input:not([type="checkbox"]):focus {
    outline: none;
    border-bottom-color: var(--detail);
    box-shadow: 0 1px 0 0 var(--detail);
  }
  input:focus-visible {
    outline: none;
  }
  [aria-invalid="true"] {
    border-bottom-color: var(--c3);
  }
  p.error {
    margin: 0;
    color: var(--text);
    font: 500 13px/1.4 var(--font-sans);
  }
  p.error::before {
    content: "— ";
    color: var(--detail);
  }
  p.error:empty {
    display: none;
  }
  .choices-label {
    margin-bottom: 12px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 16px 9px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    font: 400 15px/1.2 var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.3s var(--ease);
  }
  .chip input {
    accent-color: var(--detail);
    width: 15px;
    height: 15px;
    margin: 0;
  }
  .chip:has(input:checked) {
    border-color: var(--detail);
  }
  .chip:has(input:focus-visible) {
    outline: 1px solid var(--detail);
    outline-offset: 3px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  button[data-submit] {
    gap: 12px;
  }
  /* On burgundy and black: an ivory button with black text */
  :global(.burgundy) button[data-submit],
  :global(.dark) button[data-submit] {
    background: var(--ivory);
    color: var(--black);
  }
  :global(.burgundy) button[data-submit]:hover,
  :global(.dark) button[data-submit]:hover {
    background: var(--gold);
  }
  button[data-submit]:focus-visible {
    outline: 1px solid var(--detail);
    outline-offset: 4px;
  }
  .small {
    margin: 0;
    color: var(--muted);
    font: 400 13px/1.5 var(--font-sans);
  }
  /* The honest "not open yet" line: one small label, not a warning box */
  .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin: 0;
    color: var(--muted);
    font: 400 13px/1.5 var(--font-sans);
  }
  .notice .preview-note {
    color: var(--text);
  }
  .notice .preview-note::before {
    border-color: var(--detail);
    background: var(--detail);
  }
  .notice a,
  .status :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--detail);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .status:empty {
    display: none;
  }
  .status {
    padding: 12px 0 0;
    border-top: 1px solid var(--c3);
    font-size: 14px;
    color: var(--text);
  }
  .signup :global(.done) {
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid var(--detail);
    border-bottom: 1px solid var(--line);
    font: italic 400 var(--step-3) / 1.35 var(--font-display);
    color: var(--text);
    outline: none;
  }
  @media (max-width: 560px) {
    .actions .btn {
      width: 100%;
    }
  }
</style>
