---
// Pathwise's course search: a big rounded search box with filter chips above a
// grid of results. Typing ranks the best matches first (title counts most,
// then keywords, then the description) and understands everyday words through
// `synonyms` ("childcare" → "early childhood"). Every word must match
// something. A count, an empty state with a reset, and the search kept in the
// address so it can be shared.
//
// Scroll past it and the bar docks under the header as a slim, frosted-glass
// strip until the results end. Without JavaScript the search is hidden and
// every item shows.
interface Item {
  title: string;
  text?: string;
  /** Matches a chip's value. */
  tag?: string;
  keywords?: string;
  meta?: string;
  href?: string;
  img?: string;
}
interface Props {
  eyebrow?: string;
  title?: string;
  sub?: string;
  items: Item[];
  chips?: { value: string; label: string }[];
  synonyms?: Record<string, string[]>;
  placeholder?: string;
  /** e.g. "courses", "services" */
  noun?: string;
}
const {
  eyebrow,
  title,
  sub,
  items,
  chips = [],
  synonyms = {},
  placeholder = "Search by name, job or everyday words",
  noun = "items",
} = Astro.props;
const tints = ["var(--c1)", "var(--c2)", "var(--c3)", "var(--c4)", "var(--c5)", "var(--c6)"];
const tintOf = (tag?: string) => tints[Math.max(0, chips.findIndex((c) => c.value === tag)) % tints.length];
const norm = (s = "") => s.toLowerCase();
---
<section class="section light sd" data-search-dock data-noun={noun} data-synonyms={JSON.stringify(synonyms)}>
  <div class="wrap">
    {(eyebrow || title) && (
      <div class="section-head">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 set:html={title} />}
        {sub && <p class="section-sub">{sub}</p>}
      </div>
    )}
    <div class="sd-dock" data-dock>
      <div class="sd-bar" data-bar>
        <form class="sd-form" role="search" data-search-form onsubmit="return false">
          <label class="sd-search">
            <span class="sr-only">Search {noun}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" name="q" placeholder={placeholder} autocomplete="off" data-q />
          </label>
          {chips.length > 0 && (
            <div class="sd-chips" role="group" aria-label="Filter">
              <button type="button" class="sd-chip" aria-pressed="true" data-chip="">All</button>
              {chips.map((c) => (
                <button type="button" class="sd-chip" aria-pressed="false" data-chip={c.value} style={`--acc:${tintOf(c.value)}`}>{c.label}</button>
              ))}
            </div>
          )}
        </form>
      </div>
    </div>

    <p class="sd-count" data-sd-count aria-live="polite">Showing all {items.length} {noun}</p>
    <ul class="sd-grid" data-results>
      {items.map((it) => (
        <li class="sd-card" data-tag={it.tag ?? ""} data-s-title={norm(it.title)} data-s-keywords={norm(it.keywords)} data-s-text={norm(it.text)} style={`--acc:${tintOf(it.tag)}`}>
          {it.img && <img src={it.img} alt="" loading="lazy" />}
          <div class="sd-body">
            {it.meta && <p class="sd-meta mono">{it.meta}</p>}
            <h3>{it.href ? <a href={it.href}>{it.title}</a> : it.title}</h3>
            {it.text && <p class="sd-text">{it.text}</p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="sd-empty" data-empty hidden>
      <p>No {noun} match <b data-empty-q></b>. Try a different word, or</p>
      <button type="button" class="btn btn-ghost btn-small" data-reset>Show everything</button>
    </div>
  </div>
</section>

<script>
  const FIELD_WEIGHT = { sTitle: 12, sKeywords: 9, sText: 2 } as const;
  const STOP = new Set(["a", "an", "the", "in", "of", "for", "and", "to", "my", "i"]);
  document.querySelectorAll<HTMLElement>("[data-search-dock]").forEach((section) => {
    const synonyms: Record<string, string[]> = JSON.parse(section.dataset.synonyms ?? "{}");
    const noun = section.dataset.noun!;
    const input = section.querySelector<HTMLInputElement>("[data-q]")!;
    const chips = [...section.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const grid = section.querySelector<HTMLElement>("[data-results]")!;
    const cards = [...grid.querySelectorAll<HTMLElement>(".sd-card")];
    const count = section.querySelector<HTMLElement>("[data-sd-count]")!;
    const empty = section.querySelector<HTMLElement>("[data-empty]")!;
    const state = { q: "", tag: "" };

    const normalise = (q: string) => q.toLowerCase().replace(/[’']/g, "").replace(/[^\w&+\- ]+/g, " ").replace(/\s+/g, " ").trim();
    // Split into words, keeping known phrases ("aged care", "cert 3") together.
    const terms = (q: string) => {
      let rest = ` ${normalise(q)} `;
      const out: string[] = [];
      Object.keys(synonyms)
        .filter((k) => k.includes(" "))
        .sort((a, b) => b.length - a.length)
        .forEach((p) => {
          if (rest.includes(` ${p} `)) {
            out.push(p);
            rest = rest.replace(` ${p} `, " ");
          }
        });
      return out.concat(rest.trim().split(" ").filter((t) => t.length > 1 && !STOP.has(t)));
    };
    const score = (card: HTMLElement, q: string) => {
      const ts = terms(q);
      let total = 0;
      for (const t of ts) {
        const variants = [t, ...(synonyms[t] ?? [])];
        let best = 0;
        for (const [field, w] of Object.entries(FIELD_WEIGHT)) {
          const hay = card.dataset[field] ?? "";
          if (variants.some((v) => hay.includes(v))) best = Math.max(best, w);
        }
        if (!best) return 0; // every word must match something
        total += best;
      }
      return total || 1;
    };
    const apply = (write = true) => {
      const q = state.q.trim();
      const scored = cards.map((card, i) => ({ card, i, s: !state.tag || card.dataset.tag === state.tag ? (q ? score(card, q) : 1) : 0 }));
      const shown = scored.filter((x) => x.s > 0);
      const order = q ? [...shown].sort((a, b) => b.s - a.s || a.i - b.i) : shown;
      scored.forEach(({ card, s }) => (card.hidden = !s));
      order.concat(scored.filter((x) => !x.s)).forEach(({ card }) => grid.append(card));
      const active = Boolean(q || state.tag);
      count.textContent = active ? `Showing ${shown.length} of ${cards.length} ${noun}${q && shown.length > 1 ? ", best matches first" : ""}` : `Showing all ${cards.length} ${noun}`;
      empty.hidden = shown.length > 0;
      section.querySelector("[data-empty-q]")!.textContent = q ? `“${q}”` : "that filter";
      if (write) {
        const url = new URL(location.href);
        q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
        state.tag ? url.searchParams.set("tag", state.tag) : url.searchParams.delete("tag");
        history.replaceState(null, "", url);
      }
    };
    const syncChips = () => chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.chip === state.tag)));

    const params = new URLSearchParams(location.search);
    state.q = params.get("q") ?? "";
    state.tag = chips.some((c) => c.dataset.chip === params.get("tag")) ? params.get("tag")! : "";
    input.value = state.q;
    syncChips();
    apply(false);

    let timer = 0;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        state.q = input.value;
        apply();
      }, 120);
    });
    chips.forEach((c) =>
      c.addEventListener("click", () => {
        state.tag = c.dataset.chip!;
        syncChips();
        apply();
      }),
    );
    section.querySelector("[data-reset]")!.addEventListener("click", () => {
      state.q = state.tag = "";
      input.value = "";
      syncChips();
      apply();
      input.focus();
    });

    // Dock the bar under the header while the results are in view.
    const dock = section.querySelector<HTMLElement>("[data-dock]")!;
    const bar = section.querySelector<HTMLElement>("[data-bar]")!;
    const header = document.querySelector<HTMLElement>("[data-header]");
    let stuck = false;
    let ticking = false;
    const headerBottom = () => (header ? Math.max(0, header.getBoundingClientRect().bottom) : 0);
    const update = () => {
      ticking = false;
      const top = headerBottom();
      const should = dock.getBoundingClientRect().top < top && section.getBoundingClientRect().bottom > top + bar.offsetHeight + 80;
      if (should === stuck) return;
      if (should) dock.style.minHeight = `${bar.offsetHeight}px`;
      stuck = should;
      dock.style.setProperty("--dock-top", `${top}px`);
      dock.classList.toggle("is-stuck", stuck);
    };
    addEventListener("scroll", () => ticking || ((ticking = true), requestAnimationFrame(update)), { passive: true });
    addEventListener("resize", update);
    update();
  });
</script>

<style>
  .sd h2 {
    margin-top: 18px;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .sd h2 :global(em) {
    font-family: var(--font-serif);
    font-weight: 400;
  }
  .sd {
    overflow: visible;
  }
  .sd-dock {
    position: relative;
    z-index: 30;
  }
  :global(html:not(.js)) .sd-dock {
    display: none;
  }
  .sd-form {
    display: grid;
    gap: 16px;
    padding: clamp(14px, 1.6vw, 22px);
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    box-shadow:
      0 40px 70px -40px rgba(14, 21, 18, 0.55),
      0 2px 6px rgba(14, 21, 18, 0.06);
  }
  .sd-search {
    position: relative;
    display: block;
  }
  .sd-search svg {
    position: absolute;
    left: 20px;
    top: 50%;
    width: 24px;
    height: 24px;
    color: var(--accent);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .sd-search input {
    width: 100%;
    min-height: 64px;
    padding: 14px 20px 14px 58px;
    border: 2px solid var(--text);
    border-radius: 999px;
    background: var(--bg);
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 500;
    letter-spacing: -0.01em;
    transition:
      box-shadow 0.2s,
      background-color 0.2s;
  }
  .sd-search input::placeholder {
    color: var(--muted);
  }
  .sd-search input:focus {
    outline: none;
    background: var(--surface);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .sd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sd-chip {
    min-height: 40px;
    padding: 6px 15px;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 14.5px;
    font-weight: 550;
    transition:
      background 0.18s,
      border-color 0.18s,
      color 0.18s;
  }
  .sd-chip:hover {
    border-color: var(--acc, var(--text));
  }
  .sd-chip[aria-pressed="true"] {
    border-color: var(--acc, var(--text));
    background: var(--acc, var(--text));
    color: var(--bg);
  }

  /* Docked: a slim glass bar under the header */
  .sd-dock:global(.is-stuck) .sd-bar {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--dock-top, 72px);
    z-index: 45;
    padding-inline: max(var(--gutter), calc((100% - var(--wrap)) / 2));
    background: color-mix(in srgb, #0e1512 72%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    backdrop-filter: blur(18px) saturate(1.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 40px -26px rgba(0, 0, 0, 0.7);
    animation: dock-in 0.25s var(--ease);
  }
  @keyframes dock-in {
    from {
      opacity: 0.4;
      transform: translateY(-12px);
    }
  }
  .sd-dock:global(.is-stuck) .sd-form {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .sd-dock:global(.is-stuck) .sd-search {
    flex: 0 1 380px;
    min-width: 0;
  }
  .sd-dock:global(.is-stuck) .sd-search input {
    min-height: 42px;
    padding: 7px 16px 7px 43px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 15.5px;
  }
  .sd-dock:global(.is-stuck) .sd-search input::placeholder {
    color: rgba(255, 255, 255, 0.72);
  }
  .sd-dock:global(.is-stuck) .sd-search svg {
    left: 15px;
    width: 18px;
    height: 18px;
    color: var(--c2);
  }
  .sd-dock:global(.is-stuck) .sd-chips {
    flex: 1;
    flex-wrap: nowrap;
    min-width: 0;
    overflow-x: auto;
    -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent);
    mask-image: linear-gradient(90deg, #000 92%, transparent);
  }
  .sd-dock:global(.is-stuck) .sd-chip {
    flex: none;
    min-height: 34px;
    padding: 4px 12px;
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 13px;
  }
  .sd-dock:global(.is-stuck) .sd-chip[aria-pressed="true"] {
    border-color: var(--acc, #fff);
    background: var(--acc, #fff);
    color: #0e1512;
  }
  @media (max-width: 760px) {
    .sd-dock:global(.is-stuck) .sd-chips {
      display: none;
    }
    .sd-dock:global(.is-stuck) .sd-search {
      flex: 1;
    }
  }

  /* Results */
  .sd-count {
    margin: 28px 0 16px;
    font-size: 15px;
    color: var(--muted);
  }
  .sd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sd-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-top: 5px solid var(--acc);
    border-radius: 20px;
    background: var(--surface);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .sd-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -26px rgba(14, 21, 18, 0.5);
  }
  .sd-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .sd-body {
    display: grid;
    gap: 6px;
    padding: 18px 20px 22px;
  }
  .sd-meta {
    color: color-mix(in srgb, var(--acc) 70%, var(--text));
  }
  .sd-card h3 {
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .sd-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .sd-card {
    position: relative;
  }
  .sd-text {
    font-size: 15px;
    color: var(--muted);
  }
  .sd-empty {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 28px;
    border: 1.5px dashed var(--line-strong);
    border-radius: 20px;
  }
</style>
