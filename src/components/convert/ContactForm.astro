---
// The enquiry form (Pathwise + Digital Bridge). Sends to the endpoint in
// src/data/site.ts (`form.endpoint`: Formspree, Web3Forms or your own).
// - No endpoint yet: the form shows switched off with a note and your email,
//   so nobody fills it in for nothing.
// - With JavaScript: clear messages under each field, sending in the
//   background, success shown only once the service accepts it, and a failure
//   keeps everything typed. Without JavaScript it posts as a normal form.
// - A hidden field catches simple spam bots.
// "Get in touch" buttons point at #contact.
import { SITE } from "../../data/site";
interface Props {
  eyebrow?: string;
  title?: string;
  sub?: string;
  /** "What happens next", one line per step. */
  next?: string[];
  /** Options for "What is it about?"; leave empty to skip the question. */
  topics?: string[];
  submit?: string;
  endpoint?: string;
  tone?: "light" | "dark";
}
const {
  eyebrow = "GET IN TOUCH",
  title = "Tell us what<br /><span class='muted'>you need.</span>",
  sub = "A few lines is plenty. We reply within one working day.",
  next = ["We read your message and reply within one working day.", "A short call to understand what you need.", "A clear plan and quote, with no obligation."],
  topics = [],
  submit = "Send message",
  endpoint = SITE.form.endpoint,
  tone = "light",
} = Astro.props;
const live = Boolean(endpoint);
const config = { endpoint, extraFields: SITE.form.extraFields ?? {}, email: SITE.email, phone: SITE.phone };
---
<section class:list={["section", "contact", { light: tone === "light" }]} id="contact">
  <div class="wrap contact-grid">
    <div class="contact-intro">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h2 class="h2 reveal" set:html={title} />
      {sub && <p class="section-sub reveal">{sub}</p>}
      {next.length > 0 && (
        <div class="next reveal">
          <p class="mono">WHAT HAPPENS NEXT</p>
          <ol class="next-steps">
            {next.map((n) => <li>{n}</li>)}
          </ol>
        </div>
      )}
      <p class="direct reveal">
        Prefer to talk? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {SITE.phone && <> · <a href={`tel:${SITE.phone.replace(/[^\d+]/g, "")}`}>{SITE.phone}</a></>}
      </p>
    </div>

    <div class="form-card card reveal" data-form-card>
      <form action={live ? endpoint : undefined} method="post" novalidate data-contact-form data-config={JSON.stringify(config)}>
        {!live && (
          <div class="notice" role="note">
            <strong>Online enquiries aren’t open yet.</strong> Please email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> for now.
          </div>
        )}
        <fieldset disabled={!live}>
          <legend class="sr-only">Your enquiry</legend>
          <div class="field" data-field>
            <label for="cf-name">Your name</label>
            <input id="cf-name" name="name" autocomplete="name" required data-msg="Please enter your name." />
            <p class="error" data-error aria-live="polite"></p>
          </div>
          <div class="field" data-field>
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required data-msg="Please enter your email address." />
            <p class="error" data-error aria-live="polite"></p>
          </div>
          <div class="field" data-field>
            <label for="cf-phone">Phone <span class="optional">(optional)</span></label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
            <p class="error" data-error aria-live="polite"></p>
          </div>
          {topics.length > 0 && (
            <div class="field" data-field>
              <label for="cf-topic">What is it about?</label>
              <select id="cf-topic" name="topic">
                <option value="">Choose one (optional)</option>
                {topics.map((t) => <option>{t}</option>)}
              </select>
            </div>
          )}
          <div class="field" data-field>
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="5" required data-msg="Please write a short message."></textarea>
            <p class="error" data-error aria-live="polite"></p>
          </div>
          <div class="trap" aria-hidden="true">
            <label>Leave this empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
          <button type="submit" class="btn btn-light btn-big magnetic" data-submit>{submit} <span aria-hidden="true">→</span></button>
        </fieldset>
        <div class="status" data-status tabindex="-1"></div>
      </form>
    </div>
  </div>
</section>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const cfg = JSON.parse(form.dataset.config!) as { endpoint: string; extraFields: Record<string, string>; email: string; phone: string };
    if (!cfg.endpoint) return;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const controls = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not([name=_gotcha]), textarea")];

    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const v = el.value.trim();
      if (!v) return el.required ? (el.dataset.msg ?? "Please fill this in.") : "";
      if (el.type === "email" && !EMAIL.test(v)) return "Enter an email address like name@example.com.";
      if (el.type === "tel" && !/^\+?\d{8,15}$/.test(v.replace(/[\s()-]/g, ""))) return "Enter a phone number with 8 to 15 digits.";
      return "";
    };
    const show = (el: HTMLInputElement | HTMLTextAreaElement, msg: string) => {
      const slot = el.closest("[data-field]")?.querySelector<HTMLElement>("[data-error]");
      if (slot) slot.textContent = msg;
      msg ? el.setAttribute("aria-invalid", "true") : el.removeAttribute("aria-invalid");
    };
    // Re-check a field once the visitor leaves it, and as they fix it.
    controls.forEach((el) => {
      el.addEventListener("blur", () => el.value && show(el, check(el)));
      el.addEventListener("input", () => el.hasAttribute("aria-invalid") && show(el, check(el)));
    });
    const say = (html: string, tone: "error" | "ok") => {
      status.className = `status ${tone}`;
      status.innerHTML = html;
      status.focus();
    };
    const direct = `Email <a href="mailto:${cfg.email}">${cfg.email}</a>${cfg.phone ? ` or call ${cfg.phone}` : ""}.`;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      let first: HTMLElement | null = null;
      controls.forEach((el) => {
        const msg = check(el);
        show(el, msg);
        if (msg && !first) first = el;
      });
      if (first) return (first as HTMLElement).focus();
      if (form.querySelector<HTMLInputElement>("[name=_gotcha]")?.value) return; // likely a bot
      const data: Record<string, string> = {};
      new FormData(form).forEach((v, k) => {
        if (k !== "_gotcha" && String(v).trim()) data[k] = String(v).trim();
      });
      button.disabled = true;
      button.classList.add("is-loading");
      try {
        const res = await fetch(cfg.endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ ...cfg.extraFields, ...data, _subject: "Website enquiry", page: location.href }),
        });
        // Some services answer 200 with { success: false }, so check the body too.
        let body: { ok?: boolean; success?: boolean } = {};
        try {
          body = await res.clone().json();
        } catch {}
        if (res.ok && body.ok !== false && body.success !== false) {
          const card = form.closest<HTMLElement>("[data-form-card]")!;
          const steps = card.closest("section")!.querySelector(".next-steps")?.outerHTML ?? "";
          const name = (data.name ?? "").split(" ")[0];
          const done = document.createElement("div");
          done.className = "done";
          done.tabIndex = -1;
          done.innerHTML = `<p class="done-icon" aria-hidden="true">✓</p><h3></h3><p>Your message is with us. We’ll be in touch soon.</p>${steps ? `<p class="mono">WHAT HAPPENS NEXT</p>${steps}` : ""}`;
          done.querySelector("h3")!.textContent = `Thanks${name ? `, ${name}` : ""}. That’s on its way.`;
          card.replaceChildren(done);
          done.focus();
        } else say(`<strong>Sorry, your message wasn’t sent.</strong> The form service didn’t accept it (error ${res.status}). Everything you typed is still here. ${direct}`, "error");
      } catch {
        say(`<strong>Sorry, your message wasn’t sent.</strong> We couldn’t reach the form service; please check your connection. Everything you typed is still here. ${direct}`, "error");
      } finally {
        button.disabled = false;
        button.classList.remove("is-loading");
      }
    });
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
  }
  .next {
    margin-top: 36px;
  }
  .next-steps,
  .form-card :global(.next-steps) {
    display: grid;
    gap: 12px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .next-steps li,
  .form-card :global(.next-steps li) {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    align-items: start;
    color: var(--muted);
    counter-increment: step;
  }
  .next-steps li::before,
  .form-card :global(.next-steps li::before) {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text);
    font: 600 13px var(--font-mono);
  }
  .direct {
    margin-top: 32px;
    color: var(--muted);
  }
  .direct a {
    color: var(--text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form-card {
    padding: clamp(24px, 4vw, 40px);
  }
  fieldset {
    display: grid;
    gap: 18px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  fieldset[disabled] {
    opacity: 0.55;
  }
  .field {
    display: grid;
    gap: 7px;
  }
  label {
    font-size: 15px;
    font-weight: 500;
  }
  .optional {
    font-weight: 400;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: 14px;
    background: var(--bg);
    font-size: 16px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--text);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  [aria-invalid="true"] {
    border-color: var(--c3);
  }
  .error {
    min-height: 0;
    font-size: 14px;
    color: color-mix(in srgb, var(--c3) 75%, var(--text));
  }
  .error:empty {
    display: none;
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  button[data-submit] {
    justify-self: start;
    margin-top: 6px;
  }
  button:global(.is-loading) {
    opacity: 0.7;
    cursor: progress;
  }
  .notice {
    margin-bottom: 20px;
    padding: 14px 16px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--c2) 22%, var(--surface));
    font-size: 15px;
  }
  .notice a {
    text-decoration: underline;
  }
  .status:empty {
    display: none;
  }
  .status {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 14px;
    font-size: 15px;
  }
  .status:global(.error) {
    background: color-mix(in srgb, var(--c3) 16%, var(--surface));
  }
  .status :global(a) {
    text-decoration: underline;
  }
  .form-card :global(.done) {
    display: grid;
    gap: 12px;
    outline: none;
  }
  .form-card :global(.done-icon) {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--c4);
    color: #fff;
    font-size: 26px;
    font-weight: 700;
  }
  .form-card :global(.done h3) {
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
