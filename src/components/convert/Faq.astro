---
// FAQ built on <details> (works without JavaScript). Also publishes FAQPage
// structured data so search engines can show the answers (JobGen). From Hind
// Zero Waste: "Expand all / Collapse all", and questions that open one by one
// as they scroll into view (until the visitor opens or closes one themselves).
interface Props {
  eyebrow?: string;
  title?: string;
  sub?: string;
  items: { q: string; a: string; link?: { label: string; href: string } }[];
  tone?: "light" | "dark";
  controls?: boolean;
  /** Open each question as it scrolls into view. */
  openOnScroll?: boolean;
}
const { eyebrow = "PLAIN ANSWERS", title = "Questions,<br /><span class='muted'>answered.</span>", sub, items, tone = "light", controls = true, openOnScroll = true } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<section class:list={["section", { light: tone === "light" }]} id="faq">
  <div class="wrap faq" data-faq data-open-on-scroll={openOnScroll ? "" : undefined}>
    <div>
      <p class="eyebrow reveal">{eyebrow}</p>
      <h2 class="h2 reveal" set:html={title} />
      {sub && <p class="section-sub reveal" set:html={sub} />}
      {controls && (
        <div class="faq-ctrl" data-faq-ctrl>
          <button type="button" data-open>+ Expand all</button>
          <button type="button" data-close>− Collapse all</button>
        </div>
      )}
    </div>
    <div class="faq-items">
      {items.map((f, i) => (
        <details class="reveal" open={i === 0}>
          <summary>{f.q}<span class="icon" aria-hidden="true"></span></summary>
          <div class="answer">
            <p>{f.a}</p>
            {f.link && <a href={f.link.href}>{f.link.label} <span aria-hidden="true">→</span></a>}
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((root) => {
    const items = [...root.querySelectorAll("details")];
    let auto = root.hasAttribute("data-open-on-scroll");
    const ctrl = root.querySelector("[data-faq-ctrl]");
    ctrl?.querySelector("[data-open]")!.addEventListener("click", () => items.forEach((d) => (d.open = true)));
    ctrl?.querySelector("[data-close]")!.addEventListener("click", () => {
      items.forEach((d) => (d.open = false));
      auto = false; // after "Collapse all", stop opening questions on scroll
    });
    items.forEach((d) => d.querySelector("summary")!.addEventListener("click", () => (d.dataset.touched = "")));
    if (!auto) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const d = entry.target.closest("details")!;
          if (auto && !("touched" in d.dataset)) d.open = true;
        }
      },
      { rootMargin: "0px 0px -38% 0px" },
    );
    items.forEach((d) => d.open || io.observe(d.querySelector("summary")!));
  });
</script>

<style>
  .faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
  }
  .faq-ctrl {
    display: flex;
    gap: 8px;
    margin-top: 28px;
  }
  .faq-ctrl button {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: none;
    font-size: 14px;
  }
  .faq-ctrl button:hover {
    background: var(--text);
    color: var(--bg);
  }
  details {
    border-bottom: 1px solid var(--line-strong);
    interpolate-size: allow-keywords;
  }
  /* Answers slide open where the browser supports animating <details> */
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.5s var(--ease),
      content-visibility 0.5s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 6px;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    inset: 6px 0 auto;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[open] .icon::after {
    transform: rotate(0);
  }
  .answer {
    padding-bottom: 24px;
    color: var(--muted);
  }
  .answer a {
    display: inline-block;
    margin-top: 10px;
    color: var(--text);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
