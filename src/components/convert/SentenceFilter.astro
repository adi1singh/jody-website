---
// Inspiration board (2026): a filter that
// reads as a sentence, "Show me [homes ▾] in [Pune ▾]", over a grid of work
// that updates as you change a word. Seen on Pentagram. Real select menus; a
// live count for screen readers. Without JavaScript the sentence is hidden
// and all the work shows.
//
// <SentenceFilter noun="projects" items={[{ title, type, city, year, img }]} types={[...]} cities={[...]} />
interface Item {
  title: string;
  type: string;
  city: string;
  year: string;
  img: { src: string; alt: string };
}
interface Props {
  noun: string;
  items: Item[];
  types: string[];
  cities: string[];
}
const { noun, items, types, cities } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<div class="sf" data-sentence-filter>
  <div class="sf-sentence" role="group" aria-label="Filter the work">
    <span>Show me</span>
    <label class="sr-only" for={`sf-${uid}-type`}>Kind of work</label>
    <span class="sf-select">
      <select id={`sf-${uid}-type`} data-key="type">
        <option value="">all work</option>
        {types.map((t) => <option value={t}>{t.toLowerCase()}</option>)}
      </select>
    </span>
    <span>in</span>
    <label class="sr-only" for={`sf-${uid}-city`}>City</label>
    <span class="sf-select">
      <select id={`sf-${uid}-city`} data-key="city">
        <option value="">every city</option>
        {cities.map((c) => <option value={c}>{c}</option>)}
      </select>
    </span>
  </div>
  <p class="sf-count mono" aria-live="polite" data-count-label>{items.length} {noun}</p>

  <ul class="sf-grid">
    {items.map((it) => (
      <li class="sf-card" data-type={it.type} data-city={it.city}>
        <img src={it.img.src} alt={it.img.alt} loading="lazy" />
        <p class="sf-title">{it.title}</p>
        <p class="sf-meta mono">{it.type} · {it.city} · {it.year}</p>
      </li>
    ))}
  </ul>
  <p class="sf-empty" hidden>
    Nothing like that yet. <button type="button" class="sf-reset">Show everything</button>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-sentence-filter]").forEach((root) => {
    const selects = [...root.querySelectorAll<HTMLSelectElement>("select")];
    const cards = [...root.querySelectorAll<HTMLElement>(".sf-card")];
    const count = root.querySelector<HTMLElement>("[data-count-label]")!;
    const empty = root.querySelector<HTMLElement>(".sf-empty")!;
    const noun = count.textContent!.replace(/^\d+\s*/, "");
    // Each select sizes itself to the word chosen, so the sentence stays tight.
    const measure = document.createElement("span");
    measure.className = "sf-measure";
    root.append(measure);
    const fit = (s: HTMLSelectElement) => {
      measure.textContent = s.options[s.selectedIndex].text;
      s.style.width = measure.offsetWidth + 44 + "px";
    };
    const apply = () => {
      const want = Object.fromEntries(selects.map((s) => [s.dataset.key!, s.value]));
      let shown = 0;
      cards.forEach((c) => {
        const ok = (!want.type || c.dataset.type === want.type) && (!want.city || c.dataset.city === want.city);
        c.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = `${shown} ${noun}`;
      empty.hidden = shown > 0;
      selects.forEach(fit);
    };
    selects.forEach((s) => s.addEventListener("change", apply));
    root.querySelector(".sf-reset")!.addEventListener("click", () => {
      selects.forEach((s) => (s.value = ""));
      apply();
      selects[0].focus();
    });
    document.fonts?.ready.then(() => selects.forEach(fit));
    apply();
  });
</script>

<style>
  .sf {
    display: grid;
    gap: 18px;
  }
  .sf-sentence {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.3em;
    font-size: clamp(30px, 4.6vw, 64px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  :global(html:not(.js)) .sf-sentence {
    display: none;
  }
  .sf-select {
    position: relative;
    display: inline-block;
  }
  .sf-select::after {
    content: "";
    position: absolute;
    right: 8px;
    top: 50%;
    width: 0.32em;
    height: 0.32em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
    color: var(--accent);
  }
  .sf-select select {
    appearance: none;
    max-width: 100%;
    padding: 0 40px 0.04em 0;
    border: 0;
    border-bottom: 2px solid var(--accent);
    background: transparent;
    color: var(--accent);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .sf-select select option {
    color: initial;
    font-size: 16px;
  }
  .sf :global(.sf-measure) {
    position: absolute;
    visibility: hidden;
    white-space: nowrap;
    font-size: clamp(30px, 4.6vw, 64px);
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .sf-count {
    color: var(--muted);
  }
  .sf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .sf-card {
    display: grid;
    gap: 6px;
    animation: sf-in 0.5s var(--ease) both;
  }
  .sf-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 6px;
  }
  .sf-title {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sf-meta {
    font-size: 11px;
    color: var(--muted);
  }
  .sf-empty {
    color: var(--muted);
  }
  .sf-reset {
    padding: 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: none;
    color: var(--text);
  }
  @keyframes sf-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
