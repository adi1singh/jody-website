---
// Chapter I, "The story you've been telling". One cinematic screen: horses
// grazing under trees as sunbeams break through the mist, darkened on the
// left for the words. The headline turns from the old story to the new, three
// of the sentences clients carry around sit beneath it in italic, and the
// turn ("they can be unlearned") closes the chapter in gold.
// Content: STORY, PROBLEMS, CHAPTERS.story, PHOTOS.story (src/data/jody.ts).
import ChapterMark from "./ChapterMark.astro";
import Photo from "./Photo.astro";
import { CHAPTERS, PHOTOS, PROBLEMS, STORY } from "../../data/jody";
---
<section class="dark story-ch" id="story" aria-labelledby="story-title">
  <div class="bg">
    <Photo photo={PHOTOS.story} ratio="auto" sizes="100vw" />
  </div>
  <div class="wrap inner">
    <ChapterMark chapter={CHAPTERS.story} />
    <h2 id="story-title" class="h2 turn reveal">{STORY.title[0]}<em>{STORY.title[1]}</em></h2>
    <ul class="said" aria-label="What clients often say" data-reveal-group>
      {PROBLEMS.slice(0, 3).map((p) => <li class="reveal">“{p}”</li>)}
    </ul>
    <p class="turn-line reveal">{STORY.turn}</p>
  </div>
</section>

<style>
  .story-ch > .bg, .exp > .bg {
    z-index: 0;
  }
  .inner > :global(*:not(.chapter)) {
    position: relative;
    z-index: 1;
  }
  .story-ch {
    position: relative;
    min-height: max(640px, min(100svh, 940px));
    display: grid;
    align-items: center;
    overflow: clip;
  }
  .bg {
    position: absolute;
    inset: 0;
  }
  .bg :global(.photo) {
    position: absolute;
    inset: 0;
  }
  /* Darken the left for the words; the light stays on the right */
  .bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(23, 21, 20, 0.92) 0%, rgba(23, 21, 20, 0.78) 34%, rgba(23, 21, 20, 0.15) 70%, rgba(23, 21, 20, 0) 100%),
      linear-gradient(to bottom, var(--black) 0%, rgba(23, 21, 20, 0) 16%);
  }
  .inner {
    /* static, so the chapter seal positions against the section (see ChapterMark) */
    position: static;
    padding-block: clamp(96px, 11vw, 150px);
  }
  .h2 {
    max-width: 13ch;
  }
  .said {
    margin: clamp(32px, 4vw, 52px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    max-width: 30ch;
  }
  .said li {
    font: italic 300 clamp(22px, 2.1vw, 30px) / 1.3 var(--font-display);
    color: color-mix(in srgb, var(--ivory) 72%, transparent);
  }
  .turn-line {
    margin-top: clamp(28px, 3.4vw, 44px);
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    max-width: 30ch;
    font: 400 clamp(19px, 1.5vw, 22px) / 1.45 var(--font-sans);
    color: var(--gold);
  }
  @media (max-width: 760px) {
    .story-ch {
      min-height: 0;
      align-items: end;
    }
    .bg {
      inset: 0 0 auto;
      height: 62%;
    }
    .bg::after {
      background: linear-gradient(to bottom, var(--black) 0%, rgba(23, 21, 20, 0.2) 22%, rgba(23, 21, 20, 0.35) 60%, var(--black) 100%);
    }
    .inner {
      padding-top: 46vh;
      padding-bottom: 72px;
    }
  }
</style>
