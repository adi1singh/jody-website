---
// Every photograph on Jody's site goes through this part, so real photos drop
// in later without touching any layout.
// - With `src`: a responsive <img> cropped to `ratio` with object-fit, focused
//   on `focus` (object-position), lazy unless `eager`.
// - Without `src`: a clearly labelled placeholder of the same shape, saying
//   what photograph belongs there ("Photo to come"), never a stock image.
// - `reveal`: the photo wipes open as it scrolls in (still with reduced
//   motion and without JavaScript).
// Photo slots are listed in src/data/jody.ts (PHOTOS), so the shoot list lives
// in one place.
//
// <Photo photo={PHOTOS.hypnosis} ratio="4/5" reveal />
// <Photo src="/x.jpg" alt="..." ratio="16/9" focus="30% 20%" />
import type { PhotoSlot } from "../../data/jody";
interface Props {
  photo?: PhotoSlot;
  src?: string;
  alt?: string;
  /** What should be in the picture, shown on the placeholder. */
  brief?: string;
  /** CSS aspect-ratio, e.g. "4/5". Use "auto" to fill the parent's height instead. */
  ratio?: string;
  /** object-position, e.g. "30% 20%" to keep a face in frame. */
  focus?: string;
  eager?: boolean;
  reveal?: boolean;
  class?: string;
  /** Sizes hint for the browser. */
  sizes?: string;
}
const p = Astro.props;
const src = p.src ?? p.photo?.src;
const alt = p.alt ?? p.photo?.alt ?? "";
const brief = p.brief ?? p.photo?.brief ?? "";
const focus = p.focus ?? p.photo?.focus ?? "50% 50%";
const ratio = p.ratio ?? p.photo?.ratio ?? "4/5";
const fill = ratio === "auto";
---
<figure
  class:list={["photo", p.class, { "reveal-image": p.reveal, "is-fill": fill, "is-placeholder": !src }]}
  style={fill ? undefined : `aspect-ratio:${ratio}`}
>
  {src ? (
    <img src={src} alt={alt} loading={p.eager ? "eager" : "lazy"} decoding="async" fetchpriority={p.eager ? "high" : undefined} sizes={p.sizes} style={`object-position:${focus}`} />
  ) : (
    <div class="ph" role="img" aria-label={`Photo to come: ${brief}`}>
      <span class="ph-tag">Photo to come</span>
      <span class="ph-brief">{brief}</span>
      {!fill && <span class="ph-ratio" aria-hidden="true">{ratio.replace("/", " : ")}</span>}
    </div>
  )}
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--surface-2);
    width: 100%;
  }
  .photo.is-fill {
    height: 100%;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease);
  }
  /* Placeholder: quiet stone with a fine frame and the shot description */
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 24px;
    text-align: center;
    background:
      linear-gradient(135deg, transparent 49.85%, color-mix(in srgb, var(--text) 9%, transparent) 50%, transparent 50.15%),
      linear-gradient(45deg, transparent 49.85%, color-mix(in srgb, var(--text) 9%, transparent) 50%, transparent 50.15%),
      color-mix(in srgb, var(--text) 7%, var(--bg));
    outline: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    outline-offset: -14px;
    color: var(--muted);
  }
  .ph-tag {
    padding: 6px 12px;
    border-radius: var(--pill);
    background: var(--bg);
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
  }
  .ph-brief {
    max-width: 30ch;
    font: italic 400 clamp(16px, 1.4vw, 20px) / 1.3 var(--font-display);
    color: var(--text);
  }
  .ph-ratio {
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 0.18em;
    color: var(--faint);
  }
  /* A slow, small push-in on hover where the photo is a link */
  :global(a:hover) > .photo img,
  :global(a:focus-visible) > .photo img {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
