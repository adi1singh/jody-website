---
// Podcast and speaking (#podcast): Jody's media, laid out like a magazine
// feature after the burgundy book launch.
// - Podcast: a tall studio portrait (PHOTOS.podcast) beside the title, the
//   status ("In production"), the format, and an honest list of episode
//   previews. While PODCAST.episodes is empty the list shows the planned
//   format only ("Episode 01 · Chapter one · Planned"): no guests or titles
//   are invented. Once episodes are published they are listed with a link.
// - Speaking: a wide stage photo (PHOTOS.speaking) with SPEAKING's words and
//   a link to the contact form.
// Nothing here loads a player or feed; links only.
//
// <Podcast />
import { PODCAST, SPEAKING, PHOTOS } from "../../data/jody";
import Photo from "./Photo.astro";
const pad = (n: number) => String(n).padStart(2, "0");
const published = PODCAST.episodes.length > 0;
const titleWords = PODCAST.title.split(" ");
const titleEnd = titleWords.pop();
---
<section id="podcast" class="section podcast" aria-labelledby="podcast-title">
  <div class="wrap feature">
    <div class="image">
      <Photo photo={PHOTOS.podcast} ratio="4/5" reveal />
    </div>

    <div class="text" data-reveal-group>
      <p class="eyebrow reveal">The podcast</p>
      <h2 id="podcast-title" class="h2 reveal">{titleWords.join(" ")} <em>{titleEnd}</em></h2>
      <p class="status reveal"><span class="dot" aria-hidden="true"></span>{published ? "Out now" : PODCAST.status}</p>
      <p class="lead reveal">{PODCAST.text}</p>

      <div class="episodes reveal">
        <div class="ep-head">
          <p class="mono">{published ? "Episodes" : "Episode previews"}</p>
          {!published && <p class="preview-note">Planned format · not yet recorded</p>}
        </div>
        <ol>
          {published
            ? PODCAST.episodes.map((ep, i) => (
                <li>
                  <a class="ep" href={ep.href}>
                    <span class="ep-num">{pad(i + 1)}</span>
                    <span class="ep-main">
                      <span class="ep-title">{ep.title}</span>
                      <span class="ep-sub">with {ep.guest}</span>
                    </span>
                    <span class="ep-state">Listen <span aria-hidden="true">→</span></span>
                  </a>
                </li>
              ))
            : PODCAST.planned.map((chapter, i) => (
                <li class="ep">
                  <span class="ep-num">{pad(i + 1)}</span>
                  <span class="ep-main">
                    <span class="ep-sub">Episode {pad(i + 1)}</span>
                    <span class="ep-title">{chapter}</span>
                  </span>
                  <span class="ep-state is-planned">Planned</span>
                </li>
              ))}
        </ol>
      </div>
    </div>
  </div>

  <div class="wrap speaking">
    <div class="sp-text" data-reveal-group>
      <p class="eyebrow reveal">On stage</p>
      <h3 id="speaking-title" class="h2 reveal">{SPEAKING.title}<span class="dotted" aria-hidden="true">.</span></h3>
      <p class="read reveal">{SPEAKING.text}</p>
      <p class="reveal"><a class="btn btn-primary" href={SPEAKING.cta.href}>{SPEAKING.cta.label}</a></p>
    </div>
    <div class="sp-image">
      <Photo photo={PHOTOS.speaking} ratio="3/2" reveal />
    </div>
  </div>
</section>

<style>
  /* Podcast feature: tall image left, editorial column right */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
  }
  .text {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .text > * {
    margin: 0;
  }
  .text h2 {
    margin-top: 2px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    font: 600 var(--label) / 1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--burgundy);
  }
  .text .lead {
    max-width: 30ch;
  }

  .episodes {
    width: 100%;
    margin-top: clamp(8px, 2vw, 24px);
  }
  .ep-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-strong);
  }
  .ep-head p {
    margin: 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ep {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }
  a.ep {
    transition: padding 0.5s var(--ease);
  }
  a.ep:hover {
    padding-left: 8px;
  }
  .ep-num {
    font: 300 clamp(30px, 2.6vw, 40px) / 1 var(--font-display);
    color: var(--accent);
    font-variant-numeric: lining-nums;
  }
  .ep-main {
    display: grid;
    gap: 4px;
  }
  .ep-title {
    font: 400 clamp(21px, 1.8vw, 26px) / 1.15 var(--font-display);
  }
  .ep-sub {
    font: 600 10.5px/1.3 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ep-state {
    font: 600 10.5px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
  }
  .ep-state.is-planned {
    color: var(--muted);
    padding: 7px 12px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--pill);
  }

  /* Speaking: text left, wide photo right, after a hairline */
  .speaking {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: end;
    margin-top: var(--section);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .sp-text {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .sp-text > * {
    margin: 0;
  }
  .sp-text .read {
    max-width: 40ch;
  }
  .sp-text .btn {
    margin-top: 10px;
  }
  .dotted {
    color: var(--detail);
  }

  @media (max-width: 860px) {
    .feature,
    .speaking {
      grid-template-columns: 1fr;
    }
    .feature {
      gap: 40px;
    }
    .image {
      margin-inline: calc(var(--gutter) * -1);
    }
    .speaking {
      gap: 36px;
    }
    .sp-image {
      order: -1;
    }
  }
  @media (max-width: 560px) {
    .ep {
      grid-template-columns: 44px 1fr auto;
      gap: 12px;
      padding: 18px 0;
    }
    .sp-text .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
