---
// About Jody, after dawnsaunders.com's full-bleed photo band ("Thirty-four
// years teaching… Then one unexpected second act."): the branding photo as a
// big rounded card, a two-tone headline (ivory, then gold) laid over its lower
// right so it stays clear of Jody's face, then a short first-person intro,
// the credentials as quiet pills and a "Book a session" button.
// Content: PHOTOS.portrait, HERO, CREDENTIALS from src/data/jody.ts.
// The photo is 923px wide, so the card stops at 1200px to stay sharp.
// Usage: <About /> (id="about"). Works without JavaScript.
import { PHOTOS, HERO, CREDENTIALS, BOOK_HREF } from "../../data/jody";
import { SITE } from "../../data/site";
const book = SITE.booking || BOOK_HREF;
const p = PHOTOS.portrait;
---
<section class="about section" id="about" aria-labelledby="about-title">
  <figure class="band reveal">
    <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
    <figcaption>
      <p class="eyebrow">About Jody</p>
      <h2 id="about-title" class="band-title">
        Hypnotherapist. Life coach. Horse lover.
        <span class="gold-line">And now, the next chapter<span class="stop">.</span></span>
      </h2>
    </figcaption>
  </figure>

  <div class="wrap intro" data-reveal-group>
    <p class="read reveal">{HERO.intro}</p>
    <div class="side reveal">
      <ul class="pills" aria-label="Credentials">
        {CREDENTIALS.map((c) => <li>{c}</li>)}
      </ul>
      <a class="btn btn-accent magnetic" href={book}>Book a session <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: clamp(16px, 2vw, 24px);
  }
  .band {
    position: relative;
    width: min(1200px, calc(100% - 2 * clamp(10px, 1.4vw, 20px)));
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface);
    isolation: isolate;
  }
  .band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 28%;
    z-index: -2;
  }
  /* Darken the right and bottom, where the words sit; Jody's face stays bright. */
  .band::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, color-mix(in srgb, var(--ink) 88%, transparent) 0%, color-mix(in srgb, var(--ink) 40%, transparent) 38%, transparent 62%),
      linear-gradient(to right, transparent 40%, color-mix(in srgb, var(--ink) 55%, transparent) 100%);
  }
  figcaption {
    position: absolute;
    right: clamp(24px, 4.5vw, 64px);
    bottom: clamp(24px, 4.5vw, 60px);
    max-width: min(640px, 58%);
    color: var(--ivory);
    text-align: left;
  }
  .band-title {
    margin-top: 16px;
    font-size: clamp(30px, 4.4vw, 60px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .gold-line {
    display: block;
    color: var(--gold);
  }
  .stop {
    color: var(--ivory);
  }
  .intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
    margin-top: clamp(48px, 6vw, 84px);
    max-width: 1100px;
  }
  .intro .read {
    font-size: clamp(21px, 2vw, 27px);
    line-height: 1.45;
    color: var(--text);
  }
  .side {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pills li {
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14px;
    color: var(--muted);
    letter-spacing: 0.01em;
  }
  /* Phones: the photo on its own, the words under it, so nothing covers Jody. */
  @media (max-width: 760px) {
    .band {
      aspect-ratio: auto;
      background: var(--surface);
    }
    .band img {
      position: relative;
      aspect-ratio: 1;
      height: auto;
      object-position: 24% 20%;
    }
    .band::after {
      display: none;
    }
    figcaption {
      position: static;
      max-width: none;
      padding: 24px 22px 28px;
    }
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>
