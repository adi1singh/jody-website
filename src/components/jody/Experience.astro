---
// Chapter III, "How the story changes": the hypnosis session in one dark,
// cinematic screen. Horses grazing in golden light fill the right side; on
// the left, the headline turns, then the three steps (90-minute whole-life
// analysis, your recording, 21 nights) with twenty-one gold marks, then the
// prices in one quiet line and the booking button. The care note is small.
// Content: EXPERIENCE, PRICES, TERMS, PHOTOS.experience (src/data/jody.ts).
import ChapterMark from "./ChapterMark.astro";
import Photo from "./Photo.astro";
import { BOOK_HREF, CHAPTERS, EXPERIENCE, PHOTOS, PRICES, TERMS } from "../../data/jody";
import { SITE } from "../../data/site";
const book = SITE.booking || BOOK_HREF;
---
<section id="experience" class="dark exp" aria-labelledby="experience-title">
  <div class="media">
    <Photo photo={PHOTOS.experience} ratio="auto" sizes="(max-width: 900px) 100vw, 46vw" />
  </div>

  <div class="wrap inner">
    <div class="copy">
      <ChapterMark chapter={CHAPTERS.change} />
      <h2 id="experience-title" class="h2 turn reveal">{EXPERIENCE.title[0]}<em>{EXPERIENCE.title[1]}</em></h2>
      <p class="intro reveal">{EXPERIENCE.intro}</p>

      <ol class="steps" data-reveal-group>
        {EXPERIENCE.steps.map((s, i) => (
          <li class="step reveal">
            <span class="num" aria-hidden="true">{s.number}</span>
            <div>
              <h3>{s.title} <span class="time">{s.time}</span></h3>
              <p>{s.text}</p>
              {i === 2 && (
                <p class="nights" role="img" aria-label="Twenty-one nights">
                  {Array.from({ length: 21 }, (_, n) => <span style={`--n:${n}`}></span>)}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>

      <div class="prices reveal">
        <dl>
          {PRICES.map((p) => (
            <div><dt>{p.name}</dt><dd>{p.price}</dd></div>
          ))}
        </dl>
        <p class="terms">{TERMS.join(". ")}.</p>
        <a class="btn btn-primary" href={book}>Book a session</a>
        <p class="care">{EXPERIENCE.care.replace("13 11 14", "13 11 14")}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .story-ch > .media, .exp > .media {
    z-index: 0;
  }
  .inner > :global(*:not(.chapter):not(.copy)),
  .copy > :global(*:not(.chapter)) {
    position: relative;
    z-index: 1;
  }
  .exp {
    position: relative;
    overflow: clip;
  }
  .media {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 46%;
  }
  .media :global(.photo) {
    position: absolute;
    inset: 0;
  }
  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--black) 0%, rgba(23, 21, 20, 0) 30%);
  }
  .inner {
    /* static, so the chapter seal positions against the section (see ChapterMark) */
    position: static;
    padding-block: var(--section);
  }
  .copy {
    max-width: 640px;
  }
  .intro {
    margin-top: 20px;
    max-width: 44ch;
    color: var(--muted);
  }
  .steps {
    list-style: none;
    margin: clamp(36px, 4vw, 52px) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .num {
    font: italic 300 40px/1 var(--font-display);
    color: var(--gold);
  }
  h3 {
    font: 400 clamp(23px, 2vw, 28px) / 1.2 var(--font-display);
  }
  .time {
    margin-left: 10px;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.04em;
    color: var(--gold);
    white-space: nowrap;
  }
  .step p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 16px;
    max-width: 46ch;
  }
  .nights {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px !important;
  }
  .nights span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: var(--gold);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .step:not(.in) .nights span {
      background: transparent;
    }
    .nights span {
      transition: background 0.3s calc(var(--n) * 70ms + 400ms);
    }
  }
  .prices {
    margin-top: clamp(28px, 3vw, 40px);
    padding-top: 26px;
    border-top: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin: 0;
  }
  dt {
    font: 600 12px/1.3 var(--font-sans);
    letter-spacing: 0.03em;
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
    font: 400 30px/1 var(--font-display);
    color: var(--ivory);
  }
  .terms {
    margin: 18px 0 26px;
    font-size: 14px;
    color: var(--muted);
  }
  .care {
    margin-top: 22px;
    max-width: 60ch;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--faint);
  }
  @media (max-width: 900px) {
    .media {
      position: relative;
      width: 100%;
      height: 56vw;
      min-height: 260px;
    }
    .media::after {
      background: linear-gradient(to bottom, rgba(23, 21, 20, 0) 50%, var(--black) 100%);
    }
    .inner {
      padding-top: 24px;
    }
  }
</style>
