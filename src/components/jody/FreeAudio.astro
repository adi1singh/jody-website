---
// Jody's free audio (id="free"): lead capture as a calm night-time moment.
// After dawnsaunders.com's sun circles and black FAQ: a black section, a soft
// gold moon rising behind the four free hypnosis audios set as a track list,
// and an email sign-up that sends to the CRM (Signup list="free-audio").
// None of the audios is recorded yet, so each shows "Recording now" (no fake
// players or lengths); set `ready: true` in AUDIOS and it says "Ready".
// The planned membership (MEMBERSHIP) sits quietly under the list.
// No JavaScript needed; the moon only drifts in when motion is allowed.
//
// <FreeAudio />   (hidden when AUDIOS is empty)
import Signup from "../convert/Signup.astro";
import { AUDIOS, MEMBERSHIP } from "../../data/jody";
const pad = (n: number) => String(n + 1).padStart(2, "0");
---
{AUDIOS.length > 0 && (
  <section class="section free" id="free" aria-labelledby="free-title">
    <div class="moon" aria-hidden="true"><span class="halo"></span></div>

    <div class="wrap grid-free">
      <div class="lead reveal">
        <p class="eyebrow">Free hypnosis audio</p>
        <h2 id="free-title" class="h2">Start <em>tonight</em><span class="dot">.</span></h2>
        <p class="read sub">
          Short hypnosis audios to fall asleep to. I’m recording them now: leave your email and they’ll come to you first.
        </p>
        <div class="form">
          <Signup
            list="free-audio"
            submit="Send me the audios"
            choices={AUDIOS.map((a) => a.title)}
            choicesLabel="Which would you like?"
            done="You’re on the list. Each audio comes to your inbox as soon as it’s recorded."
            note="Free. No spam. Unsubscribe any time."
          />
        </div>
      </div>

      <div class="tracks reveal">
        <p class="tracks-head">
          <span class="eyebrow">{AUDIOS.length} audios</span>
          <span class="tracks-for">to listen to in bed</span>
        </p>
        <ol class="list" data-reveal-group>
          {AUDIOS.map((a, i) => (
            <li class="track">
              <span class="num" aria-hidden="true">{pad(i)}</span>
              <span class="body">
                <span class="title">{a.title}</span>
                <span class="text">{a.text}</span>
              </span>
              <span class:list={["state", { ready: a.ready }]}>
                <span class="pulse" aria-hidden="true"></span>
                {a.ready ? "Ready" : "Recording now"}
              </span>
            </li>
          ))}
        </ol>
        {MEMBERSHIP && (
          <p class="member">
            <span class="member-tag">Membership · {MEMBERSHIP.price} {MEMBERSHIP.per}</span>
            <span class="member-text">{MEMBERSHIP.text}</span>
          </p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .free {
    background: var(--ink);
    overflow: clip;
    isolation: isolate;
  }

  /* The moon: a soft gold disc, half risen at the top right */
  .moon {
    position: absolute;
    z-index: -1;
    top: clamp(-260px, -14vw, -120px);
    right: clamp(-220px, -8vw, -60px);
    width: clamp(420px, 46vw, 700px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(60% 60% at 38% 34%, color-mix(in srgb, var(--gold-soft) 85%, white), transparent 72%),
      linear-gradient(200deg, var(--gold-soft) 0%, var(--gold) 45%, var(--gold-deep) 100%);
    box-shadow:
      0 0 120px 10px color-mix(in srgb, var(--gold) 28%, transparent),
      0 0 360px 60px color-mix(in srgb, var(--gold) 10%, transparent);
    opacity: 0.92;
  }
  .halo {
    position: absolute;
    inset: -7%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent);
  }
  .halo::after {
    content: "";
    position: absolute;
    inset: -9%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--gold) 14%, transparent);
  }

  .grid-free {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }
  .lead {
    padding-top: clamp(20px, 6vw, 90px);
  }
  .h2 {
    margin-top: 20px;
    font-size: clamp(56px, 8.4vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .h2 em {
    padding-right: 0.04em;
    background: var(--gold-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    margin-top: 28px;
    max-width: 30ch;
    color: var(--muted);
  }
  .form {
    margin-top: clamp(36px, 4vw, 52px);
    max-width: 520px;
  }

  /* The track list, on frosted glass over the moon */
  .tracks {
    margin-top: clamp(160px, 17vw, 260px);
    padding: clamp(26px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(1.1);
    backdrop-filter: blur(24px) saturate(1.1);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
  }
  .tracks-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 18px;
  }
  .tracks-for {
    font: italic 400 19px/1 var(--font-serif);
    color: var(--muted);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .track {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .num {
    font: 500 13px/1 var(--font-sans);
    letter-spacing: 0.12em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .body {
    display: grid;
    gap: 6px;
  }
  .title {
    font: 300 clamp(24px, 2.2vw, 32px) / 1.05 var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .text {
    font: 400 17px/1.4 var(--font-read);
    color: var(--muted);
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font: 600 10.5px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
    white-space: nowrap;
  }
  .state.ready {
    border-color: var(--gold);
    color: var(--gold);
  }
  .pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .member {
    display: grid;
    gap: 6px;
    margin-top: 6px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .member-tag {
    font: 600 11px/1.4 var(--font-sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .member-text {
    font: 400 16px/1.45 var(--font-read);
    color: var(--faint);
  }

  /* Motion: the moon rises a little as the section arrives; the dots breathe */
  @media (prefers-reduced-motion: no-preference) {
    .state:not(.ready) .pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--gold);
      animation: breathe 2.6s var(--ease-out) infinite;
    }
    @supports (animation-timeline: view()) {
      .moon {
        animation-name: rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
    }
  }
  @keyframes breathe {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(18%) scale(0.92);
      opacity: 0.4;
    }
  }

  @media (max-width: 960px) {
    .grid-free {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .lead {
      padding-top: clamp(120px, 34vw, 240px);
    }
    .tracks {
      margin-top: 0;
    }
    .moon {
      top: clamp(-200px, -30vw, -100px);
      right: clamp(-160px, -22vw, -60px);
      width: clamp(300px, 78vw, 520px);
    }
  }
  @media (max-width: 560px) {
    .track {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 4px 12px;
      align-items: start;
    }
    .num {
      padding-top: 8px;
    }
    .state {
      grid-column: 2;
      justify-self: start;
      margin-top: 10px;
    }
    .tracks-head {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
