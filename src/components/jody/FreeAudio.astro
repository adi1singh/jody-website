---
// Free hypnosis audio (#free). A night-time moment on black: the offer set
// like an album's track list, so four short recordings feel like something
// worth having, not a freebie. After Marisa Peer's free-audio offer and an
// editorial record sleeve: big serif headline, one short paragraph, a
// numbered track list in serif with thin rules and gold numerals, a small
// "being recorded" status, and ONE action: the email sign-up.
// Interface only: nothing is connected. Signup shows "Preview · sign-ups open
// soon" until SITE.form.endpoint is set. No durations or links are shown,
// because none exist yet (never invent them).
// Words: FREE_AUDIO and AUDIOS in src/data/jody.ts.
//
// <FreeAudio />
import Signup from "../convert/Signup.astro";
import { AUDIOS, FREE_AUDIO } from "../../data/jody";
const [first, ...rest] = FREE_AUDIO.title.split(" ");
---
<section class="free section dark" id="free" aria-labelledby="free-title">
  <div class="wrap grid">
    <div class="intro">
      <p class="eyebrow reveal">{FREE_AUDIO.eyebrow}</p>
      <h2 id="free-title" class="h2 reveal">{first} <em>{rest.join(" ")}</em></h2>
      <p class="read reveal">{FREE_AUDIO.text}</p>
    </div>

    <div class="tracks" aria-labelledby="tracks-title">
      <div class="tracks-head reveal">
        <p id="tracks-title" class="mono">{AUDIOS.length} recordings</p>
        <p class="status"><span class="dot" aria-hidden="true"></span>{FREE_AUDIO.status}</p>
      </div>
      <ol class="list" data-reveal-group>
        {AUDIOS.map((a, i) => (
          <li class="track reveal">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="title">{a.title}</span>
            <span class="text">{a.text}</span>
          </li>
        ))}
      </ol>
      <p class="foot reveal">Recorded by Jody. Listen as you fall asleep.</p>
    </div>

    <div class="form reveal">
        <Signup list="free-audio" submit="Send me the audio" done="You’re on the list. The recordings will come to your inbox." note="Free. No spam, unsubscribe any time." />
    </div>
  </div>
</section>

<style>
  .free {
    position: relative;
    overflow: clip;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 44px clamp(56px, 8vw, 140px);
    grid-template-rows: auto 1fr;
    align-items: start;
  }
  .intro {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    justify-items: start;
    gap: 28px;
  }
  .tracks {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .h2 {
    margin: 0;
    font-size: clamp(50px, 5.6vw, 88px);
    line-height: 0.95;
  }
  .read {
    max-width: 40ch;
    margin: 0;
  }
  .form {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    max-width: 520px;
    margin-top: 18px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  /* The track list */
  .tracks {
    padding-top: clamp(0px, 1vw, 12px);
  }
  .tracks-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-strong);
  }
  .tracks-head .mono {
    margin: 0;
    color: var(--muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font: 600 var(--label) / 1.4 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--detail);
  }
  .dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--detail);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .track {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 12em);
    align-items: baseline;
    gap: 8px 24px;
    padding: clamp(14px, 1.5vw, 20px) 0;
    border-bottom: 1px solid var(--line);
  }
  .num {
    font: 300 22px/1 var(--font-display);
    font-variant-numeric: lining-nums;
    color: var(--detail);
  }
  .title {
    font: 300 clamp(28px, 2.6vw, 40px) / 1 var(--font-display);
    letter-spacing: -0.015em;
    transition: transform 0.6s var(--ease);
  }
  .text {
    font: 400 15px/1.55 var(--font-sans);
    color: var(--muted);
  }
  .track:hover .title {
    transform: translateX(8px);
  }
  .foot {
    margin: 22px 0 0;
    font: italic 400 20px/1.4 var(--font-display);
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      content: "";
      position: absolute;
      inset: -5px;
      border: 1px solid var(--detail);
      border-radius: 50%;
      animation: breathe 2.8s var(--ease-in-out) infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .title {
      transition: none;
    }
  }
  @keyframes breathe {
    0% {
      opacity: 0.9;
      transform: scale(0.6);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 56px;
    }
    /* One column: the words, the track list, then the sign-up */
    .intro,
    .tracks,
    .form {
      grid-column: 1;
      grid-row: auto;
    }
    .form {
      margin-top: 0;
    }
  }
  @media (max-width: 600px) {
    .h2 {
      font-size: clamp(54px, 15vw, 72px);
    }
    .track {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 6px 14px;
      padding: 22px 0;
    }
    .num {
      font-size: 18px;
    }
    .title {
      font-size: 34px;
    }
    .text {
      grid-column: 2;
      font-size: 14.5px;
    }
  }
</style>
