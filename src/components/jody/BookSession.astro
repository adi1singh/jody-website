---
// Book a session, after dawnsaunders.com's split "Invite me to your school…"
// block: a big gold rounded card (heading, the terms, the request form) beside
// a tall rounded photo card of Jody. Every "Book" button points here (#contact).
// - SITE.booking (a calendar link) set: a "Pick a time in my calendar" button
//   shows above the form.
// - The form sends to SITE.form.endpoint. Not set yet: it shows switched off
//   with a note and Jody's email, so nobody fills it in for nothing.
// - With JavaScript: messages under each field, sends in the background and
//   confirms only once the service accepts; a failure keeps what was typed.
//   Without JavaScript it posts as a normal form. A hidden field traps bots.
// Same behaviour as src/components/convert/ContactForm.astro, built here so
// it fits the card and there's only one #contact on the page.
// Usage: <BookSession />. Content: TERMS, PHOTOS from src/data/jody.ts.
import { TERMS, PHOTOS } from "../../data/jody";
import { SITE } from "../../data/site";
const endpoint = SITE.form.endpoint;
const live = Boolean(endpoint);
const topics = ["Hypnosis", "Quit smoking or vaping", "Weight (mental gastric bypass)", "Life coaching", "Equestrian mindset coaching", "Speaking or podcast", "Something else"];
const config = { endpoint, extraFields: SITE.form.extraFields ?? {}, email: SITE.email };
const p = PHOTOS.portrait;
---
<section class="book-session" id="contact" aria-labelledby="bs-title">
  <div class="split">
    <div class="card-gold gold reveal" data-bs-card>
      <p class="eyebrow">Book a session</p>
      <h2 id="bs-title" class="title">Let’s find <br />your time<span class="stop">.</span></h2>
      <ul class="terms">
        {TERMS.map((t) => <li>{t}</li>)}
      </ul>

      {SITE.booking && (
        <div class="cal">
          <a class="btn btn-ink btn-big" href={SITE.booking} target="_blank" rel="noopener">Pick a time in my calendar <span aria-hidden="true">→</span></a>
          <p class="or">or send a request</p>
        </div>
      )}

      <form action={live ? endpoint : undefined} method="post" novalidate data-bs-form data-config={JSON.stringify(config)}>
        {!live && (
          <p class="notice" role="note">
            Online requests open soon. For now, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
          </p>
        )}
        <fieldset disabled={!live}>
          <legend class="sr-only">Request a session</legend>
          <div class="row">
            <div class="field" data-field>
              <label for="bs-name">Name</label>
              <input id="bs-name" name="name" autocomplete="name" required data-msg="Please enter your name." />
              <p class="error" data-error aria-live="polite"></p>
            </div>
            <div class="field" data-field>
              <label for="bs-email">Email</label>
              <input id="bs-email" name="email" type="email" autocomplete="email" required data-msg="Please enter your email address." />
              <p class="error" data-error aria-live="polite"></p>
            </div>
          </div>
          <div class="row">
            <div class="field" data-field>
              <label for="bs-phone">Phone <span class="opt">(optional)</span></label>
              <input id="bs-phone" name="phone" type="tel" autocomplete="tel" />
              <p class="error" data-error aria-live="polite"></p>
            </div>
            <div class="field" data-field>
              <label for="bs-topic">What it’s about</label>
              <select id="bs-topic" name="topic">
                <option value="">Choose one (optional)</option>
                {topics.map((t) => <option>{t}</option>)}
              </select>
            </div>
          </div>
          <div class="field" data-field>
            <label for="bs-message">A few words, and times that suit you</label>
            <textarea id="bs-message" name="message" rows="3" required data-msg="Please write a short message."></textarea>
            <p class="error" data-error aria-live="polite"></p>
          </div>
          <div class="trap" aria-hidden="true">
            <label>Leave this empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
          <button type="submit" class="btn btn-ink btn-big magnetic" data-submit>Request a session <span aria-hidden="true">→</span></button>
        </fieldset>
        <div class="status" data-status tabindex="-1"></div>
      </form>
    </div>

    <figure class="photo reveal">
      <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
      <figcaption>
        <span class="wm">jody<span class="dot">.</span></span>
        <span class="cap">Nothing to pay upfront.</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  document.querySelectorAll<HTMLFormElement>("[data-bs-form]").forEach((form) => {
    const cfg = JSON.parse(form.dataset.config!) as { endpoint: string; extraFields: Record<string, string>; email: string };
    if (!cfg.endpoint) return;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const controls = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not([name=_gotcha]), textarea")];
    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const v = el.value.trim();
      if (!v) return el.required ? (el.dataset.msg ?? "Please fill this in.") : "";
      if (el.type === "email" && !EMAIL.test(v)) return "Enter an email address like name@example.com.";
      if (el.type === "tel" && !/^\+?\d{8,15}$/.test(v.replace(/[\s()-]/g, ""))) return "Enter a phone number with 8 to 15 digits.";
      return "";
    };
    const show = (el: HTMLInputElement | HTMLTextAreaElement, msg: string) => {
      const slot = el.closest("[data-field]")?.querySelector<HTMLElement>("[data-error]");
      if (slot) slot.textContent = msg;
      msg ? el.setAttribute("aria-invalid", "true") : el.removeAttribute("aria-invalid");
    };
    controls.forEach((el) => {
      el.addEventListener("blur", () => el.value && show(el, check(el)));
      el.addEventListener("input", () => el.hasAttribute("aria-invalid") && show(el, check(el)));
    });
    const fail = (why: string) => {
      status.className = "status error";
      status.innerHTML = `<strong>Sorry, your request wasn’t sent.</strong> ${why} Everything you typed is still here. Or email <a href="mailto:${cfg.email}">${cfg.email}</a>.`;
      status.focus();
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      let first: HTMLElement | null = null;
      controls.forEach((el) => {
        const msg = check(el);
        show(el, msg);
        if (msg && !first) first = el;
      });
      if (first) return (first as HTMLElement).focus();
      if (form.querySelector<HTMLInputElement>("[name=_gotcha]")?.value) return;
      const data: Record<string, string> = {};
      new FormData(form).forEach((v, k) => {
        if (k !== "_gotcha" && String(v).trim()) data[k] = String(v).trim();
      });
      button.disabled = true;
      button.classList.add("is-loading");
      try {
        const res = await fetch(cfg.endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ ...cfg.extraFields, ...data, _subject: "Session request", page: location.href }),
        });
        let body: { ok?: boolean; success?: boolean } = {};
        try {
          body = await res.clone().json();
        } catch {}
        if (res.ok && body.ok !== false && body.success !== false) {
          const done = document.createElement("div");
          done.className = "done";
          done.tabIndex = -1;
          const name = (data.name ?? "").split(" ")[0];
          done.innerHTML = `<h3></h3><p>Your request is with me. I’ll reply by email to find a time.</p>`;
          done.querySelector("h3")!.textContent = `Thank you${name ? `, ${name}` : ""}.`;
          form.replaceWith(done);
          done.focus();
        } else fail(`The form service didn’t accept it (error ${res.status}).`);
      } catch {
        fail("We couldn’t reach the form service; please check your connection.");
      } finally {
        button.disabled = false;
        button.classList.remove("is-loading");
      }
    });
  });
</script>

<style>
  .book-session {
    padding: clamp(12px, 1.4vw, 20px) clamp(10px, 1.4vw, 20px) clamp(60px, 8vw, 110px);
    background: var(--ink);
  }
  .split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(10px, 1.4vw, 20px);
    max-width: 1560px;
    margin: 0 auto;
  }
  .card-gold {
    padding: clamp(32px, 5vw, 76px);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--gold-soft) 45%, var(--gold)) 0%, var(--gold) 45%, color-mix(in srgb, var(--gold-deep) 40%, var(--gold)) 100%);
  }
  .card-gold .eyebrow {
    color: var(--ink);
    opacity: 0.7;
  }
  .title {
    margin-top: 18px;
    font-size: clamp(44px, 6.4vw, 92px);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .stop {
    color: var(--ivory);
  }
  .terms {
    display: grid;
    gap: 6px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-read);
    font-size: 18px;
    line-height: 1.45;
    color: var(--muted);
  }
  .terms li {
    display: flex;
    gap: 12px;
  }
  .terms li::before {
    content: "";
    flex: 0 0 6px;
    height: 6px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--ink);
  }
  .cal {
    margin-top: 36px;
  }
  .or {
    margin-top: 18px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  form {
    margin-top: clamp(32px, 4vw, 48px);
  }
  .notice {
    margin-bottom: 20px;
    padding: 14px 18px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    font-size: 15px;
  }
  .notice a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  fieldset {
    display: grid;
    gap: 16px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  fieldset[disabled] {
    opacity: 0.6;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 18px;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--ivory) 55%, transparent);
    font-size: 16px;
    color: var(--ink);
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink);
    background: var(--ivory);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ink) 12%, transparent);
  }
  [aria-invalid="true"] {
    border-color: var(--burgundy);
  }
  .error {
    font-size: 14px;
    color: var(--burgundy-deep);
  }
  .error:empty {
    display: none;
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  button[data-submit] {
    justify-self: start;
    margin-top: 8px;
  }
  button:global(.is-loading) {
    opacity: 0.7;
    cursor: progress;
  }
  .status:empty {
    display: none;
  }
  .status {
    margin-top: 18px;
    padding: 14px 18px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--burgundy) 16%, transparent);
    font-size: 15px;
  }
  .status :global(a) {
    text-decoration: underline;
  }
  .card-gold :global(.done) {
    margin-top: 40px;
    outline: none;
  }
  .card-gold :global(.done h3) {
    font-size: 36px;
    font-weight: 300;
    letter-spacing: -0.03em;
  }
  .card-gold :global(.done p) {
    margin-top: 10px;
    font-family: var(--font-read);
    font-size: 19px;
  }

  .photo {
    position: relative;
    min-height: 520px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    isolation: isolate;
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 18% 30%;
    z-index: -2;
  }
  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 80%, transparent) 0%, transparent 38%);
  }
  .photo figcaption {
    position: absolute;
    left: clamp(24px, 3vw, 40px);
    right: clamp(24px, 3vw, 40px);
    bottom: clamp(24px, 3vw, 36px);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    color: var(--ivory);
  }
  .wm {
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .wm .dot {
    color: var(--gold);
  }
  .cap {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-soft);
    text-align: right;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
    .photo {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
