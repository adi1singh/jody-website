---
// Chapter V, "The next chapter": Live Sexy Now, the book, its podcast and
// Jody's speaking, as one burgundy chapter. Left: the cover, set at a slight
// angle with foil-stamped gold lettering (the site's one metallic touch;
// temporary until BOOK.cover is set). Right: the title, one line, a short
// text and the waitlist. Below, a quiet strip: the podcast (planned episodes,
// clearly marked as planned) and speaking, each with a small photograph.
// Content: BOOK, PODCAST, SPEAKING, CHAPTERS.next, PHOTOS (src/data/jody.ts).
import ChapterMark from "./ChapterMark.astro";
import Photo from "./Photo.astro";
import Signup from "../convert/Signup.astro";
import { BOOK, CHAPTERS, PHOTOS, PODCAST, SPEAKING } from "../../data/jody";
---
<section id="book" class="section burgundy book" aria-labelledby="book-title">
  <div class="wrap top">
    <div class="cover-col reveal">
      {BOOK.cover ? (
        <img class="cover-img" src={BOOK.cover.src} alt={BOOK.cover.alt} loading="lazy" decoding="async" />
      ) : (
        <figure class="cover" aria-label={`Temporary cover: ${BOOK.title} by Jody Pockran`}>
          <div class="face">
            <p class="author" aria-hidden="true">Jody Pockran</p>
            <div class="art"><Photo photo={PHOTOS.book} ratio="auto" sizes="300px" /></div>
            <p class="foil" aria-hidden="true">Live<br />Sexy<br /><em>Now</em></p>
          </div>
          <figcaption>Temporary cover, final design to come</figcaption>
        </figure>
      )}
    </div>

    <div class="copy">
      <ChapterMark chapter={CHAPTERS.next} />
      <h2 id="book-title" class="title reveal">{BOOK.title}</h2>
      <p class="sub reveal">A book by Jody Pockran, coming soon</p>
      <p class="line reveal">{BOOK.line}</p>
      <p class="text reveal">{BOOK.text}</p>
      <div class="join reveal">
        <Signup list="book-waitlist" submit="Join the waitlist" done="You’re on the waitlist. You’ll hear first." note="" />
      </div>
    </div>
  </div>

  <div class="wrap media" id="podcast">
    <article class="item reveal" aria-labelledby="podcast-title">
      <div class="thumb"><Photo photo={PHOTOS.podcast} ratio="1/1" sizes="160px" /></div>
      <div>
        <p class="kicker">The podcast, {PODCAST.status.toLowerCase()}</p>
        <h3 id="podcast-title">One chapter, one conversation</h3>
        <p class="desc">Each episode takes a chapter of the book and explores it with a guest who has lived it.</p>
        <ul class="eps" aria-label="Planned episodes, not yet recorded">
          {PODCAST.planned.map((p, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{p}<em>planned</em></li>)}
        </ul>
      </div>
    </article>
    <article class="item reveal" aria-labelledby="speaking-title">
      <div class="thumb"><Photo photo={PHOTOS.speaking} ratio="1/1" sizes="160px" /></div>
      <div>
        <p class="kicker">On stage</p>
        <h3 id="speaking-title">{SPEAKING.title}</h3>
        <p class="desc">{SPEAKING.text}</p>
        <a class="link-arrow" href={SPEAKING.cta.href}>{SPEAKING.cta.label}</a>
      </div>
    </article>
  </div>
</section>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
  }
  /* The temporary cover: burgundy board, photo window, foil lettering */
  .cover {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .face {
    width: min(100%, 380px);
    aspect-ratio: 2 / 3;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
    padding: 28px 26px 30px;
    background: #5a1f31;
    box-shadow:
      inset 6px 0 0 rgba(0, 0, 0, 0.18),
      0 40px 70px -30px rgba(10, 4, 6, 0.75);
    transform: rotate(-2.5deg);
    transition: transform 0.9s var(--ease);
  }
  .cover:hover .face {
    transform: rotate(0deg);
  }
  .author {
    text-align: center;
    font: 600 10.5px/1 var(--font-sans);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .art {
    position: relative;
    min-height: 0;
    outline: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    outline-offset: 5px;
  }
  .art :global(.photo) {
    position: absolute;
    inset: 0;
  }
  .foil {
    text-align: center;
    font: 600 clamp(40px, 4vw, 58px) / 0.86 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: linear-gradient(115deg, #a8844a 0%, #e8d3a2 28%, #c4a46b 46%, #f3e4bf 62%, #b08c52 82%, #d9bf8a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .foil em {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }
  figcaption {
    font-size: 12.5px;
    color: var(--muted);
  }
  .cover-img {
    width: min(100%, 380px);
    margin: 0 auto;
  }
  .title {
    font: 300 clamp(56px, 7.4vw, 116px) / 0.9 var(--font-display);
    letter-spacing: -0.03em;
  }
  .sub {
    margin-top: 14px;
    font: italic 300 clamp(22px, 2.2vw, 32px) / 1.2 var(--font-display);
    color: var(--gold);
  }
  .line {
    margin-top: clamp(24px, 3vw, 36px);
    font: 400 clamp(22px, 1.9vw, 28px) / 1.3 var(--font-display);
  }
  .text {
    margin-top: 12px;
    max-width: 50ch;
    color: var(--muted);
  }
  .join {
    margin-top: clamp(24px, 3vw, 36px);
    max-width: 560px;
  }

  /* Podcast and speaking: a quiet two-column strip */
  .media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(64px, 8vw, 110px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--line-strong);
    scroll-margin-top: 90px;
  }
  .item {
    display: grid;
    grid-template-columns: clamp(96px, 10vw, 150px) 1fr;
    gap: clamp(18px, 2vw, 28px);
    align-items: start;
  }
  .kicker {
    font: italic 400 19px/1.2 var(--font-display);
    color: var(--gold);
  }
  h3 {
    margin-top: 6px;
    font: 400 clamp(26px, 2.4vw, 34px) / 1.1 var(--font-display);
  }
  .desc {
    margin-top: 10px;
    max-width: 44ch;
    font-size: 15.5px;
    color: var(--muted);
  }
  .eps {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .eps li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font: 400 18px/1.3 var(--font-display);
  }
  .eps span {
    font-style: italic;
    color: var(--gold);
  }
  .eps em {
    margin-left: auto;
    font: 500 12px/1 var(--font-sans);
    font-style: normal;
    color: var(--faint);
  }
  .item .link-arrow {
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .top,
    .media {
      grid-template-columns: 1fr;
    }
    .face {
      width: min(78%, 320px);
    }
  }
</style>
