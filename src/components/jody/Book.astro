---
// Jody's book and podcast (id="book"), after dawnsaunders.com's book cards:
// a giant lowercase "live sexy now." over a burgundy field, then a big rounded
// card with the cover beside the words, a podcast note and a waitlist sign-up
// (Signup list="book-waitlist").
// BOOK.cover is null until the cover is designed, so the cover shown is a
// mock made in HTML/CSS (burgundy and gold, bold lettering, a sun over hills)
// and is captioned as a draft idea. Set BOOK.cover to show the real one.
// No JavaScript; the cover tilts slightly on hover when motion is allowed.
//
// <Book />
import Signup from "../convert/Signup.astro";
import { BOOK } from "../../data/jody";
import { SITE } from "../../data/site";
const words = BOOK.title.toUpperCase().split(" ");
---
<section class="section burgundy book" id="book" aria-labelledby="book-title">
  <p class="giant" aria-hidden="true">{BOOK.word}<span class="dot">.</span></p>

  <div class="wrap">
    <div class="panel">
      <div class="cover-side">
        <span class="sun" aria-hidden="true"></span>
        <figure class="cover-fig reveal">
          {BOOK.cover ? (
            <img class="cover-img" src={BOOK.cover.src} alt={BOOK.cover.alt} loading="lazy" />
          ) : (
            <>
              <div class="cover" role="img" aria-label={`A draft idea for the cover of ${BOOK.title}: burgundy and gold, bold lettering, a sun over hills`}>
                <span class="c-author">{SITE.name}</span>
                <span class="c-title">
                  {words.map((w, i) => <span>{w}{i === words.length - 1 && <span class="c-dot">.</span>}</span>)}
                </span>
                <svg class="c-land" viewBox="0 0 300 120" preserveAspectRatio="none" aria-hidden="true">
                  <circle cx="200" cy="64" r="34" class="c-sun" />
                  <path d="M0 78 C 60 56, 110 60, 160 74 S 250 92, 300 70 V120 H0 Z" class="c-hill c-hill-back" />
                  <path d="M0 96 C 50 82, 120 84, 170 96 S 260 108, 300 92 V120 H0 Z" class="c-hill" />
                  <path d="M0 78 C 60 56, 110 60, 160 74 S 250 92, 300 70" class="c-line" />
                </svg>
                <span class="c-sub">Confidence and reinvention</span>
              </div>
              <figcaption class="caption">Draft cover idea · the final design is on its way</figcaption>
            </>
          )}
        </figure>
      </div>

      <div class="words reveal">
        <p class="eyebrow"><span class="status">{BOOK.status}</span> The book</p>
        <h2 id="book-title" class="title">{BOOK.title}<span class="dot">.</span></h2>
        <p class="read text">{BOOK.text}</p>

        <div class="pod">
          <span class="mic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <rect x="9" y="3" width="6" height="11" rx="3" />
              <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7" />
            </svg>
          </span>
          <div>
            <p class="pod-label">And a podcast</p>
            <p class="pod-text">{BOOK.podcast}</p>
          </div>
        </div>

        <div class="join">
          <p class="join-label">Hear first when it’s out</p>
          <Signup
            list="book-waitlist"
            submit="Join the waitlist"
            choices={["The book", "The podcast"]}
            choicesLabel="Tell me about"
            done="You’re on the waitlist. You’ll hear first."
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .book {
    overflow: clip;
    padding-top: clamp(70px, 8vw, 120px);
    background:
      radial-gradient(80% 60% at 50% 0%, color-mix(in srgb, var(--burgundy) 70%, var(--gold) 8%), transparent 70%),
      var(--burgundy);
  }

  /* The giant lowercase words, as in "dawn." */
  .giant {
    margin: 0 0 clamp(28px, 4vw, 56px);
    padding-inline: var(--gutter);
    text-align: center;
    font: 300 clamp(64px, 12.6vw, 220px) / 0.86 var(--font-sans);
    letter-spacing: -0.065em;
    color: var(--text);
    white-space: nowrap;
  }
  .giant .dot {
    background: var(--gold-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* One big rounded card, nearly edge to edge */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    border-radius: var(--radius-lg);
    background: var(--burgundy-deep);
    border: 1px solid var(--line);
    overflow: clip;
  }
  .cover-side {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(48px, 6vw, 90px) clamp(24px, 4vw, 60px);
    overflow: clip;
    isolation: isolate;
  }
  .sun {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 44%;
    width: min(88%, 520px);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--gold) 55%, var(--burgundy-deep)) 0%, color-mix(in srgb, var(--gold-deep) 40%, var(--burgundy-deep)) 70%, transparent 100%);
    opacity: 0.8;
  }
  .cover-fig {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 18px;
    width: min(100%, 340px);
  }
  .cover-img,
  .cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 4px 10px 10px 4px;
    box-shadow:
      0 50px 80px -30px rgba(0, 0, 0, 0.7),
      0 10px 24px -10px rgba(0, 0, 0, 0.5);
  }
  .cover-img {
    object-fit: cover;
  }

  /* The draft cover, all CSS */
  .cover {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    padding: 10% 9% 8%;
    background:
      radial-gradient(90% 60% at 70% 20%, color-mix(in srgb, var(--burgundy) 80%, var(--gold) 20%), transparent 70%),
      linear-gradient(170deg, var(--burgundy) 0%, var(--burgundy-deep) 100%);
    color: var(--gold-soft);
    overflow: hidden;
    transition: transform 0.8s var(--ease);
  }
  /* the spine and an inset gold frame */
  .cover::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4.5%;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.45), rgba(255, 255, 255, 0.06) 70%, transparent);
  }
  .cover::after {
    content: "";
    position: absolute;
    inset: 4% 4% 4% 7%;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    pointer-events: none;
  }
  .c-author {
    font: 600 clamp(9px, 1vw, 11px) / 1 var(--font-sans);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-align: center;
    color: var(--gold);
  }
  .c-title {
    display: grid;
    align-content: center;
    font: 800 clamp(44px, 5.4vw, 74px) / 0.86 var(--font-sans);
    letter-spacing: -0.04em;
    background: var(--gold-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-left: 4%;
  }
  .c-land {
    width: 100%;
    height: auto;
    aspect-ratio: 300 / 120;
    margin-bottom: 8%;
  }
  .c-sun {
    fill: var(--gold);
    opacity: 0.85;
  }
  .c-hill {
    fill: var(--burgundy-deep);
  }
  .c-hill-back {
    fill: color-mix(in srgb, var(--burgundy-deep) 70%, var(--burgundy));
  }
  .c-line {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .c-sub {
    font: italic 500 clamp(13px, 1.3vw, 16px) / 1 var(--font-serif);
    text-align: center;
    color: var(--gold-soft);
  }
  .caption {
    font: italic 400 16px/1.3 var(--font-serif);
    letter-spacing: 0.01em;
    color: var(--muted);
    text-align: center;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cover-fig:hover .cover {
      transform: perspective(1200px) rotateY(-8deg) rotateX(2deg) translateY(-6px);
    }
  }

  /* The words */
  .words {
    display: grid;
    align-content: center;
    gap: 0;
    padding: clamp(40px, 5vw, 80px) clamp(24px, 5vw, 76px) clamp(40px, 5vw, 80px) clamp(24px, 3vw, 40px);
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .status {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--gold-sheen);
    color: var(--ink);
  }
  .title {
    margin-top: 22px;
    font-size: clamp(40px, 4.4vw, 64px);
    letter-spacing: -0.045em;
  }
  .text {
    margin-top: 22px;
    max-width: 34ch;
    color: var(--muted);
  }
  .pod {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    margin-top: 32px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--burgundy) 55%, transparent);
  }
  .mic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--accent);
  }
  .pod-label {
    font: 600 11px/1.4 var(--font-sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pod-text {
    margin-top: 6px;
    font: 400 17px/1.45 var(--font-read);
    color: var(--text);
  }
  .join {
    margin-top: 36px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }
  .join-label {
    margin-bottom: 18px;
    font: 300 clamp(22px, 2vw, 28px) / 1.1 var(--font-sans);
    letter-spacing: -0.02em;
  }

  @media (max-width: 960px) {
    .panel {
      grid-template-columns: 1fr;
    }
    .cover-fig {
      width: min(74%, 290px);
    }
    .sun {
      width: min(110%, 440px);
    }
    .words {
      padding: 8px clamp(22px, 5vw, 48px) clamp(36px, 6vw, 56px);
    }
  }
  @media (max-width: 600px) {
    .giant {
      white-space: normal;
      font-size: clamp(64px, 22vw, 120px);
      text-align: left;
    }
    .book .wrap {
      width: calc(100% - 16px);
    }
  }
</style>
