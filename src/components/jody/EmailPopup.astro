---
// Jody's email pop-up (version 3 look): a light ivory card with a serif
// headline, the four free audio titles in a quiet line, and the sign-up
// (Signup list="free-audio-popup", so the CRM can tell it apart). Marked as a
// preview of the free audio offer: nothing is connected yet.
// Rules: never on first paint. Opens once, after the visitor has scrolled
// past ~45% of the page or after ~25 seconds, whichever comes first, and not
// while they are typing in a form or reading the free-audio section. Never
// again after closing it or signing up anywhere on the page (localStorage key
// "jody-popup", wrapped in try/catch). A real modal <dialog>: focus moves in
// and returns, Escape, the close button and clicking the backdrop close it.
// A bottom sheet on phones. With JavaScript off it never shows (rendered
// `hidden`). No motion with reduced motion.
//
// <EmailPopup slot="end" />   (in Base.astro's end slot)
import Signup from "../convert/Signup.astro";
import { AUDIOS } from "../../data/jody";
---
<dialog class="popup" aria-labelledby="popup-title" aria-describedby="popup-text" aria-modal="true" hidden data-email-popup>
  <div class="card light">
    <button type="button" class="close" aria-label="Close" data-close>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <div class="inner">
      <p class="eyebrow">A gift from Jody</p>
      <h2 id="popup-title" class="title">Sleep easier <em>tonight.</em></h2>
      <p id="popup-text" class="text">
        Free hypnosis audios, recorded by me. Leave your email and I’ll send them as soon as they’re ready.
      </p>
      <p class="titles" aria-label="The recordings">
        {AUDIOS.map((a, i) => <span class="t">{a.title}{i < AUDIOS.length - 1 && <span class="sep" aria-hidden="true">·</span>}</span>)}
      </p>
      <div class="form">
        <Signup list="free-audio-popup" submit="Send me the audio" done="You’re on the list. Watch your inbox." note="" />
      </div>
      <p class="preview">A preview of the free audio offer</p>
    </div>
  </div>
</dialog>

<script>
  const KEY = "jody-popup";
  const dlg = document.querySelector<HTMLDialogElement>("[data-email-popup]");
  const store = {
    get() {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    },
    set(v: string) {
      try {
        localStorage.setItem(KEY, v);
      } catch {}
    },
  };

  if (dlg && typeof dlg.showModal === "function" && !store.get()) {
    let shown = false;
    let returnTo: HTMLElement | null = null;
    let timer = 0;

    const busy = () => {
      const a = document.activeElement;
      if (a && a.matches("input, textarea, select")) return true; // typing somewhere
      if (document.querySelector("dialog[open]:not([data-email-popup]), [role=dialog]:not([hidden])")) return true;
      const free = document.getElementById("free");
      if (free) {
        const r = free.getBoundingClientRect();
        if (r.top < innerHeight * 0.6 && r.bottom > innerHeight * 0.4) return true; // already reading it
      }
      return false;
    };

    const stop = () => {
      removeEventListener("scroll", onScroll);
      clearTimeout(timer);
    };

    const open = () => {
      if (shown || store.get()) return stop();
      if (busy()) {
        // try again a little later, once
        clearTimeout(timer);
        timer = window.setTimeout(open, 8000);
        return;
      }
      shown = true;
      stop();
      returnTo = document.activeElement as HTMLElement | null;
      dlg.hidden = false;
      dlg.showModal();
      dlg.querySelector<HTMLElement>("[data-close]")?.focus();
    };

    const close = (why: string) => {
      store.set(why);
      dlg.classList.add("is-closing");
      const done = () => {
        dlg.classList.remove("is-closing");
        if (dlg.open) dlg.close();
        dlg.hidden = true;
        returnTo?.focus?.({ preventScroll: true });
      };
      matchMedia("(prefers-reduced-motion: reduce)").matches ? done() : setTimeout(done, 220);
    };

    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (max > 0 && scrollY / max > 0.45) open();
    };

    // wait a beat after load so it is never part of first paint
    setTimeout(() => {
      addEventListener("scroll", onScroll, { passive: true });
      timer = window.setTimeout(open, 25000);
    }, 1500);

    dlg.querySelector("[data-close]")?.addEventListener("click", () => close("dismissed"));
    dlg.addEventListener("cancel", (e) => {
      e.preventDefault(); // Escape: close our way
      close("dismissed");
    });
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close("dismissed"); // the backdrop
    });

    // signed up anywhere on the page: never show it again
    document.querySelectorAll<HTMLFormElement>("[data-signup]").forEach((form) => {
      new MutationObserver(() => {
        if (form.querySelector(".done")) {
          store.set("signed-up");
          if (!dlg.contains(form)) stop();
        }
      }).observe(form, { childList: true });
    });
  }
</script>

<style>
  .popup {
    width: min(520px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--black);
    overflow: visible;
  }
  .popup::backdrop {
    background: color-mix(in srgb, var(--black) 55%, transparent);
  }
  /* .light: the card always takes the ivory tone */
  .card {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius);
    border-top: 1px solid var(--gold);
    background: var(--bg);
    color: var(--text);
  }
  .inner {
    display: grid;
    gap: 16px;
    padding: clamp(36px, 6vw, 52px) clamp(24px, 6vw, 48px) clamp(26px, 5vw, 36px);
  }
  .title {
    margin: 6px 0 0;
    font-size: clamp(40px, 8vw, 54px);
    font-weight: 300;
    line-height: 1;
  }
  .text {
    margin: 0;
    max-width: 36ch;
    font: 400 15.5px/1.65 var(--font-sans);
    color: var(--muted);
  }
  .titles {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin: 4px 0 6px;
    padding: 14px 0;
    border-block: 1px solid var(--line);
    font: italic 400 19px/1.3 var(--font-display);
    color: var(--text);
  }
  .t {
    white-space: nowrap;
  }
  .sep {
    margin: 0 10px;
    color: var(--detail);
    font-style: normal;
  }
  .form {
    margin-top: 6px;
  }
  .preview {
    margin: 6px 0 0;
    font: 400 12px/1.5 var(--font-sans);
    color: var(--faint);
  }
  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    transition: border-color 0.4s var(--ease);
  }
  .close:hover,
  .close:focus-visible {
    border-color: var(--line-strong);
    outline: none;
  }
  .close:focus-visible {
    border-color: var(--gold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .popup[open] {
      animation: pop-in 0.6s var(--ease) both;
    }
    .popup[open]::backdrop {
      animation: fade 0.5s ease both;
    }
    .popup:global(.is-closing) {
      animation: pop-out 0.22s ease-in both;
    }
    .popup:global(.is-closing)::backdrop {
      animation: fade 0.22s ease reverse both;
    }
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes pop-out {
    to {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  /* Phones: a bottom sheet */
  @media (max-width: 560px) {
    .popup {
      width: 100%;
      margin: auto 0 0;
      max-height: 90dvh;
    }
    .card {
      max-height: 90dvh;
      border-radius: 0;
    }
    .inner {
      gap: 12px;
      padding-bottom: calc(22px + env(safe-area-inset-bottom));
    }
    .titles {
      font-size: 17px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .popup[open] {
        animation-name: sheet-in;
      }
      .popup:global(.is-closing) {
        animation-name: sheet-out;
      }
    }
  }
  @keyframes sheet-in {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes sheet-out {
    to {
      transform: translateY(100%);
    }
  }
</style>
