---
// Session: how a session works, the prices and the terms, on ivory. The hook
// is the 21 nights: "One session. Twenty-one nights." Four steps sit in a row
// with large thin numerals (01–04) over gold hairlines, then the prices as calm
// rounded cards (the featured one in gold, after dawnsaunders.com's gold book
// card), then the terms in one quiet line. Not a SaaS pricing table: few words,
// lots of space. Content: STEPS, PRICES and TERMS in src/data/jody.ts; empty
// PRICES or TERMS hide their part. Anchor: #session (the assistant links here).
// No JavaScript; items fade in with .reveal.
import { STEPS, PRICES, TERMS, BOOK_HREF } from "../../data/jody";
import { SITE } from "../../data/site";

const book = SITE.booking || BOOK_HREF;
const pad = (n: number) => String(n).padStart(2, "0");
---
<section id="session" class="session light" aria-labelledby="session-title">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">How a session works</p>
      <h2 id="session-title" class="h2">One session<span class="dot">.</span><br /><em>Twenty-one</em> nights<span class="dot">.</span></h2>
      <p class="section-sub">One deep session, then a recording of your own to fall asleep to, so the change sets in.</p>
    </header>

    <ol class="steps" data-reveal-group>
      {STEPS.map((s, i) => (
        <li class="step reveal">
          <span class="num" aria-hidden="true">{pad(i + 1)}</span>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-text">{s.text}</p>
        </li>
      ))}
    </ol>

    {PRICES.length > 0 && (
      <div class="prices-wrap">
        <h3 class="prices-title reveal">Prices<span class="dot">.</span></h3>
        <ul class="prices" data-reveal-group>
          {PRICES.map((p) => (
            <li class:list={["price-card", "reveal", { "gold featured": p.featured }]}>
              {p.featured && <span class="sun" aria-hidden="true"></span>}
              <p class="price-name">{p.name}</p>
              <p class="price">
                <span class="amount">{p.price}</span>
                <span class="per">{p.per}</span>
              </p>
              <ul class="includes">
                {p.includes.map((x) => <li>{x}</li>)}
              </ul>
              <a class:list={["btn", p.featured ? "btn-ink magnetic" : "btn-outline"]} href={book}>
                {p.featured ? "Book a session" : "Ask Jody"} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {TERMS.length > 0 && (
      <ul class="terms reveal" aria-label="Terms">
        {TERMS.map((t) => <li>{t}</li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .session {
    position: relative;
    overflow: clip;
    padding: var(--section) 0;
    scroll-margin-top: 72px;
  }
  .head {
    max-width: 820px;
    margin-bottom: clamp(56px, 8vw, 110px);
  }
  .head .h2 {
    margin-top: 18px;
    font-size: clamp(44px, 7vw, 104px);
    line-height: 0.98;
  }

  /* ---------- the four steps ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 48px);
  }
  .step {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .num {
    display: block;
    padding-bottom: 18px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--gold);
    font: 200 clamp(64px, 7vw, 112px) / 0.9 var(--font-sans);
    letter-spacing: -0.06em;
    color: var(--accent);
  }
  .step:last-child .num {
    border-bottom-width: 2px;
  }
  .step-title {
    font-size: clamp(22px, 1.9vw, 28px);
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .step-text {
    font: 400 17px/1.5 var(--font-read);
    color: var(--muted);
    max-width: 30ch;
  }

  /* ---------- prices ---------- */
  .prices-wrap {
    margin-top: clamp(80px, 11vw, 150px);
  }
  .prices-title {
    font-size: clamp(34px, 4.4vw, 60px);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .prices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 14px;
    align-items: stretch;
  }
  .price-card {
    position: relative;
    overflow: clip;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(28px, 3vw, 44px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .price-card.featured {
    border-color: transparent;
    background:
      radial-gradient(70% 60% at 30% 10%, color-mix(in srgb, var(--ivory) 36%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in srgb, var(--gold) 72%, var(--gold-soft)) 0%, var(--gold) 50%, color-mix(in srgb, var(--gold) 55%, var(--gold-deep)) 100%);
  }
  .sun {
    position: absolute;
    right: -30%;
    top: -35%;
    width: 75%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    pointer-events: none;
  }
  .price-name {
    position: relative;
    font: 600 12px/1.4 var(--font-sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .price {
    position: relative;
    display: grid;
    gap: 6px;
  }
  .amount {
    font: 200 clamp(56px, 5.6vw, 88px) / 0.9 var(--font-sans);
    letter-spacing: -0.05em;
  }
  .per {
    font: 400 17px/1.3 var(--font-read);
    color: var(--muted);
  }
  .includes {
    position: relative;
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    flex: 1;
  }
  .includes li {
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font: 400 16px/1.4 var(--font-read);
  }
  .price-card .btn {
    position: relative;
    align-self: flex-start;
  }

  /* ---------- terms ---------- */
  .terms {
    list-style: none;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    font: 400 15px/1.5 var(--font-read);
    color: var(--muted);
  }
  .terms li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .terms li::before {
    content: "";
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateY(-3px);
  }

  /* ---------- tablets and phones ---------- */
  @media (max-width: 1080px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 56px;
    }
    .prices {
      grid-template-columns: 1fr;
      max-width: 620px;
    }
  }
  @media (max-width: 600px) {
    .steps {
      grid-template-columns: 1fr;
      row-gap: 36px;
    }
    .step {
      grid-template-columns: 88px minmax(0, 1fr);
      column-gap: 18px;
      row-gap: 8px;
    }
    .num {
      grid-row: span 2;
      margin: 0;
      padding: 0 0 10px;
      font-size: 60px;
      border-bottom: 0;
      border-right: 1px solid var(--gold);
      height: 100%;
    }
    .step:last-child .num {
      border-right-width: 2px;
    }
    .terms {
      flex-direction: column;
    }
  }
</style>
