---
// Cinematic hero (version 3). Black, split editorially: the headline set
// large in Cormorant on the left, Jody's photograph filling the right half
// from top to bottom (the header floats over it). One sentence, one action.
// After Regan Hillyer's full-bleed portrait openings, kept calmer.
// Motion: the photo opens with a slow wipe and settles from a slight zoom;
// the headline lines rise in turn. All still with reduced motion; complete
// without JavaScript. Phones: the portrait first, words under it.
import Photo from "./Photo.astro";
import { HERO, PHOTOS } from "../../data/jody";
---
<section class="hero dark" aria-labelledby="hero-title">
  <div class="media">
    <Photo photo={PHOTOS.hero} ratio="auto" eager sizes="(max-width: 900px) 100vw, 56vw" class="hero-photo" />
  </div>

  <div class="copy">
    <p class="eyebrow fade-up" style="--line:0">Jody Pockran, hypnotherapist and life coach</p>
    <h1 id="hero-title" class="display">
      <span class="line-up" style="--line:1"><span>{HERO.title[0]}</span></span>
      <span class="line-up" style="--line:2"><span><em>{HERO.title[1]}</em></span></span>
    </h1>
    <p class="sub fade-up" style="--line:3">{HERO.sub}</p>
    <a class="btn btn-primary fade-up" style="--line:4" href={HERO.cta.href}>{HERO.cta.label}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    min-height: max(640px, min(100svh, 1000px));
    overflow: clip;
  }
  .media {
    grid-column: 2;
    grid-row: 1;
    position: relative;
  }
  .media :global(.hero-photo) {
    position: absolute;
    inset: 0;
  }
  /* Ease the photo's left edge into the black so the split feels cinematic, not boxed */
  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--black) 0%, rgba(23, 21, 20, 0) 18%);
    pointer-events: none;
  }
  .copy {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    display: grid;
    justify-items: start;
    gap: 30px;
    padding: 140px clamp(24px, 4vw, 64px) clamp(56px, 8vh, 96px) max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    position: relative;
    z-index: 1;
  }
  .display {
    font-size: clamp(56px, 6.6vw, 112px);
    margin-right: -14vw; /* the headline may run onto the photo, like a magazine cover */
    text-shadow: 0 2px 30px rgba(23, 21, 20, 0.35);
  }
  .display em {
    color: var(--gold);
  }
  .sub {
    max-width: 34ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
  }
  .eyebrow {
    color: var(--gold);
  }
  .btn {
    margin-top: 6px;
  }

  /* The photo opens on load: a slow wipe from the right and a gentle settle */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .media {
      animation: open 1.6s 0.1s var(--ease-in-out) both;
    }
    :global(html.js) .media :global(img) {
      animation: settle 2.4s 0.1s var(--ease) both;
    }
  }
  @keyframes open {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.12);
    }
  }

  /* Phones and tablets: portrait on top, words under it */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .media {
      grid-column: 1;
      grid-row: 1;
      aspect-ratio: 4 / 5;
      max-height: 78svh;
      width: 100%;
    }
    .media::after {
      background: linear-gradient(to top, var(--black) 0%, rgba(23, 21, 20, 0.6) 14%, rgba(23, 21, 20, 0) 34%);
    }
    .copy {
      grid-column: 1;
      grid-row: 2;
      margin-top: -36px;
      padding: 0 var(--gutter) 64px;
      gap: 22px;
    }
    .display {
      font-size: clamp(46px, 13vw, 76px);
      margin-right: 0;
    }
    .sub {
      font-size: 16px;
    }
  }
</style>
