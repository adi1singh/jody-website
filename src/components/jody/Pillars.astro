---
// Chapter IV, "Ways to work together": the three ways in as tall photographic
// panels side by side, not cards. Hypnosis is the widest (the established
// service). Each panel is a link: the photo fills it, a soft shade rises from
// the bottom, and the name, one line, what it helps with (hypnosis) and the
// price sit over it. Hover or focus pushes the photo in slightly and draws a
// gold line. Phones: the panels stack, each a tall crop.
// Content: PILLARS, CHAPTERS.work, PHOTOS (src/data/jody.ts).
import ChapterMark from "./ChapterMark.astro";
import Photo from "./Photo.astro";
import { CHAPTERS, PHOTOS, PILLARS } from "../../data/jody";
---
<section id="work" class="section pillars" aria-labelledby="work-title">
  <div class="wrap head">
    <ChapterMark chapter={CHAPTERS.work} />
    <h2 id="work-title" class="h2 turn reveal">Three ways in.<em>One new story.</em></h2>
  </div>

  <div class="wrap panels" data-reveal-group>
    {PILLARS.map((p, i) => (
      <a id={p.id} class:list={["panel", "dark", "reveal", { main: i === 0 }]} href={p.cta.href} aria-labelledby={`${p.id}-title`}>
        <Photo photo={PHOTOS[p.photo]} ratio="auto" sizes="(max-width: 900px) 100vw, 40vw" />
        <div class="panel-copy">
          <p class="price">{p.price}</p>
          <h3 id={`${p.id}-title`}>{p.title}</h3>
          <p class="line">{p.line}</p>
          {i === 0 && <p class="for">{p.for.slice(0, 5).join(", ")}, and more.</p>}
          <span class="go">{p.cta.label}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(32px, 4vw, 52px);
  }
  .panels {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: clamp(10px, 1.2vw, 16px);
    height: clamp(560px, 46vw, 720px);
  }
  .panel {
    position: relative;
    display: block;
    overflow: hidden;
    color: var(--ivory);
    background: var(--black);
  }
  .panel :global(.photo) {
    position: absolute;
    inset: 0;
  }
  .panel :global(.photo img) {
    transition: transform 1.4s var(--ease);
  }
  .panel:hover :global(.photo img),
  .panel:focus-visible :global(.photo img) {
    transform: scale(1.05);
  }
  .panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(23, 21, 20, 0.92) 0%, rgba(23, 21, 20, 0.55) 38%, rgba(23, 21, 20, 0) 66%);
    pointer-events: none;
  }
  .panel-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: clamp(22px, 2.4vw, 36px);
  }
  .price {
    font: 600 12.5px/1 var(--font-sans);
    letter-spacing: 0.04em;
    color: var(--gold);
  }
  h3 {
    margin-top: 12px;
    font: 300 clamp(34px, 3.2vw, 52px) / 1 var(--font-display);
    letter-spacing: -0.015em;
  }
  .main h3 {
    font-size: clamp(42px, 4.4vw, 68px);
  }
  .line {
    margin-top: 12px;
    max-width: 36ch;
    font-size: 15.5px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ivory) 82%, transparent);
  }
  .for {
    margin-top: 10px;
    max-width: 44ch;
    font: italic 400 17px/1.45 var(--font-display);
    color: var(--gold);
  }
  .go {
    display: inline-block;
    margin-top: 18px;
    padding-bottom: 5px;
    font: 600 14px/1 var(--font-sans);
    background: linear-gradient(var(--gold), var(--gold)) left bottom / 28px 1px no-repeat;
    transition: background-size 0.6s var(--ease);
  }
  .panel:hover .go,
  .panel:focus-visible .go {
    background-size: 100% 1px;
  }
  @media (max-width: 900px) {
    .panels {
      grid-template-columns: 1fr;
      height: auto;
    }
    .panel {
      aspect-ratio: 4 / 5;
    }
    .main {
      aspect-ratio: 4 / 5;
    }
  }
</style>
