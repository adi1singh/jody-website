---
// The gold thread: one fine champagne line down the left margin of the whole
// story, like a book's ribbon. It draws itself as you scroll, so the line
// always reaches the part you're reading, and passes through each chapter's
// seal. Wrap the chapters in it: <Thread>…sections…</Thread>.
// Without JavaScript or with reduced motion, the line is simply drawn in full.
---
<div class="story" data-thread>
  <span class="thread" aria-hidden="true"></span>
  <span class="bead" aria-hidden="true"></span>
  <slot />
</div>

<script>
  const story = document.querySelector<HTMLElement>("[data-thread]");
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  if (story && !still.matches) {
    story.classList.add("is-drawing");
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = story.getBoundingClientRect();
      const reach = innerHeight * 0.62 - r.top; // the line leads the reader slightly
      story.style.setProperty("--drawn", String(Math.min(1, Math.max(0, reach / r.height))));
    };
    addEventListener("scroll", () => (raf ||= requestAnimationFrame(update)), { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>

<style>
  .story {
    position: relative;
  }
  .thread {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--thread-x);
    z-index: 5;
    width: 1px;
    background: var(--gold);
    pointer-events: none;
    transform-origin: top;
  }
  .story.is-drawing .thread {
    transform: scaleY(var(--drawn, 0));
  }
  /* A small gold bead travels at the tip of the thread while it draws */
  .bead {
    display: none;
  }
  .story.is-drawing .bead {
    display: block;
    position: absolute;
    left: calc(var(--thread-x) - 3px);
    top: calc(var(--drawn, 0) * 100% - 3px);
    z-index: 5;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 22%, transparent);
    pointer-events: none;
  }
</style>
