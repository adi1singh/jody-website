---
// Sticky header that turns solid on scroll (JobGen). Dropdown groups open on hover
// for mouse users and on click/Enter for keyboard and touch (Hind Zero Waste);
// Escape or clicking away closes. Phones get a full-screen menu.
import Wordmark from "./Wordmark.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { NAV, SITE, isGroup } from "../../data/site";
interface Props {
  cta?: { label: string; href: string };
  /** Show the EN / हिं / मरा switcher (see src/i18n). */
  languages?: boolean;
}
const { cta = { label: "Get in touch", href: "#contact" }, languages = false } = Astro.props;
---
<header class="header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <Wordmark />
      <span class="sr-only">, home</span>
    </a>
    <nav class="nav" aria-label="Main">
      {NAV.map((n, i) =>
        isGroup(n) ? (
          <div class="nav-group" data-nav-group>
            <button type="button" class="nav-trigger" aria-expanded="false" aria-controls={`nav-menu-${i}`}>
              {n.label}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
            </button>
            <div class="nav-menu" id={`nav-menu-${i}`} hidden>
              {n.items.map((it) => (
                <a href={it.href}>
                  <b>{it.label}</b>
                  {it.desc && <small>{it.desc}</small>}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={n.href}>{n.label}</a>
        ),
      )}
    </nav>
    <div class="header-actions">
      {languages && <LanguageSwitcher />}
      <a class="btn btn-accent btn-small header-cta magnetic" href={cta.href}>{cta.label}</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="wrap">
      {NAV.map((n) =>
        isGroup(n) ? (
          <div class="mobile-group">
            <p class="mono">{n.label}</p>
            {n.items.map((it) => (
              <a href={it.href}>{it.label}{it.desc && <small>{it.desc}</small>}</a>
            ))}
          </div>
        ) : (
          <a class="mobile-link" href={n.href}>{n.label}</a>
        ),
      )}
      <a class="btn btn-light" href={cta.href}>{cta.label}</a>
    </div>
  </div>
</header>

<script>
  const groups = [...document.querySelectorAll<HTMLElement>("[data-nav-group]")];
  const hover = matchMedia("(hover: hover) and (pointer: fine)");
  const set = (g: HTMLElement, open: boolean) => {
    g.querySelector(".nav-trigger")?.setAttribute("aria-expanded", String(open));
    const m = g.querySelector<HTMLElement>(".nav-menu");
    if (m) m.hidden = !open;
  };
  const closeAll = (except?: HTMLElement) => groups.forEach((g) => g !== except && set(g, false));
  groups.forEach((g) => {
    const trigger = g.querySelector<HTMLButtonElement>(".nav-trigger")!;
    let hoverOpened = 0;
    trigger.addEventListener("click", () => {
      // A click straight after a hover-open keeps the menu open rather than toggling it shut.
      if (Date.now() - hoverOpened < 400) return;
      const open = trigger.getAttribute("aria-expanded") !== "true";
      closeAll(g);
      set(g, open);
    });
    g.addEventListener("pointerenter", () => {
      if (!hover.matches) return;
      closeAll(g);
      set(g, true);
      hoverOpened = Date.now();
    });
    g.addEventListener("pointerleave", () => hover.matches && set(g, false));
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-nav-group]")) closeAll();
  });

  const menuBtn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const mobile = document.getElementById("mobile-menu");
  const setMobile = (open: boolean) => {
    if (!menuBtn || !mobile) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    mobile.hidden = !open;
    document.body.classList.toggle("menu-open", open);
  };
  menuBtn?.addEventListener("click", () => setMobile(mobile?.hidden ?? true));
  mobile?.addEventListener("click", (e) => (e.target as HTMLElement).closest("a") && setMobile(false));
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = groups.find((g) => g.querySelector(".nav-trigger")?.getAttribute("aria-expanded") === "true");
    if (open) {
      set(open, false);
      open.querySelector<HTMLElement>(".nav-trigger")?.focus();
    }
    if (mobile && !mobile.hidden) {
      setMobile(false);
      menuBtn?.focus();
    }
  });
  matchMedia("(min-width: 961px)").addEventListener("change", (e) => e.matches && setMobile(false));
</script>

<style>
  /* Floats over the hero (ivory text on the photo), then turns into an ivory
     bar with black text once the page scrolls (.scrolled from motion.ts). */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--ivory);
    border-bottom: 1px solid transparent;
    transition:
      background 0.5s var(--ease),
      color 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  .header::before {
    /* a soft shade under the transparent header so it reads on any photo */
    content: "";
    position: absolute;
    inset: 0 0 -40px;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(23, 21, 20, 0.45), transparent);
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .header:global(.scrolled),
  :global(body.menu-open) .header {
    background: var(--ivory);
    color: var(--black);
    border-color: rgba(23, 21, 20, 0.08);
  }
  .header:global(.scrolled)::before,
  :global(body.menu-open) .header::before {
    opacity: 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 84px;
    transition: height 0.5s var(--ease);
  }
  .header:global(.scrolled) .header-inner {
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    font-size: 27px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 36px);
    font: 500 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nav > a {
    position: relative;
    padding: 8px 0;
    opacity: 0.86;
    transition: opacity 0.3s;
  }
  .nav > a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .nav > a:hover {
    opacity: 1;
  }
  .nav > a:hover::after,
  .nav > a:focus-visible::after {
    transform: scaleX(1);
  }
  .nav-group {
    position: relative;
  }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .nav-trigger svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .nav-menu {
    position: absolute;
    top: 100%;
    left: -18px;
    min-width: 240px;
    padding: 10px;
    background: var(--ivory);
    color: var(--black);
    border: 1px solid rgba(23, 21, 20, 0.1);
  }
  .nav-menu a {
    display: block;
    padding: 10px 12px;
    text-transform: none;
    letter-spacing: 0;
    font-size: 15px;
  }
  .nav-menu small,
  .mobile-group small {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* "Book a session": outlined over the photo, solid once scrolled */
  .header-cta {
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
  }
  .header-cta:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--black);
  }
  .header:global(.scrolled) .header-cta {
    background: var(--black);
    border-color: var(--black);
    color: var(--ivory);
  }
  .header:global(.scrolled) .header-cta:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--black);
  }
  .menu-btn {
    display: none;
    width: 46px;
    height: 46px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: none;
    color: inherit;
    place-content: center;
    gap: 6px;
  }
  .menu-btn span {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .menu-btn[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  /* Phone menu: a calm ivory page with large serif links */
  .mobile-menu {
    height: calc(100dvh - 84px);
    overflow-y: auto;
    padding: 28px 0 48px;
    background: var(--ivory);
    color: var(--black);
    animation: menu-in 0.5s var(--ease) both;
  }
  .mobile-menu .wrap {
    display: grid;
    gap: 6px;
  }
  .mobile-group {
    display: grid;
    gap: 12px;
  }
  .mobile-group a,
  .mobile-link {
    padding: 8px 0;
    border-bottom: 1px solid rgba(23, 21, 20, 0.08);
    font: 300 clamp(32px, 9vw, 44px) / 1.15 var(--font-display);
    letter-spacing: -0.01em;
  }
  .mobile-menu .btn {
    margin-top: 28px;
    justify-self: start;
    background: var(--black);
    color: var(--ivory);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      animation: none;
    }
  }
  @media (max-width: 1020px) {
    .nav,
    .header-cta {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
</style>
