---
// Jody's wordmark: "Jody Pockran" set in Cormorant Garamond, the surname in
// italic. Text, not an image: sharp at any size, takes the colour around it.
import { SITE } from "../../data/site";
const [first, ...rest] = SITE.name.split(" ");
---
<span class="wordmark">{first} <em>{rest.join(" ")}</em></span>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  em {
    font-weight: 400;
    font-style: italic;
  }
</style>
