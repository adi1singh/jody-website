---
// From Digital Bridge: a short branded curtain on the first page view of a visit.
// The logo bars grow, the name rises into place, a line sweeps across, then the
// curtain lifts away. An inline script in Base.astro sets <html data-intro="play">
// before paint, so repeat views, reduced-motion visitors and visitors without
// JavaScript never see it. Click or any key skips it.
import BrandMark from "./BrandMark.astro";
import { SITE } from "../../data/site";
interface Props {
  word?: string;
  sub?: string;
}
const { word = SITE.intro.word, sub = SITE.intro.sub } = Astro.props;
---
<div class="intro" aria-hidden="true" data-intro-curtain>
  <div class="intro-inner">
    <BrandMark mono size={68} />
    <span class="intro-word"><span>{word}</span></span>
    <span class="intro-sub"><span>{sub}</span></span>
  </div>
  <span class="intro-line"></span>
</div>

<script>
  const root = document.documentElement;
  if (root.dataset.intro === "play") {
    try {
      sessionStorage.setItem("intro-seen", "1");
    } catch {}
    const done = () => (root.dataset.intro = "seen");
    setTimeout(done, 2300);
    addEventListener("keydown", done, { once: true });
    document.querySelector("[data-intro-curtain]")?.addEventListener("click", done);
  }
</script>

<style>
  .intro {
    display: none;
  }
  :global(html[data-intro="play"]) .intro {
    position: fixed;
    inset: 0;
    z-index: 1500;
    display: grid;
    place-items: center;
    background: var(--intro-bg);
    color: var(--intro-text);
    cursor: pointer;
    animation: intro-lift 0.85s var(--ease-in-out) 1.35s forwards;
  }
  .intro-inner {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 18px;
  }
  .intro :global(.brand-mark) {
    grid-row: span 2;
    width: 52px;
    height: 68px;
  }
  .intro :global(.brand-mark path) {
    transform-origin: 50% 100%;
    animation: intro-bars 0.7s var(--ease-out) both;
  }
  .intro :global(.brand-mark path:nth-child(2)) {
    animation-delay: 0.08s;
  }
  .intro :global(.brand-mark path:nth-child(3)) {
    animation-delay: 0.16s;
  }
  .intro-word,
  .intro-sub {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
  }
  .intro-word > span,
  .intro-sub > span {
    display: inline-block;
    animation: intro-up 0.8s var(--ease-out) both;
  }
  .intro-word > span {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1.1;
    animation-delay: 0.25s;
  }
  .intro-sub > span {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--intro-sub);
    animation-delay: 0.45s;
  }
  .intro-line {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 4px;
    background: var(--intro-line);
    transform-origin: 0 50%;
    animation: intro-grow 1.3s var(--ease-in-out) both;
  }
  @keyframes intro-bars {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes intro-up {
    from {
      transform: translateY(110%);
    }
  }
  @keyframes intro-grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes intro-lift {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-intro="play"]) .intro {
      display: none;
    }
  }
</style>
