---
// The logo mark: three bars. Coloured per category by default (JobGen voice bars);
// pass mono to use currentColor (Digital Bridge bridge mark). Swap the SVG for a real logo.
interface Props {
  mono?: boolean;
  size?: number;
  class?: string;
}
const { mono = false, size = 26, class: cls = "" } = Astro.props;
---
<svg class:list={["brand-mark", cls]} width={size * 0.78} height={size} viewBox="0 0 26 34" aria-hidden="true">
  <path d="M0 4 6 1v29l-6 3V4Z" fill={mono ? "currentColor" : "var(--c1)"} />
  <path d="M10 9l6-3v18l-6 3V9Z" fill={mono ? "currentColor" : "var(--c6)"} />
  <path d="M20 4l6-3v29l-6 3V4Z" fill={mono ? "currentColor" : "var(--c3)"} />
</svg>
