---
// Jody's footer, after dawnsaunders.com's: black, the wordmark and a one-line
// description, link columns (FOOTER in site.ts), socials (only those with a
// link in SITE.socials; none, none shown), email and copyright. At the bottom,
// a giant sign-off line, "live sexy now.", over a half gold sun rising from
// the bottom edge. `cta` (Base passes the "Book a session" link) becomes a
// small button beside the wordmark. Works without JavaScript.
import Wordmark from "./Wordmark.astro";
import { FOOTER, SITE } from "../../data/site";
interface Props {
  cta?: { label: string; href: string };
}
const { cta } = Astro.props;
const socials = SITE.socials.filter((s) => s.href);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap top">
    <div class="brand-col">
      <a class="brand" href="/" aria-label={`${SITE.name}, home`}><Wordmark /></a>
      <p class="desc">{SITE.tagline}</p>
      <p class="mail"><a href={`mailto:${SITE.email}`}>{SITE.email}</a>{SITE.phone && <><br /><a href={`tel:${SITE.phone.replace(/\s/g, "")}`}>{SITE.phone}</a></>}</p>
      {cta && <a class="btn btn-accent btn-small" href={cta.href}>{cta.label} <span aria-hidden="true">→</span></a>}
    </div>
    {FOOTER.map((col) => (
      <nav aria-label={col.title}>
        <p class="col-title">{col.title}</p>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
    {socials.length > 0 && (
      <nav aria-label="Social">
        <p class="col-title">Follow</p>
        <ul>{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      </nav>
    )}
  </div>
  <p class="wrap legal">© {year} {SITE.name}</p>

  <div class="signoff" aria-hidden="true">
    <span class="sun"></span>
    <p class="line">live sexy now<span class="stop">.</span></p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(70px, 9vw, 120px);
    background: var(--ink);
    color: var(--ivory);
    overflow: hidden;
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .brand {
    display: inline-block;
    font-size: clamp(30px, 3vw, 38px);
  }
  .desc {
    margin-top: 18px;
    max-width: 24em;
    font-family: var(--font-read);
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }
  .mail {
    margin: 18px 0 24px;
    font-size: 15px;
  }
  .mail a:hover {
    color: var(--gold);
  }
  .col-title {
    font: 600 12px/1.4 var(--font-sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  ul {
    display: grid;
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: 17px;
    font-weight: 300;
  }
  ul a {
    transition: color 0.25s;
  }
  ul a:hover {
    color: var(--gold);
  }
  .legal {
    margin-top: clamp(40px, 5vw, 64px);
    font-size: 13px;
    color: var(--faint);
  }

  .signoff {
    position: relative;
    display: grid;
    place-items: end center;
    margin-top: clamp(30px, 5vw, 60px);
    height: clamp(170px, 20vw, 310px);
    overflow: hidden;
  }
  .sun {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: clamp(260px, 36vw, 540px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--gold-soft) 60%, var(--gold)) 0%, var(--gold) 45%, var(--gold-deep) 100%);
    transform: translate(-50%, 50%);
  }
  .line {
    position: relative;
    font-size: clamp(54px, 13.4vw, 210px);
    font-weight: 300;
    line-height: 0.78;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: var(--ivory);
    transform: translateY(0.06em);
  }
  .stop {
    color: var(--gold);
  }
  @media (max-width: 760px) {
    .top {
      grid-template-columns: 1fr 1fr;
      grid-auto-flow: row;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
    .line {
      font-size: 14.4vw;
    }
  }
</style>
