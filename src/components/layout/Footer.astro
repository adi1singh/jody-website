---
// Jody's footer (version 3). Black, continuing the closing section, quiet and
// ordered: the wordmark and one-line description (SITE.tagline) with the
// email beneath, link columns (FOOTER in site.ts), socials (only those with a
// link in SITE.socials; with none, a small "Social channels coming soon"
// line), then the care note (EXPERIENCE.care) and the copyright in small text.
// No giant type, no decoration. Works without JavaScript.
// `cta` is accepted for Base.astro's <Footer cta={cta} /> but not shown: the
// closing section above already carries the one booking action.
import Wordmark from "./Wordmark.astro";
import { FOOTER, SITE } from "../../data/site";
import { EXPERIENCE } from "../../data/jody";
interface Props {
  cta?: { label: string; href: string };
}
const socials = SITE.socials.filter((s) => s.href);
const year = new Date().getFullYear();
---
<footer class="footer dark">
  <div class="wrap top">
    <div class="brand-col">
      <a class="brand" href="/" aria-label={`${SITE.name}, home`}><Wordmark /></a>
      <p class="desc">{SITE.tagline}</p>
      <p class="mail">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {SITE.phone && <><br /><a href={`tel:${SITE.phone.replace(/[^\d+]/g, "")}`}>{SITE.phone}</a></>}
      </p>
    </div>
    {FOOTER.map((col) => (
      <nav aria-label={col.title}>
        <p class="col-title">{col.title}</p>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
    <nav aria-label="Social">
      <p class="col-title">Follow</p>
      {socials.length > 0 ? (
        <ul>{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      ) : (
        <p class="soon">Social channels coming soon</p>
      )}
    </nav>
  </div>
  <div class="wrap bottom">
    <p class="care">{EXPERIENCE.care}</p>
    <p class="legal">© {year} {SITE.name}. Landscape photos: Dietmar Rabich (CC BY-SA 4.0) and public-domain sources, <a href="https://github.com/adi1singh/jody-website/blob/main/public/photos/CREDITS.md">credits</a>.</p>
  </div>
</footer>

<style>
  .legal a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer {
    padding: clamp(64px, 8vw, 112px) 0 100px; /* bottom: room for the chat launcher */
    border-top: 1px solid var(--line);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 48px clamp(32px, 4vw, 64px);
  }
  .brand {
    display: inline-block;
    font-size: clamp(32px, 3.2vw, 44px);
    color: var(--text);
  }
  .desc {
    margin: 18px 0 0;
    max-width: 30ch;
    font: 400 15px/1.65 var(--font-sans);
    color: var(--muted);
  }
  .mail {
    margin: 22px 0 0;
    font: 400 15px/1.7 var(--font-sans);
  }
  .mail a {
    border-bottom: 1px solid var(--detail);
    padding-bottom: 2px;
    overflow-wrap: anywhere;
    transition: color 0.4s var(--ease);
  }
  .col-title {
    margin: 0 0 18px;
    font: 600 var(--label) / 1.4 var(--font-sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--detail);
  }
  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    font: 400 15px/1.5 var(--font-sans);
    color: var(--text);
    transition: color 0.4s var(--ease);
  }
  nav a:hover,
  .mail a:hover {
    color: var(--gold);
  }
  a:focus-visible {
    outline: 1px solid var(--detail);
    outline-offset: 4px;
  }
  .soon {
    margin: 0;
    font: italic 400 18px/1.4 var(--font-display);
    color: var(--muted);
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 60px;
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .care {
    margin: 0;
    max-width: 78ch;
    font: 400 12.5px/1.6 var(--font-sans);
    color: var(--faint);
  }
  .legal {
    margin: 0;
    flex: none;
    font: 600 10.5px/1.6 var(--font-sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }
  @media (max-width: 900px) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .top {
      gap: 40px 24px;
    }
    nav[aria-label="Social"] {
      grid-column: 1 / -1;
    }
    .bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
