---
// The JobGen hero: drifting "aurora" colour light behind a big headline, a
// rotating word, two actions and the animated voice ribbon. Headline lines rise
// into place (Digital Bridge choreography) and wait for the intro curtain.
// Each rotating word takes the colour of the ribbon line it lights up.
//
// <Hero eyebrow="..." lines={["Websites that", "actually work."]} accentLine={1}
//       rotate={["clinics", "agencies", "trades"]} sub="..." />
// Olivia style, the word inside the headline (it starts its own line on phones,
// so the headline never reflows):
// <Hero lines={["Your next {rotate} call.", "Handled."]} rotate={["buyer", "booking", "missed"]} sub="..." />
interface Props {
  eyebrow?: string;
  /** Headline, one string per line. Put {rotate} in a line to cycle the words there. */
  lines: string[];
  /** Which line gets the spectrum gradient. */
  accentLine?: number;
  /** Words that cycle after the headline, e.g. "Built for clinics / agencies / trades". */
  rotatePrefix?: string;
  rotate?: string[];
  sub: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  ribbon?: boolean;
  align?: "center" | "left";
}
const {
  eyebrow,
  lines,
  accentLine = lines.length - 1,
  rotatePrefix = "Built for",
  rotate = [],
  sub,
  primary = { label: "Get in touch", href: "#contact" },
  secondary,
  ribbon = true,
  align = "center",
} = Astro.props;
// Same order as the ribbon's lines, so a word and the line it flares share a colour.
const tints = ["var(--c1)", "var(--c2)", "var(--c3)", "var(--c4)", "var(--c6)"];
const inlineAt = rotate.length ? lines.findIndex((l) => l.includes("{rotate}")) : -1;
const spoken = new Intl.ListFormat("en", { type: "disjunction" }).format(rotate);
---
<section class:list={["hero", `hero-${align}`]} aria-labelledby="hero-title">
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap hero-inner">
    {eyebrow && <p class="eyebrow hero-eyebrow fade-up" style="--line:-2">{eyebrow}</p>}
    <h1 id="hero-title">
      {lines.map((l, i) => {
        if (i !== inlineAt)
          return <span class="line-up" style={`--line:${i}`}><span class:list={{ "spectrum-text": i === accentLine }}>{l}</span></span>;
        const [before, after] = l.split("{rotate}");
        return (
          <span class="line-up" style={`--line:${i}`}>
            <span class:list={{ "spectrum-text": i === accentLine }}>
              {before}<br class="br-mobile" />
              <span class="rotator rotator-inline" data-rotator aria-hidden="true">
                {rotate.map((w, j) => <span class:list={{ "is-active": j === 0 }} style={`--tint:${tints[j % tints.length]}`}>{w}</span>)}
              </span>
              <span class="sr-only">{spoken}</span>{after}
            </span>
          </span>
        );
      })}
    </h1>
    {rotate.length > 0 && inlineAt < 0 && (
      <p class="hero-rotate fade-up" style="--line:-1">
        {rotatePrefix}{" "}
        <span class="rotator" data-rotator aria-live="off">
          {rotate.map((w, i) => <span class:list={{ "is-active": i === 0 }} style={`--tint:${tints[i % tints.length]}`}>{w}</span>)}
        </span>
      </p>
    )}
    <p class="hero-sub fade-up">{sub}</p>
    <div class="btn-row hero-actions fade-up" style="--line:1">
      <a class="btn btn-light magnetic" href={primary.href}>{primary.label} <span aria-hidden="true">→</span></a>
      {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
    <slot />
  </div>
  {ribbon && <canvas class="voice-ribbon" data-ribbon aria-hidden="true"></canvas>}
</section>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  /* Rotating word: cycles every 1.8s and flares one line of the ribbon. */
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");
  const words = rotator ? [...rotator.children] as HTMLElement[] : [];
  let wordIndex = 0;
  if (rotator && words.length > 1) {
    // The box's own padding counts too (box-sizing: border-box), or italic words get clipped.
    const fit = () => {
      const pad = getComputedStyle(rotator);
      rotator.style.width = words[wordIndex].offsetWidth + parseFloat(pad.paddingLeft) + parseFloat(pad.paddingRight) + "px";
    };
    fit();
    addEventListener("resize", fit);
    document.fonts?.ready.then(fit);
    if (!still.matches)
      setInterval(() => {
        if (document.hidden) return;
        const leaving = words[wordIndex];
        leaving.classList.replace("is-active", "is-leaving");
        setTimeout(() => leaving.classList.remove("is-leaving"), 550);
        wordIndex = (wordIndex + 1) % words.length;
        words[wordIndex].classList.add("is-active");
        fit();
        rotator.dispatchEvent(new CustomEvent("word", { detail: wordIndex }));
      }, 1800);
  }

  /* Voice ribbon: five colour lines that move with a speech-like rhythm. */
  const canvas = document.querySelector<HTMLCanvasElement>("[data-ribbon]");
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const css = getComputedStyle(document.documentElement);
    const lines = ["--c1", "--c2", "--c3", "--c4", "--c6"].map((v, i) => ({
      colour: css.getPropertyValue(v).trim(),
      phase: i * 1.9,
      speed: 0.55 + i * 0.13,
      freq: 1.1 + i * 0.32,
      boost: 0,
    }));
    let w = 0, h = 0, t = 0, energy = 0.3, target = 0.3, visible = true, raf = 0;
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (still.matches) draw();
    };
    const syllable = () => {
      target = Math.random() < 0.22 ? 0.1 : 0.25 + Math.random() * 0.6;
      setTimeout(syllable, 140 + Math.random() * 260);
    };
    function draw() {
      t += 0.016;
      energy += (target - energy) * 0.08;
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = "lighter";
      for (const line of lines) {
        const amp = h * 0.36 * (energy * 0.75 + line.boost * 0.9);
        const path = new Path2D();
        for (let x = 0; x <= w; x += 4) {
          const nx = x / w;
          const env = Math.pow(Math.sin(Math.PI * nx), 1.6);
          const y = h / 2 + env * amp * (Math.sin(nx * line.freq * 12.56 + t * line.speed * 3 + line.phase) * 0.6 + Math.sin(nx * line.freq * 33.3 - t * line.speed * 2.2 + line.phase * 2) * 0.4);
          x ? path.lineTo(x, y) : path.moveTo(x, y);
        }
        ctx.strokeStyle = line.colour;
        ctx.globalAlpha = 0.07 + line.boost * 0.12;
        ctx.lineWidth = 7 + line.boost * 6;
        ctx.stroke(path);
        ctx.globalAlpha = 0.5 + line.boost * 0.5;
        ctx.lineWidth = 1.4 + line.boost * 1.4;
        ctx.stroke(path);
        line.boost *= 0.975;
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
      raf = !still.matches && visible && !document.hidden ? requestAnimationFrame(draw) : 0;
    }
    const run = () => {
      if (!raf && !still.matches && visible) raf = requestAnimationFrame(draw);
    };
    resize();
    addEventListener("resize", resize);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      run();
    }).observe(canvas);
    document.addEventListener("visibilitychange", run);
    rotator?.addEventListener("word", (e) => {
      lines[(e as CustomEvent<number>).detail % lines.length].boost = 1;
      energy = 1;
    });
    if (still.matches) draw();
    else syllable();
  }
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(80px, 12vw, 130px) 0 40px;
    overflow: hidden;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 260px;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }
  .hero-center .hero-inner {
    text-align: center;
  }
  .hero-center .hero-sub {
    margin-inline: auto;
  }
  .hero-center .hero-actions {
    justify-content: center;
  }
  .aurora {
    position: absolute;
    inset: -10% -10% auto;
    height: 900px;
    pointer-events: none;
    overflow: hidden;
    filter: blur(90px) saturate(130%);
    opacity: 0.55;
  }
  .aurora i {
    position: absolute;
    width: 46vw;
    height: 46vw;
    max-width: 680px;
    max-height: 680px;
    border-radius: 50%;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .aurora i:nth-child(1) {
    left: 4%;
    top: -10%;
    background: var(--c1);
  }
  .aurora i:nth-child(2) {
    right: 2%;
    top: -18%;
    background: var(--c6);
    animation-duration: 26s;
    animation-delay: -6s;
  }
  .aurora i:nth-child(3) {
    left: 30%;
    top: 20%;
    background: var(--c3);
    opacity: 0.55;
    animation-duration: 30s;
    animation-delay: -12s;
  }
  .aurora i:nth-child(4) {
    right: 18%;
    top: 34%;
    background: var(--c4);
    opacity: 0.35;
    animation-duration: 24s;
    animation-delay: -3s;
  }
  @keyframes drift {
    50% {
      transform: translate(6vw, 4vw) scale(1.1);
    }
    100% {
      transform: translate(-4vw, 6vw) scale(0.95);
    }
  }
  .hero-eyebrow {
    color: color-mix(in srgb, var(--text) 75%, transparent);
  }
  h1 {
    margin: 26px 0 26px;
    font-size: clamp(44px, 7vw, 104px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .hero-rotate {
    line-height: 1.3;
    font-size: clamp(20px, 2.4vw, 28px);
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  .rotator {
    position: relative;
    display: inline-grid;
    vertical-align: top;
    height: 1.3em;
    overflow: hidden;
    color: var(--text);
    text-align: left;
    transition: width 0.5s var(--ease);
  }
  .rotator > span {
    grid-area: 1 / 1;
    width: max-content;
    color: var(--tint, var(--text));
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 0.55s var(--ease),
      opacity 0.55s;
  }
  .rotator > span:global(.is-active) {
    opacity: 1;
    transform: none;
  }
  .rotator > span:global(.is-leaving) {
    transform: translateY(-100%);
  }
  /* The word inside the headline (Olivia): italic, in its own colour */
  .rotator-inline {
    height: auto;
    vertical-align: bottom;
    padding: 0 0.1em 0.1em 0.02em;
    margin-bottom: -0.1em;
  }
  .rotator-inline > span {
    font-style: italic;
    font-weight: 500;
  }
  .br-mobile {
    display: none;
  }
  @media (max-width: 600px) {
    .br-mobile {
      display: inline;
    }
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 620px;
    font-size: 19px;
    color: var(--muted);
  }
  .hero-actions {
    margin-top: 36px;
  }
  .voice-ribbon {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 160px;
    margin-top: 40px;
  }
</style>
