---
// Pathwise's chat assistant: a rule-based helper in a chat bubble. It answers
// only from this site's own content (the `answers` you give it, matched by
// keywords), offers quick-reply chips, and hands over to a person when it
// doesn't know. No AI service is called and nothing typed is sent anywhere.
// Jody's version 3 look: a black launcher with a thin gold ring, an ivory
// panel in Manrope with the name in serif, and a small line saying it answers
// from the site's own information. Behaviour unchanged.
import { SITE } from "../../data/site";
interface Answer {
  /** Words that trigger this answer. */
  keys: string[];
  /** Label for the quick-reply chip (optional). */
  chip?: string;
  text: string;
  link?: { label: string; href: string };
}
interface Props {
  name?: string;
  greeting?: string;
  answers: Answer[];
  fallback?: string;
}
const {
  name = "Assistant",
  greeting = "Hi! I can answer common questions about what we do. What would you like to know?",
  answers,
  fallback = `I’m not sure about that one. The quickest way is to ask us directly: <a href="mailto:${SITE.email}">${SITE.email}</a>.`,
} = Astro.props;
---
<div class="assistant" data-assistant>
  <button type="button" class="bubble" aria-expanded="false" aria-controls="assistant-panel" aria-label={`Chat with ${name}`} data-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 5.5h15v10h-10l-5 4z" /></svg>
  </button>
  <section class="panel" id="assistant-panel" role="dialog" aria-label={name} hidden>
    <header>
      <div class="who">
        <b>{name}</b>
        <span class="sub">Answers from this site’s own information. Nothing you type is sent.</span>
      </div>
      <button type="button" class="x" aria-label="Close chat" data-toggle>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>
    <div class="log" data-log aria-live="polite"></div>
    <form data-form>
      <input type="text" name="q" placeholder="Type a question…" aria-label="Your question" autocomplete="off" />
      <button type="submit" aria-label="Send">→</button>
    </form>
  </section>
  <script type="application/json" data-assistant-data set:html={JSON.stringify({ greeting, answers, fallback })} />
</div>

<script>
  type A = { keys: string[]; chip?: string; text: string; link?: { label: string; href: string } };
  document.querySelectorAll<HTMLElement>("[data-assistant]").forEach((root) => {
    const { greeting, answers, fallback } = JSON.parse(root.querySelector("[data-assistant-data]")!.textContent!) as { greeting: string; answers: A[]; fallback: string };
    const panel = root.querySelector<HTMLElement>(".panel")!;
    const bubble = root.querySelector<HTMLButtonElement>(".bubble")!;
    const log = root.querySelector<HTMLElement>("[data-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const chips = answers.filter((a) => a.chip);
    let started = false;

    const add = (who: "bot" | "me", html: string) => {
      const m = document.createElement("div");
      m.className = `msg ${who}`;
      m.innerHTML = html;
      log.append(m);
      log.scrollTop = log.scrollHeight;
    };
    const chipRow = () =>
      `<div class="chips">${chips.map((a, i) => `<button type="button" data-chip="${i}">${esc(a.chip!)}</button>`).join("")}</div>`;
    const reply = (a: A | undefined) =>
      setTimeout(
        () => add("bot", a ? `${esc(a.text)}${a.link ? ` <a href="${a.link.href}">${esc(a.link.label)} →</a>` : ""}` : fallback),
        350,
      );
    const match = (q: string) => {
      const words = q.toLowerCase();
      let best: A | undefined, score = 0;
      for (const a of answers) {
        const s = a.keys.filter((k) => words.includes(k.toLowerCase())).length;
        if (s > score) (best = a), (score = s);
      }
      return best;
    };
    const toggle = (open: boolean) => {
      panel.hidden = !open;
      bubble.setAttribute("aria-expanded", String(open));
      if (open && !started) {
        started = true;
        add("bot", esc(greeting) + chipRow());
      }
      if (open) form.querySelector("input")!.focus();
    };
    root.querySelectorAll("[data-toggle]").forEach((b) => b.addEventListener("click", () => toggle(panel.hidden)));
    log.addEventListener("click", (e) => {
      const c = (e.target as HTMLElement).closest<HTMLElement>("[data-chip]");
      if (!c) return;
      const a = chips[Number(c.dataset.chip)];
      add("me", esc(a.chip!));
      reply(a);
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector("input")!;
      const q = input.value.trim();
      if (!q) return;
      add("me", esc(q));
      input.value = "";
      reply(match(q));
    });
    document.addEventListener("keydown", (e) => e.key === "Escape" && !panel.hidden && (toggle(false), bubble.focus()));
  });
</script>

<style>
  /* The assistant needs JavaScript; without it the bubble would do nothing. */
  :global(html:not(.js)) .assistant {
    display: none;
  }
  /* Always the ivory tone inside the panel, whatever section is behind it */
  .assistant {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 60;
    font-family: var(--font-sans);
  }
  .bubble {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 0;
    border-radius: 50%;
    background: var(--black);
    color: var(--ivory);
    box-shadow:
      inset 0 0 0 4px var(--black),
      inset 0 0 0 5px var(--gold);
    transition: color 0.4s var(--ease);
  }
  .bubble:hover {
    color: var(--gold);
  }
  .bubble:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 4px;
  }
  .bubble svg {
    width: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .panel {
    position: absolute;
    left: 0;
    bottom: 68px;
    display: flex;
    flex-direction: column;
    width: min(360px, calc(100vw - 40px));
    height: min(520px, calc(100dvh - 120px));
    border-radius: var(--radius);
    border-top: 1px solid var(--gold);
    background: var(--ivory);
    color: var(--black);
    box-shadow: 0 30px 70px -30px rgba(23, 21, 20, 0.45);
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }
  header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 18px 16px 20px;
    border-bottom: 1px solid rgba(23, 21, 20, 0.1);
  }
  .who {
    display: grid;
    gap: 4px;
  }
  .who b {
    font: 400 24px/1.1 var(--font-display);
  }
  .sub {
    font: 400 12px/1.45 var(--font-sans);
    color: var(--muted);
  }
  .x {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    margin-left: auto;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--black);
  }
  .x:hover,
  .x:focus-visible {
    border-color: rgba(23, 21, 20, 0.22);
    outline: none;
  }
  .log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px;
    overflow-y: auto;
    font: 400 14.5px/1.55 var(--font-sans);
  }
  .log :global(.msg) {
    max-width: 88%;
    padding: 11px 15px;
    border-radius: 2px;
  }
  .log :global(.bot) {
    background: var(--white);
    color: var(--black);
  }
  .log :global(.me) {
    align-self: flex-end;
    background: var(--black);
    color: var(--ivory);
  }
  .log :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }
  .log :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
  .log :global(.chips button) {
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid rgba(23, 21, 20, 0.22);
    background: transparent;
    color: var(--black);
    font: 500 12.5px/1.2 var(--font-sans);
    transition: border-color 0.3s var(--ease);
  }
  .log :global(.chips button:hover) {
    border-color: var(--gold);
  }
  form {
    display: flex;
    gap: 8px;
    padding: 12px 14px 14px 20px;
    border-top: 1px solid rgba(23, 21, 20, 0.1);
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid rgba(23, 21, 20, 0.22);
    border-radius: 0;
    background: transparent;
    color: var(--black);
    font: 400 16px/1.3 var(--font-sans);
  }
  input:focus {
    outline: none;
    border-bottom-color: var(--gold);
  }
  form button {
    flex: none;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: var(--black);
    color: var(--ivory);
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  form button:hover {
    background: var(--gold);
    color: var(--black);
  }
</style>
