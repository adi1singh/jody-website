---
// Jody's home page, first version (brief in README.md).
// Flow: hero → statement → the four pillars → problems in the visitor's words
// → how a session works → prices and booking terms → free audio (lead capture)
// → the book and podcast (waitlist) → about Jody → FAQ → booking request.
// Chat helper in the corner. Content lives in src/data/jody.ts.
import Base from "../layouts/Base.astro";
import Hero from "../components/heroes/Hero.astro";
import InkStatement from "../components/explain/InkStatement.astro";
import ColourPanels from "../components/explain/ColourPanels.astro";
import ProblemCards from "../components/explain/ProblemCards.astro";
import Steps from "../components/explain/Steps.astro";
import PhotoBand from "../components/explain/PhotoBand.astro";
import Signup from "../components/convert/Signup.astro";
import Faq from "../components/convert/Faq.astro";
import ContactForm from "../components/convert/ContactForm.astro";
import ChatAssistant from "../components/widgets/ChatAssistant.astro";
import { PILLARS, PROBLEMS, STEPS, PRICES, AUDIOS, CREDENTIALS, FAQ, ASSISTANT, PHOTOS } from "../data/jody";
const book = { label: "Book a session", href: "#contact" };
---
<Base title="Jody · Hypnotherapy, life coaching and mindset" cta={book}>
  <Hero
    eyebrow="HYPNOTHERAPY · LIFE COACHING · MINDSET"
    lines={["Change how you {rotate}.", "From the inside out."]}
    rotate={["feel", "sleep", "think", "show up"]}
    sub="Hypnosis and life coaching with Jody, for anxiety, overwhelm, old habits and the blocks that keep you small. Book a session, or start tonight with a free audio."
    primary={book}
    secondary={{ label: "Get the free audio", href: "#free" }}
  />

  <section class="section statement">
    <div class="wrap">
      <InkStatement
        text="You don’t need more information. You need to feel like yourself again: confident, calm, and ready for what comes next."
        quiet="Less noise."
        loud="More you."
      />
    </div>
  </section>

  <section class="section light" id="pillars">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">WORK WITH JODY</p>
        <h2 class="h2 reveal">Four ways in.<br /><span class="muted">One you, moving forward.</span></h2>
      </div>
      <ColourPanels items={PILLARS} label="Ways to work with Jody" />
    </div>
  </section>

  <ProblemCards
    eyebrow="HYPNOSIS"
    title="Sound <em>familiar?</em>"
    sub="Most people come to Jody with one of these."
    items={PROBLEMS}
  />

  <section class="section light">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">HOW A SESSION WORKS</p>
        <h2 class="h2 reveal">One session.<br /><span class="muted">Twenty-one nights.</span></h2>
      </div>
      <Steps steps={STEPS} />
    </div>
  </section>

  <section class="section" id="prices">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">PRICES</p>
        <h2 class="h2 reveal">Simple and <em>upfront.</em></h2>
        <p class="section-sub reveal">Prices in Australian dollars.</p>
      </div>
      <div class="prices" data-reveal-group>
        {PRICES.map((p, i) => (
          <article class:list={["price card reveal", { featured: i === 0 }]}>
            <h3>{p.name}</h3>
            <p class="amount"><b>{p.price}</b> <span>{p.per}</span></p>
            <ul>{p.includes.map((x) => <li>{x}</li>)}</ul>
            <a class:list={["btn", i === 0 ? "btn-accent" : "btn-ghost"]} href="#contact">{i === 0 ? "Book a session" : "Ask Jody"}</a>
          </article>
        ))}
      </div>
      <div class="terms reveal">
        <p><b>Nothing to pay upfront.</b> Book your time and pay for the session itself.</p>
        <p><b>Cancelling?</b> Within 24 hours of your time, half the fee applies.</p>
      </div>
    </div>
  </section>

  <section class="section free" id="free">
    <div class="wrap free-grid">
      <div>
        <p class="eyebrow reveal">FREE AUDIO</p>
        <h2 class="h2 reveal">Start <em>tonight.</em></h2>
        <p class="section-sub reveal">Short hypnosis audios, recorded by Jody, free to download. Leave your email and they’re yours as soon as they’re ready.</p>
        <ul class="audios" data-reveal-group>
          {AUDIOS.map((a) => (
            <li class="reveal">
              <span class="play" aria-hidden="true">▶</span>
              <span><b>{a.title}</b><span>{a.text}</span></span>
              <span class="soon mono">RECORDING NOW</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card free-card reveal">
        <h3>Send me the free audio</h3>
        <Signup list="free-audio" submit="Send me the audio" choices={AUDIOS.map((a) => a.title)} done="We’ll email your audio as soon as it’s ready." />
      </div>
    </div>
  </section>

  <section class="section light" id="book">
    <div class="wrap book-grid">
      <div class="cover-wrap reveal">
        <div class="cover" role="img" aria-label="Draft cover idea for Live Sexy Now: bold burgundy and gold lettering">
          <span class="cover-top mono">A BOOK BY JODY</span>
          <span class="cover-title">Live<br />Sexy<br />Now</span>
          <span class="cover-sub">Confidence. Reinvention. You.</span>
        </div>
        <p class="cover-note mono">DRAFT COVER · FINAL DESIGN COMING</p>
      </div>
      <div>
        <p class="eyebrow reveal">THE BOOK AND THE PODCAST</p>
        <h2 class="h2 reveal">Live Sexy Now.<br /><span class="muted">Coming soon.</span></h2>
        <p class="section-sub reveal">It’s not about how you look. It’s how you feel when you walk into a room: confident, alive and back in your own life. Jody’s book is about confidence and reinvention, and every chapter becomes a podcast conversation with guests.</p>
        <div class="book-signup reveal">
          <Signup list="book-waitlist" submit="Tell me first" done="You’ll be the first to hear when the book and podcast launch." note="Launch news only. No spam." />
        </div>
      </div>
    </div>
  </section>

  <PhotoBand img={PHOTOS.horses.src} alt={PHOTOS.horses.alt} eyebrow="AT HOME WITH THE HORSES" title="Calm is something<br /><em>you can learn.</em>" />

  <section class="section" id="about">
    <div class="wrap about-grid">
      <figure class="portrait reveal-image">
        <img src={PHOTOS.portrait.src} alt={PHOTOS.portrait.alt} loading="lazy" width="800" height="1000" />
      </figure>
      <div>
        <p class="eyebrow reveal">MEET JODY</p>
        <h2 class="h2 reveal">Hi, I’m <em>Jody.</em></h2>
        <p class="section-sub reveal">I help people feel at home in their own lives again. With hypnosis we clear what’s been holding you back; with coaching we build what comes next. I live on acreage with my horses, which is where the equestrian mindset work began.</p>
        <ul class="creds" data-reveal-group>
          {CREDENTIALS.map((c) => <li class="reveal">{c}</li>)}
        </ul>
        <a class="btn btn-accent magnetic" href="#contact">Book a session <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Faq items={FAQ} />

  <ContactForm
    tone="dark"
    eyebrow="BOOK A SESSION"
    title="Let’s find<br /><em>your time.</em>"
    sub="Tell Jody a little about what’s going on and when suits you."
    next={["Jody replies to find a time that suits you.", "Nothing to pay upfront.", "Cancel within 24 hours and half the fee applies."]}
    topics={["Hypnosis", "Quit smoking or vaping", "Weight (mental gastric bypass)", "Life coaching", "Equestrian mindset coaching", "Speaking or podcast", "Something else"]}
    submit="Request a session"
  />

  <p class="care wrap">Hypnotherapy and coaching work alongside medical and psychological care, not instead of it. If you’re in crisis, call Lifeline on <a href="tel:131114">13 11 14</a>, or 000 in an emergency.</p>

  <ChatAssistant slot="end" name="Jody’s helper" greeting="Hi! I can answer quick questions about sessions, prices and the free audio. What would you like to know?" answers={ASSISTANT} />
</Base>

<style>
  .statement {
    padding-bottom: 40px;
  }
  .section-head :global(em),
  .h2 :global(em) {
    color: var(--accent);
  }

  /* Prices */
  .prices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .price {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 32px;
  }
  .price.featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }
  .price h3 {
    font-size: 20px;
  }
  .amount b {
    font: 400 46px/1 var(--font-serif-roman);
    color: var(--accent);
  }
  .amount span {
    color: var(--muted);
  }
  .price ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }
  .price li::before {
    content: "✦ ";
    color: var(--accent);
  }
  .price .btn {
    justify-self: start;
    margin-top: 8px;
  }
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .terms b {
    color: var(--text);
  }

  /* Free audio */
  .free {
    background:
      radial-gradient(60% 80% at 85% 20%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      var(--bg);
  }
  .free-grid,
  .book-grid,
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .audios {
    display: grid;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .audios li {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .audios b {
    display: block;
  }
  .audios li > span:nth-child(2) > span {
    color: var(--muted);
    font-size: 14px;
  }
  .play {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
    font-size: 13px;
  }
  .soon {
    color: var(--faint);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .free-card {
    padding: clamp(24px, 4vw, 40px);
  }
  .free-card h3 {
    margin-bottom: 20px;
    font: 400 30px/1.1 var(--font-serif-roman);
  }

  /* Book */
  .cover-wrap {
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .cover {
    display: grid;
    align-content: space-between;
    width: min(340px, 80vw);
    aspect-ratio: 2 / 3;
    padding: 28px 26px;
    border-radius: 4px 12px 12px 4px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.35), transparent 6%),
      radial-gradient(120% 70% at 70% 90%, #8e2b3d, transparent 70%),
      var(--burgundy);
    box-shadow: 0 30px 60px -20px rgba(40, 10, 15, 0.55);
    color: #f1dca6;
    transform: rotate(-3deg);
  }
  .cover-top {
    font-size: 11px;
    letter-spacing: 0.2em;
  }
  .cover-title {
    font: 400 clamp(56px, 9vw, 84px)/0.9 var(--font-serif-roman);
    text-transform: uppercase;
    background: linear-gradient(170deg, #f6e4b3, #c99a4a 60%, #f1dca6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cover-sub {
    font: italic 400 18px var(--font-serif);
  }
  .cover-note {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .book-signup {
    margin-top: 28px;
  }

  /* About */
  .portrait {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--accent);
  }
  .portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
  }
  .creds li {
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14px;
  }

  .care {
    padding-top: 28px;
    padding-bottom: 28px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
  }
  .care a {
    color: var(--text);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .prices,
    .free-grid,
    .book-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .audios li {
      grid-template-columns: 40px 1fr;
    }
    .soon {
      grid-column: 2;
    }
  }
</style>
