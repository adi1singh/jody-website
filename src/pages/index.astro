---
// Jody Pockran's home page. Look after dawnsaunders.com (giant lowercase name,
// circles, thin Figtree headings over Forum text), in black, gold and ivory.
// Every section is its own file in src/components/jody/; content is in
// src/data/jody.ts. Flow: hero + statement → ways to work with me → how a
// session works and prices → free audio → the book and podcast → about →
// what clients say (hidden until real quotes) → FAQ → book a session.
import Base from "../layouts/Base.astro";
import Hero from "../components/jody/Hero.astro";
import Services from "../components/jody/Services.astro";
import Session from "../components/jody/Session.astro";
import FreeAudio from "../components/jody/FreeAudio.astro";
import Book from "../components/jody/Book.astro";
import About from "../components/jody/About.astro";
import Testimonials from "../components/jody/Testimonials.astro";
import Faq from "../components/jody/Faq.astro";
import BookSession from "../components/jody/BookSession.astro";
import EmailPopup from "../components/jody/EmailPopup.astro";
import ChatAssistant from "../components/widgets/ChatAssistant.astro";
import { ASSISTANT, BOOK_HREF } from "../data/jody";
import { SITE } from "../data/site";
const book = { label: "Book a session", href: SITE.booking || BOOK_HREF };
---
<Base title="Jody Pockran · Hypnotherapy, life coaching and mindset" cta={book} intro={false} grain={false}>
  <Hero />
  <Services />
  <Session />
  <FreeAudio />
  <Book />
  <About />
  <Testimonials />
  <Faq />
  <BookSession />

  <EmailPopup slot="end" />
  <ChatAssistant slot="end" name="Jody’s helper" greeting="Hi! I can answer quick questions about sessions, prices and the free audio. What would you like to know?" answers={ASSISTANT} />
</Base>
